@model VAB.ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <style>
        html {
            transform: translateZ(0);
        }

        :root {
            --light-grey: #e8e5e9;
            --win11-input-bg: rgba(0, 0, 0, 0.3);
            --win11-blur: 15px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Arial, sans-serif;
            transition-duration: 0.3s;
        }

        body {
            background-image: url('@Url.Content("~/images/Untitled design (2).png")');
            background-repeat: no-repeat;
            background-position: center center;
            background-attachment: fixed;
            background-size: cover;
            height: 100vh;
            color: white;
            -webkit-transform: translateZ(0);
            transform: translateZ(0);
        }

        section {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 98%;
            position: relative;
        }

        form {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
        }

        .avatar {
            width: 170px;
            height: 170px;
            background: var(--light-grey);
            border-radius: 50px;
            font-size: 6rem;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .avatar svg {
            width: 1em;
            fill: #777;
            margin-top: -0.05em;
        }

        .username {
            font-size: 1.5rem;
            font-weight: bold;
            color: white;
            text-align: center;
        }

        .win11-input-container {
            position: relative;
            width: 350px;
            margin: 10px 0;
            isolation: isolate;
            z-index: 1;
        }

        .win11-input {
            width: 100%;
            height: 40px;
            background-color: rgba(0, 0, 0, 0.3) !important;
            background: rgba(0, 0, 0, 0.3) !important;
            border: none !important;
            border-radius: 4px;
            color: white !important;
            font-size: 16px;
            padding: 0 40px 0 40px;
            -webkit-backdrop-filter: blur(var(--win11-blur));
            backdrop-filter: blur(var(--win11-blur));
            -webkit-transform: translateZ(0);
            transform: translateZ(0);
            outline: none;
            -webkit-appearance: none;
            appearance: none;
            will-change: transform;
        }

        .win11-input:focus {
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.3) !important;
        }

        .win11-input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        .password-dot {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            width: 8px;
            height: 8px;
            background-color: white;
            border-radius: 50%;
            z-index: 2;
        }

        .arrow-button {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent !important;
            border: none;
            color: white;
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 20px;
            height: 20px;
            z-index: 2;
        }

        .arrow-button:hover {
            background-color: rgba(255, 255, 255, 0.1) !important;
            border-radius: 50%;
        }

        .validation-message {
            color: #ff6b6b;
            font-size: 12px;
            margin-top: 5px;
            width: 100%;
            text-align: left;
            padding-left: 5px;
        }

        .error-message {
            background-color: rgba(255, 107, 107, 0.2);
            border: 1px solid #ff6b6b;
            color: #ff6b6b;
            padding: 10px;
            border-radius: 4px;
            margin: 10px 0;
            width: 350px;
            text-align: center;
            font-size: 14px;
        }

        .logo-container {
            position: absolute;
            top: 30px;
            left: 30px;
        }

        .logo {
            width: 210px;
            height: auto;
        }

        .bottom-left {
            position: absolute;
            bottom: 1rem;
            left: 1rem;
            display: flex;
            gap: 0.5rem;
            flex-direction: column;
        }

        .bottom-left .user .avatar {
            width: 40px;
            height: 40px;
            font-size: 1.3rem;
        }

        .bottom-left .user {
            display: flex;
            padding: 0.3rem 0.5rem;
            gap: 0.5rem;
            align-items: center;
            font-weight: bold;
            color: var(--light-grey);
            cursor: pointer;
            border-radius: 0.5rem;
        }

        .bottom-left .user:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

        /* Input validation states */
        .win11-input.input-validation-error {
            border: 1px solid #ff6b6b !important;
            box-shadow: 0 0 0 1px rgba(255, 107, 107, 0.3) !important;
        }

        .win11-input.valid {
            border: 1px solid #28a745 !important;
            box-shadow: 0 0 0 1px rgba(40, 167, 69, 0.3) !important;
        }

        /* Loading state */
        .loading {
            opacity: 0.7;
            pointer-events: none;
        }

        .loading .arrow-button::after {
            content: '';
            width: 12px;
            height: 12px;
            border: 2px solid transparent;
            border-top: 2px solid white;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <section>
        <div class="logo-container">
            <img src="@Url.Content("~/images/Tunisair-Logo-Vector.svg-.png")" alt="Logo" class="logo">
        </div>

        <form asp-action="Login" method="post" id="loginForm">
            @Html.AntiForgeryToken()
            
            <div class="avatar">
                <svg viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg">
                    <path d="M512 625.778c-159.289 0-284.444-125.156-284.444-284.445S352.71 56.89 512 56.89s284.444 125.155 284.444 284.444S671.29 625.778 512 625.778z m0-56.89c125.156 0 227.556-102.4 227.556-227.555S637.156 113.778 512 113.778s-227.556 102.4-227.556 227.555S386.844 568.89 512 568.89z" />
                    <path d="M56.889 1024c0-250.311 204.8-455.111 455.111-455.111S967.111 773.689 967.111 1024h-56.889c0-221.867-176.355-398.222-398.222-398.222S113.778 802.133 113.778 1024h-56.89z" />
                </svg>
            </div>

            <!-- Display general error messages -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Any() == true)
            {
                <div class="error-message">
                    @foreach (var error in ViewData.ModelState[""].Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <!-- Email Input -->
            <div class="win11-input-container">
                <input asp-for="Email" placeholder="Email" class="win11-input" autocomplete="email" />
                <span asp-validation-for="Email" class="validation-message"></span>
            </div>

            <!-- Password Input -->
            <div class="win11-input-container">
                <span class="password-dot"></span>
                <input asp-for="Password" placeholder="Password" type="password" class="win11-input" autocomplete="current-password" />
                <button type="submit" class="arrow-button" id="submitBtn">→</button>
                <span asp-validation-for="Password" class="validation-message"></span>
            </div>
        </form>

       
    </section>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('loginForm');
            const emailInput = document.querySelector('input[name="Email"]');
            const passwordInput = document.querySelector('input[name="Password"]');
            const submitBtn = document.getElementById('submitBtn');

            // Real-time validation
            emailInput.addEventListener('blur', function() {
                validateEmail(this);
            });

            passwordInput.addEventListener('blur', function() {
                validatePassword(this);
            });

            // Form submission
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                
                if (validateForm()) {
                    // Show loading state
                    form.classList.add('loading');
                    submitBtn.innerHTML = '';
                    
                    // Submit form
                    form.submit();
                }
            });

            function validateEmail(input) {
                const email = input.value.trim();
                const emailRegex = /^[^\s@@]+@@[^\s@@]+/;
                
                if (!email) {
                    showFieldError(input, 'Ladresse e-mail est requise');
                    return false;
                } else if (!emailRegex.test(email)) {
                    showFieldError(input, 'Veuillez entrer une adresse e-mail valide');
                    return false;
                } else {
                    showFieldSuccess(input);
                    return true;
                }
            }

            function validatePassword(input) {
                const password = input.value;
                
                if (!password) {
                    showFieldError(input, 'Le mot de passe est requis');
                    return false;
                } else {
                    showFieldSuccess(input);
                    return true;
                }
            }

            function validateForm() {
                const emailValid = validateEmail(emailInput);
                const passwordValid = validatePassword(passwordInput);
                
                return emailValid && passwordValid;
            }

            function showFieldError(input, message) {
                input.classList.add('input-validation-error');
                input.classList.remove('valid');
                
                const container = input.closest('.win11-input-container');
                let errorSpan = container.querySelector('.validation-message');
                if (errorSpan) {
                    errorSpan.textContent = message;
                }
            }

            function showFieldSuccess(input) {
                input.classList.remove('input-validation-error');
                input.classList.add('valid');
                
                const container = input.closest('.win11-input-container');
                let errorSpan = container.querySelector('.validation-message');
                if (errorSpan) {
                    errorSpan.textContent = '';
                }
            }

            // Demo credentials function
            window.fillDemoCredentials = function(email, password) {
                emailInput.value = email;
                passwordInput.value = password;
                validateEmail(emailInput);
                validatePassword(passwordInput);
            };
        });
    </script>
</body>
</html>
