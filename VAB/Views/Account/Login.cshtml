@{
}
@model VAB.ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null; // Disable the layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <!-- Force hardware acceleration in Chrome -->
    <style>
        html {
            transform: translateZ(0);
        }

        :root {
            --light-grey: #e8e5e9;
            --win11-input-bg: rgba(0, 0, 0, 0.3);
            --win11-blur: 15px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Arial, sans-serif;
            transition-duration: 0.3s;
        }

        /* Fix for background image */
        body {
            /* Use the correct path format for background images in CSS */
            background-image: url('@Url.Content("~/images/Untitled design (2).png")');
            background-repeat: no-repeat;
            background-position: center center;
            background-attachment: fixed;
            background-size: cover;
            height: 100vh;
            color: white;
            /* Force hardware acceleration in Chrome */
            -webkit-transform: translateZ(0);
            -moz-transform: translateZ(0);
            -ms-transform: translateZ(0);
            -o-transform: translateZ(0);
            transform: translateZ(0);
        }

        section {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 98%;
            position: relative;
        }

        form {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
        }

        .avatar {
            width: 170px;
            height: 170px;
            background: var(--light-grey);
            border-radius: 50px;
            font-size: 6rem;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            .avatar svg {
                width: 1em;
                fill: #777;
                margin-top: -0.05em;
            }

        .username {
            font-size: 1.5rem;
            font-weight: bold;
            color: white;
            text-align: center;
        }

        /* Windows 11 style input field */
        .win11-input-container {
            position: relative;
            width: 350px;
            margin: 10px 0;
            /* Create a new stacking context */
            isolation: isolate;
            z-index: 1;
        }

        /* Cross-browser transparent input styling */
        .win11-input {
            width: 100%;
            height: 40px;
            /* Multiple background declarations for better cross-browser support */
            background-color: rgba(0, 0, 0, 0.3) !important;
            background: rgba(0, 0, 0, 0.3) !important;
            border: none !important;
            border-radius: 4px;
            color: white !important;
            font-size: 16px;
            padding: 0 40px 0 40px;
            /* Apply all vendor prefixes for backdrop-filter */
            -webkit-backdrop-filter: blur(var(--win11-blur));
            -moz-backdrop-filter: blur(var(--win11-blur));
            -o-backdrop-filter: blur(var(--win11-blur));
            backdrop-filter: blur(var(--win11-blur));
            /* Force hardware acceleration */
            -webkit-transform: translateZ(0);
            transform: translateZ(0);
            /* Remove default styling */
            outline: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            /* Ensure proper compositing */
            will-change: transform;
            transform: translateZ(0);
        }

        /* Alternative method for Chrome */
        @@supports (-webkit-backdrop-filter: none) {
            .win11-input

        {
            -webkit-backdrop-filter: blur(var(--win11-blur));
            backdrop-filter: blur(var(--win11-blur));
        }

        }

        /* For browsers that don't support backdrop-filter */
        @@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
            .win11-input

        {
            background-color: rgba(0, 0, 0, 0.6) !important; /* Darker fallback */
        }

        }

        /* Ensure background color remains in all states */
        .win11-input:hover,
        .win11-input:focus,
        .win11-input:active,
        .win11-input:disabled {
            background-color: rgba(0, 0, 0, 0.3) !important;
            background: rgba(0, 0, 0, 0.3) !important;
            color: white !important;
        }

        .win11-input:focus {
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.3) !important;
        }

        .win11-input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        /* Password dot */
        .password-dot {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            width: 8px;
            height: 8px;
            background-color: white;
            border-radius: 50%;
            z-index: 2;
        }

        /* Arrow button */
        .arrow-button {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent !important;
            border: none;
            color: white;
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 20px;
            height: 20px;
            z-index: 2;
        }

        /* Legacy password input styling - keeping for compatibility */
        .password {
            position: relative;
            color: var(--light-grey);
            width: 100%;
            max-width: 350px;
        }

            .password input {
                color: #fff;
                padding: 0.4rem 1rem;
                border-radius: 0.3rem;
                width: 70%;
                margin-top: 1rem;
                border: 0.13rem solid rgba(200, 200, 200, 0.2);
                background: rgba(38, 38, 38, 0.5);
                outline: none;
                font-size: 1rem;
            }

                .password input:focus {
                    border-bottom-color: currentcolor;
                }

                .password input::placeholder {
                    color: currentcolor;
                }

            .password svg {
                width: 1.5em;
                fill: currentcolor;
                position: absolute;
                right: 0.5rem;
                top: 42%;
            }

        .btn {
            min-height: 2.5rem;
            min-width: 2.5rem;
            border-radius: 0.5rem;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
        }

            .btn:hover {
                background-color: rgba(255, 255, 255, 0.1);
            }

        .bottom-right {
            position: absolute;
            bottom: 1rem;
            right: 1rem;
            display: flex;
            gap: 1rem;
            color: var(--light-grey);
        }

            .bottom-right svg {
                width: 1.5em;
                fill: currentcolor;
            }

        .bottom-left {
            position: absolute;
            bottom: 1rem;
            left: 1rem;
            display: flex;
            gap: 0.5rem;
            flex-direction: column;
        }

            .bottom-left .user .avatar {
                width: 40px;
                height: 40px;
                font-size: 1.3rem;
            }

            .bottom-left .user {
                display: flex;
                padding: 0.3rem 0.5rem;
                gap: 0.5rem;
                align-items: center;
                font-weight: bold;
                color: var(--light-grey);
            }

        /* Remember me checkbox */
        .remember-me {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--light-grey);
            margin: 10px 0;
            align-self: flex-start;
            margin-left: 10px;
        }

        /* Validation messages */
        .validation-message {
            color: #ff6b6b;
            font-size: 12px;
            margin-top: 5px;
            width: 100%;
        }

        /* Logo container */
        .logo-container {
            position: absolute;
            top: 30px;
            left: 30px;
        }

        .logo {
            width: 210px;
            height: auto;
        }

        /* Override any potential browser or framework styles */
        input[type="email"].win11-input,
        input[type="password"].win11-input,
        input[type="text"].win11-input {
            background-color: rgba(0, 0, 0, 0.3) !important;
            background: rgba(0, 0, 0, 0.3) !important;
            color: white !important;
        }

        /* Ensure autofill doesn't change background */
        input.win11-input:-webkit-autofill,
        input.win11-input:-webkit-autofill:hover,
        input.win11-input:-webkit-autofill:focus,
        input.win11-input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 30px rgba(0, 0, 0, 0.3) inset !important;
            -webkit-text-fill-color: white !important;
            transition: background-color 5000s ease-in-out 0s;
            background-color: rgba(0, 0, 0, 0.3) !important;
        }

        /* Chrome-specific fixes */
        @@media screen and (-webkit-min-device-pixel-ratio:0) {
            .win11-input

        {
            background-color: rgba(0, 0, 0, 0.3) !important;
            -webkit-backdrop-filter: blur(var(--win11-blur));
        }

        }
    </style>
</head>
<body>
    <section>
        <div class="logo-container">
            <img src="@Url.Content("~/images/Tunisair-Logo-Vector.svg-.png")" alt="Logo" class="logo">
        </div>

        <!-- Login Form -->
        <form asp-action="Login" method="post">
            <div class="avatar">
                <svg viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg">
                    <path d="M512 625.778c-159.289 0-284.444-125.156-284.444-284.445S352.71 56.89 512 56.89s284.444 125.155 284.444 284.444S671.29 625.778 512 625.778z m0-56.89c125.156 0 227.556-102.4 227.556-227.555S637.156 113.778 512 113.778s-227.556 102.4-227.556 227.555S386.844 568.89 512 568.89z" />
                    <path d="M56.889 1024c0-250.311 204.8-455.111 455.111-455.111S967.111 773.689 967.111 1024h-56.889c0-221.867-176.355-398.222-398.222-398.222S113.778 802.133 113.778 1024h-56.89z" />
                </svg>
            </div>

            <!-- Email Input - Windows 11 Style -->
            <div class="win11-input-container">
                <input asp-for="Email" placeholder="Email" class="win11-input" />
                <span asp-validation-for="Email" class="validation-message"></span>
            </div>

            <!-- Password Input - Windows 11 Style -->
            <div class="win11-input-container">
                <span class="password-dot"></span>
                <input asp-for="Password" placeholder="Password" type="password" class="win11-input" />
                <button type="submit" class="arrow-button">→</button>
                <span asp-validation-for="Password" class="validation-message"></span>
            </div>

          
        </form>

        <div class="bottom-left">
            <div class="user btn">
                <div class="avatar">
                    <svg viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg">
                        <path d="M512 625.778c-159.289 0-284.444-125.156-284.444-284.445S352.71 56.89 512 56.89s284.444 125.155 284.444 284.444S671.29 625.778 512 625.778z m0-56.89c125.156 0 227.556-102.4 227.556-227.555S637.156 113.778 512 113.778s-227.556 102.4-227.556 227.555S386.844 568.89 512 568.89z" />
                        <path d="M56.889 1024c0-250.311 204.8-455.111 455.111-455.111S967.111 773.689 967.111 1024h-56.889c0-221.867-176.355-398.222-398.222-398.222S113.778 802.133 113.778 1024h-56.89z" />
                    </svg>
                </div>
                <p>omar bhs</p>
            </div>

            <div class="user btn">
                <div class="avatar">
                    <svg viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg">
                        <path d="M512 625.778c-159.289 0-284.444-125.156-284.444-284.445S352.71 56.89 512 56.89s284.444 125.155 284.444 284.444S671.29 625.778 512 625.778z m0-56.89c125.156 0 227.556-102.4 227.556-227.555S637.156 113.778 512 113.778s-227.556 102.4-227.556 227.555S386.844 568.89 512 568.89z" />
                        <path d="M56.889 1024c0-250.311 204.8-455.111 455.111-455.111S967.111 773.689 967.111 1024h-56.889c0-221.867-176.355-398.222-398.222-398.222S113.778 802.133 113.778 1024h-56.89z" />
                    </svg>
                </div>
                <p>Other user</p>
            </div>
        </div>
    </section>

    <script src="~/js/Login.js"></script>
</body>
</html>