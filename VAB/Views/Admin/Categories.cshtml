@model List<VAB.Models.Categorie>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <title>Admin Dashboard - Categories</title>
    <link rel="shortcut icon" href="~/images/icons/favicon.png" type="image/png">
    <link href="https://fonts.googleapis.com/css?family=Nunito&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/iconfont/material-icons.css">
    <link href="~/css/dataTables.bootstrap4.min.css" rel="stylesheet">
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/sidebar.css" rel="stylesheet">
    <link href="~/css/responsive.css" rel="stylesheet">
</head>

<body>
    <div class="spinner_body">
        <div class="spinner"></div>
    </div>

    <!-- Header -->
    <header>
        <div class="header">
            <div class="navigation">
                <nav class="navbar navbar-expand-lg navbar-bg">
                    <div class="brand-logo">
                        <a class="navbar-brand" asp-controller="Admin" asp-action="Dashboard" id="menu-action">
                            <div class="logo-tunisair">
                                <img src="~/images/icons/Tunisair-Logo-Vector.svg-.png" alt="Tunisair Logo">
                            </div>
                        </a>
                        <div id="nav-toggle">
                            <div class="cta"><div class="toggle-btn type1"></div></div>
                        </div>
                    </div>
                    <div class="for-mobile d-mobile">
                        <div class="toggle-button" id="toggle-button">
                            <span class="material-icons">menu</span>
                        </div>
                    </div>
                    <div class="collapse navbar-collapse pr-3">
                        <ul class="navbar-nav user-info ml-auto mt-2 mt-lg-0">
                            <li class="nav-item dropdown show">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <a href="#" class="navbar-nav-link dropdown-toggle text-light" data-toggle="dropdown">
                                        <div class="user-photo">
                                            <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" style="border-radius: 50%;" alt="User">
                                        </div>
                                        @User.Identity.Name
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a asp-controller="Admin" asp-action="AccountSettings" class="dropdown-item">
                                            <i class="material-icons">supervisor_account</i> Account Settings
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                            <i class="material-icons">exit_to_app</i> Logout
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a>
                                }
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <!-- Sidebar -->
    <section id="left-sidebar-area">
        <div id="left-sidebar-section">
            <aside>
                <div class="left-sidebar" id="wrapper-sidebar">
                    <ul>
                        <li><a asp-controller="Admin" asp-action="Dashboard"><i class="material-icons">home</i>Dashboard</a></li>
                        <li><a asp-controller="Admin" asp-action="UsersList"><i class="material-icons">supervisor_account</i>Users</a></li>
                        <li class="active"><a asp-controller="Admin" asp-action="Categories"><i class="material-icons">category</i>Categories</a></li>
                        <li><a asp-controller="Admin" asp-action="Roles"><i class="material-icons">perm_data_setting</i>Role</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </section>

    <!-- Main Content -->
    <section class="d-flex" id="wrapper">
        <div class="page-content-wrapper">
            <div class="content-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard"><i class="material-icons">home</i>Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Categories</li>
                    </ol>
                </nav>
            </div>

            <div class="main-content">
                <div class="row mt-3">
                    <div class="col-md-12">
                        <div class="card bg-white">
                            <div class="card-body">
                                @if (TempData["Success"] != null)
                                {
                                    <div class="alert alert-success">
                                        @TempData["Success"]
                                    </div>
                                }

                                <h2 class="mb-4"><i class="material-icons mr-2">category</i> Categories</h2>

                                <div class="text-end mb-3">
                                    <a class="btn btn-primary" asp-action="AddCategorie" asp-controller="Admin">
                                        <i class="material-icons mr-2">add</i> Add New Category
                                    </a>


                                </div>

                                <div class="table-responsive">
                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Description</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var categorie in Model)
                                            {
                                                <tr>
                                                    <td>@categorie.Id</td>
                                                    <td>@categorie.Description</td>
                                                    <td>
                                                        <!-- Edit Button -->
                                                        <button class="btn btn-sm btn-warning">
                                                            <a class="text-white" asp-action="EditCategorie" asp-route-id="@categorie.Id">
                                                                <i class="material-icons mr-1">edit</i> Edit
                                                            </a>
                                                        </button>

                                                        <!-- Delete Button -->
                                                         <form asp-action="DeleteCategorie" method="post" asp-route-id="@categorie.Id" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                                            <button type="submit" class="btn btn-danger">Delete</button>
                                                        </form>
                                                    </td>
                                                </tr>

                                                <!-- Delete Modal -->
                                                <div class="modal fade" id="deleteModal-@categorie.Id" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
                                                    <div class="modal-dialog" role="document">
                                                        <div class="modal-content">
                                                            <form asp-action="DeleteCategorie" method="post">
                                                                <input type="hidden" name="id" value="@categorie.Id" />
                                                                <div class="modal-header bg-danger text-white">
                                                                    <h5 class="modal-title"><i class="material-icons mr-2">warning</i> Confirm Delete</h5>
                                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                        <span aria-hidden="true">&times;</span>
                                                                    </button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    Are you sure you want to delete "<strong>@categorie.Description</strong>"?
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="submit" class="btn btn-danger"><i class="material-icons mr-1">delete_forever</i> Delete</button>
                                                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Category Modal Container -->
    <div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" id="categoryModalContent">
                <!-- Content will be loaded here dynamically -->
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/jquery.dataTables.min.js"></script>
    <script src="~/js/script.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            $('.table').DataTable({
                responsive: true
            });
        });

        function loadCategoryForm(url) {
            $.get(url, function (data) {
                $('#categoryModalContent').html(data);
                $('#categoryModal').modal('show');
                $.validator.unobtrusive.parse('#categoryModalContent form');
            });
        }

        $(document).on('submit', '#createCategoryForm, #editCategoryForm', function (e) {
            e.preventDefault();
            var form = $(this);

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        $('#categoryModal').modal('hide');
                        window.location.reload();
                    } else {
                        $('#categoryModalContent').html(response);
                        $.validator.unobtrusive.parse('#categoryModalContent form');
                    }
                },
                error: function (xhr) {
                    $('#categoryModalContent').html(xhr.responseText);
                    $.validator.unobtrusive.parse('#categoryModalContent form');
                }
            });
        });
    </script>
</body>
</html>
