@model List<VAB.Models.Categorie>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <title>Admin Dashboard - Categories</title>
    <link rel="shortcut icon" href="~/images/icons/favicon.png" type="image/png">
    <link href="https://fonts.googleapis.com/css?family=Nunito&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/iconfont/material-icons.css">
    <link href="~/css/dataTables.bootstrap4.min.css" rel="stylesheet">
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/sidebar.css" rel="stylesheet">
    <link href="~/css/responsive.css" rel="stylesheet">
    <style>
        .button-container {
            display: flex;
            gap: 10px; /* Space between buttons */
            justify-content: center; /* Align buttons to the right */
            align-items: center; /* Vertically align buttons */
        }

        .custom-btn {
            width: 80px; /* Reduced width for smaller buttons */
            text-align: center; /* Center text/icons */
            padding: 4px 8px; /* Reduced padding for smaller buttons */
            font-size: 12px; /* Smaller font size */
            line-height: 1.5; /* Consistent line height */
        }

            .custom-btn a {
                text-decoration: none; /* Remove underline from Edit link */
                display: block; /* Ensure link fills button */
                color: inherit; /* Inherit text color */
            }

        /* Table styling */
        .table-container {
            max-width: 1200px; /* Smaller table width */
            margin: 0 auto; /* Center the table */
        }

        .table th, .table td {
            width: 33.33%; /* Equal width for all three columns */
            text-align: center; /* Center text for consistency */
            vertical-align: middle; /* Vertically center content */
        }

        .table th {
            font-size: 18px; /* Smaller header font */
        }

        .table td {
            font-size: 14px; /* Smaller cell font */
            padding: 8px; /* Reduced padding for smaller cells */
        }

        .dataTables_paginate .pagination .page-item.active .page-link {
            background-color: #6c757d;
            border-color: #6c757d;
            color: white;
        }

        .dataTables_paginate .pagination .page-item .page-link {
            color: #6c757d;
            background-color: white;
            border-color: #dee2e6;
        }

            .dataTables_paginate .pagination .page-item .page-link:hover {
                background-color: #5a6268;
                border-color: #5a6268;
                color: white;
            }

        .dataTables_paginate .pagination .page-item.disabled .page-link {
            color: #6c757d;
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }
    </style>
</head>
<body>
  

    <!-- Header -->
    <header>
        <div class="header">
            <div class="navigation">
                <nav class="navbar navbar-expand-lg navbar-bg">
                    <div class="brand-logo">
                        <a class="navbar-brand" asp-controller="Admin" asp-action="Dashboard" id="menu-action">
                            <div class="logo-tunisair">
                                <img src="~/images/icons/Tunisair-Logo-Vector.svg-.png" alt="Tunisair Logo">
                            </div>
                        </a>
                        <div id="nav-toggle">
                            <div class="cta"><div class="toggle-btn type1"></div></div>
                        </div>
                    </div>
                    <div class="for-mobile d-mobile">
                        <div class="toggle-button" id="toggle-button">
                            <span class="material-icons">menu</span>
                        </div>
                    </div>
                    <div class="collapse navbar-collapse pr-3">
                        <ul class="navbar-nav user-info ml-auto mt-2 mt-lg-0">
                            <li class="nav-item dropdown show">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <a href="#" class="navbar-nav-link dropdown-toggle text-light" data-toggle="dropdown">
                                        <div class="user-photo">
                                            <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" style="border-radius: 50%;" alt="User">
                                        </div>
                                        @User.Identity.Name
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a asp-controller="Admin" asp-action="AccountSettings" class="dropdown-item">
                                            <i class="material-icons">supervisor_account</i> Account Settings
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                            <i class="material-icons">exit_to_app</i> Logout
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a>
                                }
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <!-- Sidebar -->
    <section id="left-sidebar-area">
        <!--   Left Sidebar  -->
        <div id="left-sidebar-section">


            <aside>
                <div class="left-sidebar" id="wrapper-sidebar">
                    <ul>
                        <li><a href="@Url.Action("Dashboard", "Admin")"><i class="material-icons">home</i>Dashboard</a></li>
                        <li><a href="@Url.Action("UsersList", "Admin")"><i class="material-icons">supervisor_account</i>Users</a></li>
                        <li class="active"><a asp-controller="Admin" asp-action="Prices"><i class="material-icons">attach_money</i>Prices</a></li>
                        <li>
                            <a href="@Url.Action("Categories", "Admin")">
                                <i>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-basket2-fill" viewBox="0 0 16 16">
                                        <path d="M5.929 1.757a.5.5 0 1 0-.858-.514L2.217 6H.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h.623l1.844 6.456A.75.75 0 0 0 3.69 15h8.622a.75.75 0 0 0 .722-.544L14.877 8h.623a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1.717L10.93 1.243a.5.5 0 1 0-.858.514L12.617 6H3.383zM4 10a1 1 0 0 1 2 0v2a1 1 0 1 1-2 0zm3 0a1 1 0 0 1 2 0v2a1 1 0 1 1-2 0zm4-1a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0v-2a1 1 0 0 1 1-1" />
                                    </svg>
                                </i> Categories / Articles
                            </a>
                        </li>

                    </ul>
                </div>
            </aside>
        </div>
        <!--   Left Sidebar  -->
    </section>

    <!-- Main Content -->
    <section class="d-flex" id="wrapper">
        <div class="page-content-wrapper">
            <div class="content-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard"><i class="material-icons">home</i>Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Categories</li>
                    </ol>
                </nav>
            </div>

            <div class="main-content">
                <div class="row mt-3">
                    <div class="col-md-12">
                        <div class="card bg-white">
                            <div class="card-body">
                                @if (TempData["Success"] != null)
                                {
                                    <div class="alert alert-success">
                                        @TempData["Success"]
                                    </div>
                                }

                                <h2 class="mb-4"><i class="material-icons mr-2">category</i> Categories</h2>

                                <div class="text-end mb-3">
                                    <button onclick="loadCategoryForm('/Admin/AddCategorie')" class="btn btn-primary" style="background-color:darkgrey;border-block-color:darkgrey;"><i class="material-icons mr-2">add</i> Add Category</button>
                                </div>

                                <div class="table-container">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Description</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var categorie in Model)
                                                {
                                                    <tr>
                                                        <td>@categorie.Id</td>
                                                        <td>@categorie.Description</td>
                                                        <td>
                                                            <div class="button-container">
                                                                <!-- View Articles Button -->
                                                                <a asp-action="Articles" asp-controller="Admin" asp-route-categoryId="@categorie.Id" class="btn btn-sm btn-info custom-btn">
                                                                    <i class="material-icons mr-1">visibility</i> View
                                                                </a>
                                                                <!-- Edit Button -->
                                                                <button class="btn btn-sm btn-warning custom-btn" onclick="loadCategoryForm('/Admin/EditCategorie/@categorie.Id')">
                                                                    <i class="material-icons mr-1">edit</i> Edit
                                                                </button>
                                                                
                                                                <!-- Delete Button -->
                                                                <form asp-action="DeleteCategorie" method="post" asp-route-id="@categorie.Id" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                                                    <button type="submit" class="btn btn-sm btn-danger custom-btn">
                                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                                                        </svg> Delete
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>

                                                    <!-- Delete Modal -->
                                                    <div class="modal fade" id="deleteModal-@categorie.Id" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
                                                        <div class="modal-dialog" role="document">
                                                            <div class="modal-content">
                                                                <form asp-action="DeleteCategorie" method="post">
                                                                    <input type="hidden" name="id" value="@categorie.Id" />
                                                                    <div class="modal-header bg-danger text-white">
                                                                        <h5 class="modal-title"><i class="material-icons mr-2">warning</i> Confirm Delete</h5>
                                                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                                            <span aria-hidden="true">×</span>
                                                                        </button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        Are you sure you want to delete "<strong>@categorie.Description</strong>"?
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="submit" class="btn btn-danger"><i class="material-icons mr-1">delete_forever</i> Delete</button>
                                                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Category Modal Container -->
    <div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" id="categoryModalContent">
                <!-- Content will be loaded here dynamically -->
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/jquery.dataTables.min.js"></script>
    <script src="~/js/script.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            $('.table').DataTable({
                responsive: true
            });
        });

        function loadCategoryForm(url) {
            $.get(url, function (data) {
                $('#categoryModalContent').html(data);
                $('#categoryModal').modal('show');
                $.validator.unobtrusive.parse('#categoryModalContent form');
            }).fail(function () {
                alert('Error loading the form.');
            });
        }

        $(document).on('submit', '#createCategoryForm, #editCategoryForm', function (e) {
            e.preventDefault();
            var form = $(this);

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        $('#categoryModal').modal('hide');
                        window.location.reload();
                    } else {
                        $('#categoryModalContent').html(response);
                        $.validator.unobtrusive.parse('#categoryModalContent form');
                    }
                },
                error: function (xhr) {
                    $('#categoryModalContent').html(xhr.responseText);
                    $.validator.unobtrusive.parse('#categoryModalContent form');
                    alert('Error submitting the form.');
                }
            });
        });
    </script>
</body>
</html>