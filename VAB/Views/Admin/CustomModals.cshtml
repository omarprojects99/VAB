@{
}
<!-- Custom Modal System - Include this in your layout or main pages -->
<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel">
    <div class="modal-dialog modal-alert">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-success" id="successModalLabel">Success</h5>
            </div>
            <div class="modal-body text-center">
                <div class="text-success icon-container mb-3">
                    <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
                </div>
                <h5 class="mt-2" id="successMessage">Operation completed successfully!</h5>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-success" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Warning Modal -->
<div class="modal fade" id="warningModal" tabindex="-1" role="dialog" aria-labelledby="warningModalLabel">
    <div class="modal-dialog modal-alert">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-warning" id="warningModalLabel">Warning</h5>
            </div>
            <div class="modal-body text-center">
                <div class="text-warning icon-container mb-3">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem;"></i>
                </div>
                <h5 class="mt-2" id="warningMessage">Please confirm your action.</h5>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-secondary me-2" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="warningConfirmBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" role="dialog" aria-labelledby="errorModalLabel">
    <div class="modal-dialog modal-alert">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger" id="errorModalLabel">Error</h5>
            </div>
            <div class="modal-body text-center">
                <div class="text-danger icon-container mb-3">
                    <i class="bi bi-x-circle-fill" style="font-size: 3rem;"></i>
                </div>
                <h5 class="mt-2" id="errorMessage">An error occurred!</h5>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-danger" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel">
    <div class="modal-dialog modal-alert">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-primary" id="confirmModalLabel">Confirm Action</h5>
            </div>
            <div class="modal-body text-center">
                <div class="text-primary icon-container mb-3">
                    <i class="bi bi-question-circle-fill" style="font-size: 3rem;"></i>
                </div>
                <h5 class="mt-2" id="confirmMessage">Are you sure you want to proceed?</h5>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-secondary me-2" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmActionBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

<style>
    .modal-alert {
        max-width: 400px;
        margin: 0 auto;
    }

        .modal-alert .modal-content {
            border-radius: 15px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .modal-alert .modal-body {
            padding: 2rem;
        }

    .icon-container {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .modal-alert .btn {
        border-radius: 25px;
        padding: 0.5rem 2rem;
        font-weight: 600;
    }
</style>

<script>
    // Custom Modal Functions
    function showCustomModal(type, title, message, callback = null) {
        const modalId = type + 'Modal';
        const modal = document.getElementById(modalId);

        if (modal) {
            // Set title and message
            modal.querySelector('.modal-title').textContent = title;
            modal.querySelector('[id$="Message"]').textContent = message;

            // Show modal
            $('#' + modalId).modal('show');

            // Handle callback for confirmation modals
            if (callback && (type === 'confirm' || type === 'warning')) {
                const confirmBtn = modal.querySelector('[id$="ConfirmBtn"], [id$="ActionBtn"]');
                if (confirmBtn) {
                    confirmBtn.onclick = function() {
                        $('#' + modalId).modal('hide');
                        callback();
                    };
                }
            }
        }
    }

    // Convenience functions
    function showSuccess(message, title = 'Success') {
        showCustomModal('success', title, message);
    }

    function showError(message, title = 'Error') {
        showCustomModal('error', title, message);
    }

    function showWarning(message, title = 'Warning', callback = null) {
        showCustomModal('warning', title, message, callback);
    }

    function showConfirm(message, title = 'Confirm', callback = null) {
        showCustomModal('confirm', title, message, callback);
    }
</script>