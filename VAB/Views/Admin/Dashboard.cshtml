@model VAB.ViewModel.DashboardViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <title>Admin Dashboard</title>

    <link rel="stylesheet" href="~/iconfont/material-icons.css">
    <link href="~/css/dataTables.bootstrap4.min.css" rel="stylesheet" media="screen">
    <link href="~/css/Chart.min.css" rel="stylesheet" media="screen">
    <link href="~/css/animate.css" rel="stylesheet" media="screen">
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/sidebar.css">
    <link rel="stylesheet" href="~/css/responsive.css">
</head>
<body>
    <!-- Header (same as before) -->
    <header>
        <div class="header">
            <div class="navigation">
                <nav class="navbar navbar-expand-lg navbar-bg">
                    <div class="brand-logo">
                        <a class="navbar-brand" href="@Url.Action("Dashboard", "Admin")" id="menu-action">
                            <div class="logo-tunisair">
                                <img src="~/images/icons/Tunisair-Logo-Vector.svg-.png" alt="">
                            </div>
                        </a>
                        <div id="nav-toggle">
                            <div class="cta">
                                <div class="toggle-btn type1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="for-mobile d-mobile">
                        <div class="toggle-button" id="toggle-button">
                            <span class="material-icons">menu</span>
                        </div>
                    </div>
                    <div class="collapse navbar-collapse pr-3" id="#">
                        <ul class="navbar-nav user-info ml-auto mt-2 mt-lg-0">
                            <li class="nav-item dropdown show">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <a href="#" class="navbar-nav-link dropdown-toggle text-light" data-toggle="dropdown" aria-expanded="true">
                                        <div class="user-photo">
                                            <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" style="border-radius: 50%;" alt="">
                                        </div>
                                        @User.Identity.Name
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a asp-controller="Admin" asp-action="AccountSettings" class="dropdown-item">
                                            <i class="material-icons">supervisor_account</i> Account Settings
                                        </a>
                                        <div class="menu-dropdown-divider"></div>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                            <i class="material-icons">exit_to_app</i> Logout
                                        </a>
                                    </div>
                                }
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <!-- Left Sidebar (same as before) -->
    <section id="left-sidebar-area">
        <div id="left-sidebar-section">
            <aside>
                <div class="left-sidebar" id="wrapper-sidebar">
                    <ul>
                        <li class="active"><a href="@Url.Action("Dashboard", "Admin")"><i class="material-icons">home</i>Dashboard</a></li>
                        <li><a href="@Url.Action("UsersList", "Admin")"><i class="material-icons">supervisor_account</i>Users</a></li>
                        <li><a asp-controller="Admin" asp-action="Prices"><i class="material-icons">attach_money</i>Prices</a></li>
                        <li>
                            <a href="@Url.Action("Categories", "Admin")">
                                <i>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-basket2-fill" viewBox="0 0 16 16">
                                        <path d="M5.929 1.757a.5.5 0 1 0-.858-.514L2.217 6H.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h.623l1.844 6.456A.75.75 0 0 0 3.69 15h8.622a.75.75 0 0 0 .722-.544L14.877 8h.623a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1.717L10.93 1.243a.5.5 0 1 0-.858.514L12.617 6H3.383zM4 10a1 1 0 0 1 2 0v2a1 1 0 1 1-2 0zm3 0a1 1 0 0 1 2 0v2a1 1 0 1 1-2 0zm4-1a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0v-2a1 1 0 0 1 1-1" />
                                    </svg>
                                </i> Categories / Articles
                            </a>
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </section>

    <!-- Main Content -->
    <section class="d-flex" id="wrapper">
        <div class="page-content-wrapper">
            <div class="content-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="#"><i class="material-icons">home</i>Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                    </ol>
                </nav>
            </div>

            <div class="main-content">
                <!-- Dashboard Statistics Cards -->
                <div class="row animated fadeInUp">
                    <div class="col-xl-3 col-sm-6 mb-3">
                        <div class="card text-white bg-success o-hidden h-100">
                            <div class="card-body">
                                <div class="card-body-icon">
                                    <i class="material-icons float-right text-white md-5em">people_outline</i>
                                </div>
                                <div class="mr-5">(@Model.TotalUsers) Total Users</div>
                            </div>
                            <a class="card-footer text-white clearfix small z-1" href="@Url.Action("UsersList", "Admin")">
                                <span class="float-left">View Details</span>
                                <span class="float-right">
                                    <i class="material-icons">keyboard_arrow_right</i>
                                </span>
                            </a>
                        </div>
                    </div>
                    <div class="col-xl-3 col-sm-6 mb-3">
                        <div class="card text-white bg-primary o-hidden h-100">
                            <div class="card-body">
                                <div class="card-body-icon">
                                    <i class="material-icons float-right text-white md-5em">supervisor_account</i>
                                </div>
                                <div class="mr-5">(@Model.ActiveUsers) Active Users</div>
                            </div>
                            <a class="card-footer text-white clearfix small z-1" href="@Url.Action("UsersList", "Admin")">
                                <span class="float-left">View Details</span>
                                <span class="float-right">
                                    <i class="material-icons">keyboard_arrow_right</i>
                                </span>
                            </a>
                        </div>
                    </div>
                    <div class="col-xl-3 col-sm-6 mb-3">
                        <div class="card text-white bg-danger o-hidden h-100">
                            <div class="card-body">
                                <div class="card-body-icon">
                                    <i class="material-icons float-right text-white md-5em">person_outline</i>
                                </div>
                                <div class="mr-5">(@Model.InactiveUsers) Inactive Users</div>
                            </div>
                            <a class="card-footer text-white clearfix small z-1" href="@Url.Action("UsersList", "Admin")">
                                <span class="float-left">View Details</span>
                                <span class="float-right">
                                    <i class="material-icons">keyboard_arrow_right</i>
                                </span>
                            </a>
                        </div>
                    </div>
                    <div class="col-xl-3 col-sm-6 mb-3">
                        <div class="card text-white bg-info o-hidden h-100">
                            <div class="card-body">
                                <div class="card-body-icon">
                                    <i class="material-icons float-right text-white md-5em">group_add</i>
                                </div>
                                <div class="mr-5">(@Model.UsersByRole.Values.Sum()) Role Assignments</div>
                            </div>
                            <a class="card-footer text-white clearfix small z-1" href="@Url.Action("UsersList", "Admin")">
                                <span class="float-left">View Details</span>
                                <span class="float-right">
                                    <i class="material-icons">keyboard_arrow_right</i>
                                </span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Charts and Tables Row -->
                <div class="row mt-3">
                    <!-- User Status Pie Chart -->
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">User Status Distribution</div>
                            <div class="card-body">
                                <canvas id="userStatusChart" style="height: 300px;"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Users by Role Chart -->
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">Users by Role</div>
                            <div class="card-body">
                                <canvas id="roleChart" style="height: 300px;"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Users Table -->
                <div class="row mt-3">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">Recent Users</div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Email</th>
                                                <th>Phone</th>
                                                <th>Role</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var user in Model.RecentUsers)
                                            {
                                                <tr>
                                                    <td>@user.NomPrenom</td>
                                                    <td>@user.Email</td>
                                                    <td>@user.Telephone</td>
                                                    <td>
                                                        @if (user.Roles != null && user.Roles.Any())
                                                        {
                                                            <span class="badge badge-primary">@string.Join(", ", user.Roles)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-secondary">No Role</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (user.IsActive)
                                                        {
                                                            <span class="badge badge-success">Active</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-danger">Inactive</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Scripts -->
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/script.js"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function() {
            console.log('Dashboard loaded');
            console.log('Total Users: @Model.TotalUsers');
            console.log('Active Users: @Model.ActiveUsers');
            console.log('Inactive Users: @Model.InactiveUsers');

            // User Status Pie Chart
            const userStatusCtx = document.getElementById('userStatusChart');
            if (userStatusCtx) {
                const userStatusChart = new Chart(userStatusCtx, {
                    type: 'pie',
                    data: {
                        labels: ['Active Users', 'Inactive Users'],
                        datasets: [{
                            data: [@Model.ActiveUsers, @Model.InactiveUsers],
                            backgroundColor: ['#28a745', '#dc3545'],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = total > 0 ? ((context.parsed / total) * 100).toFixed(1) : 0;
                                        return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
                console.log('User Status Chart created');
            } else {
                console.error('userStatusChart canvas not found');
            }

            // Role Distribution Bar Chart
            const roleCtx = document.getElementById('roleChart');
            if (roleCtx) {
                const roleLabels = [@Html.Raw(string.Join(",", Model.UsersByRole.Keys.Select(k => $"'{k}'")))];
                const roleData = [@string.Join(",", Model.UsersByRole.Values)];
                const roleColors = ['#007bff', '#28a745', '#ffc107', '#17a2b8', '#6c757d'];

                console.log('Role Labels:', roleLabels);
                console.log('Role Data:', roleData);

                const roleChart = new Chart(roleCtx, {
                    type: 'bar',
                    data: {
                        labels: roleLabels,
                        datasets: [{
                            label: 'Number of Users',
                            data: roleData,
                            backgroundColor: roleColors.slice(0, roleLabels.length),
                            borderColor: roleColors.slice(0, roleLabels.length),
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 1
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: false
                            }
                        }
                    }
                });
                console.log('Role Chart created');
            } else {
                console.error('roleChart canvas not found');
            }
        });
    </script>
</body>
</html>