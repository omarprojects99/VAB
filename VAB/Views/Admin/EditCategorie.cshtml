@model VAB.ViewModel.CategorieManagementViewModel
<style>
    /* Scoped styles for Edit Category Modal only */
    .edit-category-modal {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        background-color: #fff;
    }

        .edit-category-modal .modal-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }

        .edit-category-modal .modal-title {
            font-weight: 600;
            color: #333;
        }

        .edit-category-modal .modal-body {
            padding: 1.5rem;
        }

        .edit-category-modal .form-group {
            margin-bottom: 1.25rem;
        }

        .edit-category-modal .form-control {
            border-radius: 4px;
            border: 1px solid #ced4da;
            transition: border-color 0.3s ease;
        }

            .edit-category-modal .form-control:focus {
                border-color: #80bdff;
                box-shadow: none;
            }

        .edit-category-modal .modal-footer {
            background-color: #f8f9fa;
            border-top: 1px solid #dee2e6;
            padding: 1rem 1.5rem;
        }

        .edit-category-modal .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
        }

            .edit-category-modal .btn-primary:hover {
                background-color: #0069d9;
                border-color: #0062cc;
            }

        .edit-category-modal .text-danger {
            font-size: 0.875rem;
        }

</style>
<div class="modal-content edit-category-modal">
    <div class="modal-header">
        <h5 class="modal-title" id="categoryModalLabel">Edit Category</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">×</span>
        </button>
    </div>

    <div class="modal-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <form id="editCategoryForm" asp-action="EditCategorie" asp-controller="Admin" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Description" class="form-label">Description</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            @Html.AntiForgeryToken()
        </form>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Close</button>
        <button type="submit" form="editCategoryForm" class="btn btn-secondary">Save</button>

    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>