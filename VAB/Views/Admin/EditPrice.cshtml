@model VAB.ViewModel.PrixViewModel
@using VAB.Models

@{
    var article = ViewBag.Article as Article;
    var categoryId = ViewBag.CategoryId;
}

<form id="editPriceForm" asp-action="EditPrice" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ArticleId" />

    <div class="modal-header">
        <h5 class="modal-title">Modifier le prix pour @article.Description (ID: @article.IdArticle)</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">×</span>
        </button>
    </div>
    <div class="modal-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }
        <div class="form-group">
            <label asp-for="Valeur">Prix</label>
            <input asp-for="Valeur" class="form-control" type="number" step="0.01" min="0.01" required />
            <span asp-validation-for="Valeur" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DateDebut">Date de début</label>
            <input asp-for="DateDebut" class="form-control" type="date" required />
            <span asp-validation-for="DateDebut" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DateFin">Date de fin (optionnel)</label>
            <input asp-for="DateFin" class="form-control" type="date" />
            <span asp-validation-for="DateFin" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
        <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
    </div>
</form>

<script>
    $(document).ready(function () {
        console.log('EditPrice.cshtml loaded, categoryId:', '@categoryId');
    });

    $(document).on('submit', '#editPriceForm', function (e) {
        e.preventDefault();
        var form = $(this);
        console.log('Submitting edit price form to:', form.attr('action'));
        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: form.serialize(),
            success: function (response) {
                console.log('Edit price form submission response:', response);
                if (response.success) {
                    console.log('Closing modal...');
                    $('#priceModal').modal('hide');
                    console.log('Modal hidden, redirecting...');
                    var redirectUrl = '@categoryId' ? '/Admin/Prices?categoryId=@categoryId' : '/Admin/Prices';
                    window.location.href = redirectUrl;
                } else {
                    console.log('Response indicates failure, updating modal content');
                    $('#priceModalContent').html(response);
                    $.validator.unobtrusive.parse('#priceModalContent form');
                }
            },
            error: function (xhr) {
                console.error('Edit price form submission error:', xhr.status, xhr.responseText);
                $('#priceModalContent').html(xhr.responseText);
                $.validator.unobtrusive.parse('#priceModalContent form');
                alert('Erreur lors de la soumission du formulaire de modification du prix.');
            }
        });
    });
</script>