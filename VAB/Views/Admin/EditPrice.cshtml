@model VAB.ViewModel.PrixViewModel
@using VAB.Models

@{
    var article = ViewBag.Article as Article;
}

<form id="editPriceForm" asp-action="EditPrice" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ArticleId" />

    <div class="modal-header">
        <h5 class="modal-title">Edit Price for @article.Description (ID: @article.IdArticle)</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">×</span>
        </button>
    </div>
    <div class="modal-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }
        <div class="form-group">
            <label asp-for="Valeur">Price</label>
            <input asp-for="Valeur" class="form-control" type="number" step="0.01" min="0.01" required />
            <span asp-validation-for="Valeur" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DateDebut">Start Date</label>
            <input asp-for="DateDebut" class="form-control" type="date" required />
            <span asp-validation-for="DateDebut" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DateFin">End Date (Optional)</label>
            <input asp-for="DateFin" class="form-control" type="date" />
            <span asp-validation-for="DateFin" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
</form>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<script>
    $(document).on('submit', '#editPriceForm', function (e) {
        e.preventDefault();
        var form = $(this);
        console.log('Submitting edit price form to:', form.attr('action'));
        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: form.serialize(),
            success: function (response) {
                console.log('Edit price form submission response:', response);
                if (response.success) {
                    $('#priceModal').modal('hide');
                    window.location.href = '/Admin/Categories';
                } else {
                    $('#priceModalContent').html(response);
                    $.validator.unobtrusive.parse('#priceModalContent form');
                }
            },
            error: function (xhr) {
                console.error('Edit price form submission error:', xhr.status, xhr.responseText);
                $('#priceModalContent').html(xhr.responseText);
                $.validator.unobtrusive.parse('#priceModalContent form');
                alert('Error submitting the edit price form.');
            }
        });
    });
</script>