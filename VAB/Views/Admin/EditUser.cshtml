@{
    Layout = null;
}
@model VAB.ViewModel.UserManagementViewModel

<div class="edit-user-card container-fluid px-0">
    <style>
        .edit-user-card .card {
            background: linear-gradient(to right, #fff0f0, #f8dada);
            border: none;
            border-radius: 0;
            display: flex;
            flex-direction: row;
            padding: 30px;
            gap: 30px;
            width: 100%;
        }

        .edit-user-card .profile-photo {
            border-radius: 50%;
            border: 4px solid #8B0000;
            width: 160px;
            height: 160px;
            object-fit: cover;
            box-shadow: 0 0 12px rgba(0, 0, 0, 0.1);
        }

        .edit-user-card .form-section {
            flex: 1;
        }

        .edit-user-card .form-label {
            font-weight: 600;
            color: #6c757d;
        }

        .edit-user-card .form-control {
            border-radius: 6px;
        }

        .edit-user-card .btn-success {
            background-color: #8B0000;
            border-color: #8B0000;
        }

        .edit-user-card .btn-success:hover {
            background-color: #a30000;
        }

        .is-invalid {
            border-color: #dc3545;
        }

        .is-valid {
            border-color: #28a745;
        }

        .invalid-feedback {
            display: block;
            color: #dc3545;
            font-size: 0.875em;
            margin-top: 0.25rem;
        }
    </style>

    <div class="card">
        <div class="d-flex align-items-start">
            <img class="profile-photo" src="https://militaryhealthinstitute.org/wp-content/uploads/sites/37/2021/08/blank-profile-picture-png.png" alt="Profile Photo" />
        </div>

        <div class="form-section">
            <form id="editUserForm" method="post" action="/Admin/EditUserPost">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-9">
                        <input type="text" name="NomPrenom" value="@Model.NomPrenom" class="form-control" required 
                               placeholder="Name" minlength="2" maxlength="100" />
                        <div class="invalid-feedback"></div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Phone Number <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-9">
                        <div class="input-group">
                            <span class="input-group-text">+216</span>
                            <input type="text" name="Telephone" value="@Model.Telephone" class="form-control" required
                                   placeholder="XX XXX XXX" pattern="[0-9]{8}" maxlength="8" id="editPhoneInput" />
                        </div>
                        <small class="form-text text-muted">Enter 8 digits (e.g., 12345678)</small>
                        <div class="invalid-feedback"></div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">E-Mail Address <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-9">
                        <input type="email" name="Email" value="@Model.Email" class="form-control" required 
                               placeholder="Enter your email" />
                        <div class="invalid-feedback"></div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-3">
                        <label class="form-label">Roles <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-9">
                        <select name="Roles" class="form-control" multiple required id="rolesSelect">
                            @if (Model.AvailableRoles != null)
                            {
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <option value="@role" @@(Model.Roles != null && Model.Roles.Contains(role) ? "selected" : "")>
                                        @role
                                    </option>
                                }
                            }
                        </select>
                        <small class="form-text text-muted">Hold Ctrl to select multiple roles</small>
                        <div class="invalid-feedback"></div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3"></div>
                    <div class="col-md-9">
                        <button type="submit" class="btn btn-success" id="updateBtn">Update Profile</button>
                        <button type="button" class="btn btn-secondary ms-2" onclick="$('#userModal').modal('hide')">Cancel</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('editUserForm');
        const phoneInput = document.getElementById('editPhoneInput');
        const updateBtn = document.getElementById('updateBtn');
        const rolesSelect = document.getElementById('rolesSelect');

        // Phone number validation
        phoneInput.addEventListener('input', function() {
            let value = this.value.replace(/\D/g, '');
            if (value.length > 8) {
                value = value.substring(0, 8);
            }
            this.value = value;

            if (value.length === 8) {
                this.classList.remove('is-invalid');
                this.classList.add('is-valid');
                this.nextElementSibling.nextElementSibling.textContent = '';
            } else {
                this.classList.remove('is-valid');
                if (value.length > 0) {
                    this.classList.add('is-invalid');
                    this.nextElementSibling.nextElementSibling.textContent = 'Phone number must be exactly 8 digits';
                }
            }
        });

        // Form submission
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            if (validateEditForm()) {
                updateBtn.disabled = true;
                updateBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Updating...';

                // Create FormData and handle roles properly
                const formData = new FormData(form);
                
                // Remove existing Roles entries and add selected ones
                formData.delete('Roles');
                const selectedRoles = Array.from(rolesSelect.selectedOptions).map(option => option.value);
                selectedRoles.forEach(role => {
                    formData.append('Roles', role);
                });

                fetch('/Admin/EditUserPost', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showSuccess(data.message || 'User updated successfully');
                        setTimeout(() => {
                            if (typeof $('#userModal') !== 'undefined') {
                                $('#userModal').modal('hide');
                            }
                            if (typeof location !== 'undefined') {
                                location.reload();
                            }
                        }, 2000);
                    } else {
                        showError(data.message || 'Failed to update user');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showError('An unexpected error occurred');
                })
                .finally(() => {
                    updateBtn.disabled = false;
                    updateBtn.innerHTML = 'Update Profile';
                });
            }
        });

        function validateEditForm() {
            let isValid = true;
            const inputs = form.querySelectorAll('input[required], select[required]');

            inputs.forEach(input => {
                const value = input.type === 'select-multiple' ? 
                    Array.from(input.selectedOptions).length > 0 : 
                    input.value.trim();

                if (!value) {
                    input.classList.add('is-invalid');
                    const feedback = input.parentElement.querySelector('.invalid-feedback') || 
                                   input.closest('.col-md-9').querySelector('.invalid-feedback');
                    if (feedback) {
                        feedback.textContent = `${input.previousElementSibling?.textContent || 'This field'} is required`;
                    }
                    isValid = false;
                } else {
                    input.classList.remove('is-invalid');
                    const feedback = input.parentElement.querySelector('.invalid-feedback') || 
                                   input.closest('.col-md-9').querySelector('.invalid-feedback');
                    if (feedback) {
                        feedback.textContent = '';
                    }
                }
            });

            // Special validation for phone
            if (phoneInput.value.length !== 8) {
                phoneInput.classList.add('is-invalid');
                const feedback = phoneInput.closest('.col-md-9').querySelector('.invalid-feedback');
                if (feedback) {
                    feedback.textContent = 'Phone number must be exactly 8 digits';
                }
                isValid = false;
            }

            // Special validation for roles
            if (rolesSelect.selectedOptions.length === 0) {
                rolesSelect.classList.add('is-invalid');
                const feedback = rolesSelect.closest('.col-md-9').querySelector('.invalid-feedback');
                if (feedback) {
                    feedback.textContent = 'At least one role must be selected';
                }
                isValid = false;
            }

            return isValid;
        }

        // Helper functions for notifications
        function showSuccess(message) {
            // You can implement your preferred notification system here
            alert('Success: ' + message);
        }

        function showError(message) {
            // You can implement your preferred notification system here
            alert('Error: ' + message);
        }
    });
</script>
