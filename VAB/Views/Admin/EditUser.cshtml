            <!-- Create New User -->
<div class="edit-user-card container-fluid px-0">
    @* <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"> *@
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" /> *@

    <style>
        .edit-user-card .card {
            background: linear-gradient(to right, #fff0f0, #f8dada);
            border: none;
            border-radius: 0;
            display: flex;
            flex-direction: row;
            padding: 30px;
            gap: 30px;
            width: 100%;
        }

        .edit-user-card .profile-photo {
            border-radius: 50%;
            border: 4px solid #8B0000;
            width: 160px;
            height: 160px;
            object-fit: cover;
            box-shadow: 0 0 12px rgba(0, 0, 0, 0.1);
        }

        .edit-user-card .form-section {
            flex: 1;
        }

        .edit-user-card .form-label {
            font-weight: 600;
            color: #6c757d;
        }

        .edit-user-card .form-control {
            border-radius: 6px;
        }

        .edit-user-card .btn-success {
            background-color: #8B0000;
            border-color: #8B0000;
        }

            .edit-user-card .btn-success:hover {
                background-color: #a30000;
            }
    </style>

    <div class="card">
        <div class="d-flex align-items-start">
            <img class="profile-photo" src="https://militaryhealthinstitute.org/wp-content/uploads/sites/37/2021/08/blank-profile-picture-png.png" alt="Profile Photo" />
        </div>

        <div class="form-section">
            <form asp-action="EditUserPost" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Name</label>
                    </div>
                    <div class="col-md-9">
                        <input type="text" asp-for="NomPrenom" class="form-control" required placeholder="Name" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Phone Number</label>
                    </div>
                    <div class="col-md-9">
                        <input type="text" asp-for="Telephone" class="form-control" required placeholder="Phone number" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">E-Mail Address</label>
                    </div>
                    <div class="col-md-9">
                        <input type="email" asp-for="Email" class="form-control" required placeholder="Enter your email" />
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-3">
                        <label class="form-label">Roles</label>
                    </div>
                    <div class="col-md-9">
                        <select asp-for="Roles" class="form-control" asp-items="@(new SelectList(Model.AvailableRoles))" multiple></select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3"></div>
                    <div class="col-md-9">
                        <button type="submit" class="btn btn-success">Update Profile</button>
                        <a href="@Url.Action("UsersList", "Admin")" class="btn btn-secondary ms-2">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

