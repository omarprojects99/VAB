@model VAB.ViewModel.PrixViewModel
@using VAB.Models

@{
    var article = ViewBag.Article as Article;
    var priceHistory = ViewBag.PriceHistory as IEnumerable<Prix>;
}

<div class="modal-header">
    <h5 class="modal-title">Manage Price History for @article.Description (ID: @article.IdArticle)</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">×</span>
    </button>
</div>
<div class="modal-body">
    <!-- Price History Table -->
    <h6>Price History</h6>
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Price</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (priceHistory.Any())
                {
                    foreach (var price in priceHistory)
                    {
                        <tr>
                            <td>@price.Valeur.ToString("C")</td>
                            <td>@price.DateDebut.ToString("yyyy-MM-dd")</td>
                            <td>@(price.DateFin.HasValue ? price.DateFin.Value.ToString("yyyy-MM-dd") : "Active")</td>
                            <td>
                                <button class="btn btn-sm btn-warning custom-btn" onclick="loadPriceForm('/Admin/EditPrice/@price.Id')">
                                    <i class="material-icons mr-1">edit</i> Edit
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">No price history available.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Add Price Form -->
    <h6>Add New Price</h6>
    <form id="addPriceForm" asp-action="AddPrice" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ArticleId" value="@article.Id" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }
        <div class="form-group">
            <label asp-for="Valeur">Price</label>
            <input asp-for="Valeur" class="form-control" type="number" step="0.01" min="0.01" required />
            <span asp-validation-for="Valeur" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DateDebut">Start Date</label>
            <input asp-for="DateDebut" class="form-control" type="date" required />
            <span asp-validation-for="DateDebut" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DateFin">End Date (Optional)</label>
            <input asp-for="DateFin" class="form-control" type="date" />
            <span asp-validation-for="DateFin" class="text-danger"></span>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Add Price</button>
        </div>
    </form>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<script>
    $(document).on('submit', '#addPriceForm', function (e) {
        e.preventDefault();
        var form = $(this);
        console.log('Submitting price form to:', form.attr('action'));
        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: form.serialize(),
            success: function (response) {
                console.log('Price form submission response:', response);
                if (response.success) {
                    $('#priceModal').modal('hide');
                    window.location.href = '/Admin/Categories';
                } else {
                    $('#priceModalContent').html(response);
                    $.validator.unobtrusive.parse('#priceModalContent form');
                }
            },
            error: function (xhr) {
                console.error('Price form submission error:', xhr.status, xhr.responseText);
                $('#priceModalContent').html(xhr.responseText);
                $.validator.unobtrusive.parse('#priceModalContent form');
                alert('Error submitting the price form.');
            }
        });
    });
</script>