@model VAB.ViewModel.PrixViewModel
@using VAB.Models

@{
    var article = ViewBag.Article as Article;
    var priceHistory = ViewBag.PriceHistory as IEnumerable<Prix>;
    var categoryId = ViewBag.CategoryId;
}

<div class="modal-header">
    <h5 class="modal-title">Gérer l'historique des prix pour @article.Description (ID: @article.IdArticle)</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">×</span>
    </button>
</div>
<div class="modal-body">
    <!-- Price History Table -->
    <h6>Historique des prix</h6>
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Prix</th>
                    <th>Date de début</th>
                    <th>Date de fin</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (priceHistory.Any())
                {
                    foreach (var price in priceHistory)
                    {
                        <tr>
                            <td>@price.Valeur.ToString("C")</td>
                            <td>@price.DateDebut.ToString("yyyy-MM-dd")</td>
                            <td>@(price.DateFin.HasValue ? price.DateFin.Value.ToString("yyyy-MM-dd") : "Actif")</td>
                            <td>
                                <div class="button-container">
                                    <button class="btn btn-sm btn-warning " onclick="loadPriceForm('/Admin/EditPrice/@price.Id?categoryId=@categoryId')">
                                        <i class="material-icons mr-1">edit</i> Modifier
                                    </button>
                                    <form class="delete-price-form" data-id="@price.Id" method="post" asp-action="DeletePrice" asp-route-id="@price.Id" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger ">
                                            <i class="material-icons mr-1">delete</i> Supprimer
                                        </button>
                                    </form>
                                </div>

                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">Aucun historique de prix disponible.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Add Price Form -->
    <h6>Ajouter un nouveau prix</h6>
    <form id="addPriceForm" asp-action="AddPrice" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ArticleId" value="@article.Id" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            </div>
        }
        <div class="form-group">
            <label asp-for="Valeur">Prix</label>
            <input asp-for="Valeur" class="form-control" type="number" step="0.01" min="0.01" required />
            <span asp-validation-for="Valeur" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DateDebut">Date de début</label>
            <input asp-for="DateDebut" class="form-control" type="date" required />
            <span asp-validation-for="DateDebut" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="DateFin">Date de fin (optionnel)</label>
            <input asp-for="DateFin" class="form-control" type="date" />
            <span asp-validation-for="DateFin" class="text-danger"></span>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
            <button type="submit" class="btn btn-primary">Ajouter le prix</button>
        </div>
    </form>
</div>

<script>
    $(document).ready(function () {
        console.log('ManagePrices.cshtml loaded, categoryId:', '@categoryId');
    });

    $(document).on('submit', '#addPriceForm', function (e) {
        e.preventDefault();
        var form = $(this);
        console.log('Submitting price form to:', form.attr('action'));
        $.ajax({
            url: form.attr('action'),
            type: 'POST',
            data: form.serialize(),
            success: function (response) {
                console.log('Price form submission response:', response);
                if (response.success) {
                    console.log('Closing modal...');
                    $('#priceModal').modal('hide');
                    console.log('Modal hidden, redirecting...');
                    var redirectUrl = '@categoryId' ? '/Admin/Prices?categoryId=@categoryId' : '/Admin/Prices';
                    window.location.href = redirectUrl;
                } else {
                    console.log('Response indicates failure, updating modal content');
                    $('#priceModalContent').html(response);
                    $.validator.unobtrusive.parse('#priceModalContent form');
                }
            },
            error: function (xhr) {
                console.error('Price form submission error:', xhr.status, xhr.responseText);
                $('#priceModalContent').html(xhr.responseText);
                $.validator.unobtrusive.parse('#priceModalContent form');
                alert('Erreur lors de la soumission du formulaire de prix.');
            }
        });
    });

        $(function(){
      $('.delete-price-form').on('submit', function(e){
        e.preventDefault();

        var form = $(this);
        var id   = form.data('id');
        var token = form.find('input[name="__RequestVerificationToken"]').val();

        $.ajax({
          url: '/Admin/DeletePrice/' + id,
          type: 'POST',
          data: { __RequestVerificationToken: token },
          success: function(response){
            if (response.success) {
              // remove the row from the table
              form.closest('tr').fadeOut(300, function(){ $(this).remove(); });
            }
            else {
              alert('Erreur: ' + response.message);
            }
          },
          error: function(){
            alert('Une erreur est survenue lors de la suppression.');
          }
        });
      });
    });
</script>