@model IEnumerable<VAB.Models.Article>
@using VAB.Models
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <title>Admin Dashboard - Price Management</title>
    <link rel="shortcut icon" href="~/images/icons/favicon.png" type="image/png">
    <link href="https://fonts.googleapis.com/css?family=Nunito&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/iconfont/material-icons.css">
    <link href="~/css/dataTables.bootstrap4.min.css" rel="stylesheet">
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/sidebar.css" rel="stylesheet">
    <link href="~/css/responsive.css" rel="stylesheet">
    <style>
        .button-container {
            display: flex;
            gap: 10px;
            justify-content: center;
            align-items: center;
        }

        .custom-btn {
            width: 80px;
            text-align: center;
            padding: 4px 8px;
            font-size: 12px;
            line-height: 1.5;
            background-color:darkgrey;
            border-color:darkgray;
            color:black;
        }

        .custom-btn:hover {
            width: 80px;
            text-align: center;
            padding: 4px 8px;
            font-size: 12px;
            line-height: 1.5;
            background-color: dimgrey ;
                border-color: dimgrey;
           
        }

        .table-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .table th, .table td {
            text-align: center;
            vertical-align: middle;
        }

        .table th {
            font-size: 18px;
        }

        .table td {
            font-size: 14px;
            padding: 8px;
        }

        .dataTables_paginate .pagination .page-item.active .page-link {
            background-color: #6c757d;
            border-color: #6c757d;
            color: white;
        }

        .dataTables_paginate .pagination .page-item .page-link {
            color: #6c757d;
            background-color: white;
            border-color: #dee2e6;
        }

            .dataTables_paginate .pagination .page-item .page-link:hover {
                background-color: #5a6268;
                border-color: #5a6268;
                color: white;
            }

        .dataTables_paginate .pagination .page-item.disabled .page-link {
            color: #6c757d;
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }
    </style>
</head>
<body>
   

    <!-- Header -->
    <header>
        <div class="header">
            <div class="navigation">
                <nav class="navbar navbar-expand-lg navbar-bg">
                    <div class="brand-logo">
                        <a class="navbar-brand" asp-controller="Admin" asp-action="Dashboard" id="menu-action">
                            <div class="logo-tunisair">
                                <img src="~/images/icons/Tunisair-Logo-Vector.svg-.png" alt="Tunisair Logo">
                            </div>
                        </a>
                        <div id="nav-toggle">
                            <div class="cta"><div class="toggle-btn type1"></div></div>
                        </div>
                    </div>
                    <div class="for-mobile d-mobile">
                        <div class="toggle-button" id="toggle-button">
                            <span class="material-icons">menu</span>
                        </div>
                    </div>
                    <div class="collapse navbar-collapse pr-3">
                        <ul class="navbar-nav user-info ml-auto mt-2 mt-lg-0">
                            <li class="nav-item dropdown show">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <a href="#" class="navbar-nav-link dropdown-toggle text-light" data-toggle="dropdown">
                                        <div class="user-photo">
                                            <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" style="border-radius: 50%;" alt="User">
                                        </div>
                                        @User.Identity.Name
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a asp-controller="Admin" asp-action="AccountSettings" class="dropdown-item">
                                            <i class="material-icons">supervisor_account</i> Account Settings
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                            <i class="material-icons">exit_to_app</i> Logout
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a>
                                }
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <!-- Sidebar -->
    <section id="left-sidebar-area">
        <!--   Left Sidebar  -->
        <div id="left-sidebar-section">


            <aside>
                <div class="left-sidebar" id="wrapper-sidebar">
                    <ul>
                        <li><a href="@Url.Action("Dashboard", "Admin")"><i class="material-icons">home</i>Dashboard</a></li>
                        <li><a href="@Url.Action("UsersList", "Admin")"><i class="material-icons">supervisor_account</i>Users</a></li>
                        <li class="active"><a asp-controller="Admin" asp-action="Prices"><i class="material-icons">attach_money</i>Prices</a></li>
                        <li>
                            <a href="@Url.Action("Categories", "Admin")">
                                <i>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-basket2-fill" viewBox="0 0 16 16">
                                        <path d="M5.929 1.757a.5.5 0 1 0-.858-.514L2.217 6H.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h.623l1.844 6.456A.75.75 0 0 0 3.69 15h8.622a.75.75 0 0 0 .722-.544L14.877 8h.623a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1.717L10.93 1.243a.5.5 0 1 0-.858.514L12.617 6H3.383zM4 10a1 1 0 0 1 2 0v2a1 1 0 1 1-2 0zm3 0a1 1 0 0 1 2 0v2a1 1 0 1 1-2 0zm4-1a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0v-2a1 1 0 0 1 1-1" />
                                    </svg>
                                </i> Categories / Articles
                            </a>
                        </li>

                    </ul>
                </div>
            </aside>
        </div>
        <!--   Left Sidebar  -->
    </section>

    <!-- Main Content -->
    <section class="d-flex" id="wrapper">
        <div class="page-content-wrapper">
            <div class="content-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard"><i class="material-icons">home</i>Home</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Categories">Categories</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Prices</li>
                    </ol>
                </nav>
            </div>

            <div class="main-content">
                <div class="row mt-3">
                    <div class="col-md-12">
                        <div class="card bg-white">
                            <div class="card-body">
                                @if (TempData["Success"] != null)
                                {
                                    <div class="alert alert-success">
                                        @TempData["Success"]
                                    </div>
                                }

                                <h2 class="mb-4">Gestion des prix</h2>

                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <select id="categoryFilter" class="form-control" onchange="filterByCategory()">
                                            <option value=""> Sélectionner une catégorie.</option>
                                            @foreach (var category in (IEnumerable<Categorie>)ViewBag.Categories)
                                            {
                                                if (ViewBag.CategoryId == category.Id)
                                                {
                                                    <option value="@category.Id" selected>@category.Description</option>
                                                }
                                                else
                                                {
                                                    <option value="@category.Id">@category.Description</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="table-container">
                                    <div class="table-responsive">
                                        <table class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Article ID</th>
                                                    <th>Nom</th>
                                                    <th>Prix actuel</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var article in Model)
                                                {
                                                    <tr>
                                                        <td>@article.IdArticle</td>
                                                        <td>@article.Description</td>
                                                        <td>@article.PrixUnitaireHT.ToString("C")</td>
                                                        <td>
                                                            <div class="button-container">
                                                                <button class="btn btn-sm btn-primary custom-btn" onclick="loadPriceForm('/Admin/ManagePrices/@article.Id')">
                                                                    <i class="material-icons mr-1">euro_symbol</i> Gestion des prix
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Price Modal Container -->
    <div class="modal fade" id="priceModal" tabindex="-1" aria-labelledby="priceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="priceModalContent">
                <!-- Content will be loaded here dynamically -->
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/jquery.dataTables.min.js"></script>
    <script src="~/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/script.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            $('.table').DataTable({
                responsive: true,
                pageLength: 10,
                searching: true,
                ordering: true,
                columnDefs: [
                    { orderable: false, targets: 3 } // Disable sorting on Actions column
                ]
            });
        });

        function loadPriceForm(url) {
            console.log('Loading price form from:', url);
            $.get(url, function (data) {
                console.log('Price form loaded successfully');
                $('#priceModalContent').html(data);
                $('#priceModal').modal('show');
                $.validator.unobtrusive.parse('#priceModalContent form');
            }).fail(function (xhr, status, error) {
                console.error('Error loading price form:', status, error);
                alert('Error loading the price form: ' + error);
            });
        }

        function filterByCategory() {
            var categoryId = $('#categoryFilter').val();
            if (categoryId) {
                window.location.href = '/Admin/Prices?categoryId=' + categoryId;
            } else {
                window.location.href = '/Admin/Prices';
            }
        }
    </script>
</body>
</html>