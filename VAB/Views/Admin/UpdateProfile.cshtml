@model VAB.ViewModel.UserManagementViewModel

<style>
    .modal-body {
        padding: 30px;
        background-color: #f9f9f9;
    }

    .form-horizontal {
        display: flex;
        flex-direction: column;
        gap: 20px;
        width: 100%;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    label {
        font-weight: 600;
        margin-bottom: 6px;
        color: #333;
    }

    .form-control {
        padding: 10px 12px;
        font-size: 16px;
        border: 1px solid #ccc;
        outline: none;
        background-color: #fff;
        width: 100%;
    }

        .form-control:focus {
            border-color: #8B0000;
        }

    .text-danger {
        font-size: 14px;
        color: #dc3545;
        margin-top: 5px;
    }

    .btn-darkred {
        background-color: #8B0000;
        color: white;
        padding: 12px 20px;
        border: none;
        font-weight: bold;
        width: 100%;
        text-transform: uppercase;
        border-radius: 0;
        transition: background-color 0.3s ease;
    }

        .btn-darkred:hover {
            background-color: #a30000;
        }
</style>

<div class="modal-body">
    <form id="UpdateProfileForm" class="form-horizontal" asp-controller="Account" asp-action="UpdateProfile" method="post">
        <div class="form-group">
            <label asp-for="NomPrenom"></label>
            <input asp-for="NomPrenom" class="form-control" required />
            <span asp-validation-for="NomPrenom" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Telephone"></label>
            <input asp-for="Telephone" class="form-control" required />
            <span asp-validation-for="Telephone" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-darkred">Save Changes</button>
    </form>
</div>

<script>
    document.getElementById("UpdateProfileForm").addEventListener("submit", function (event) {
        let confirmation = confirm("Are you sure you want to submit this form?");
        if (!confirmation) {
            event.preventDefault();
        }
    });
</script>
