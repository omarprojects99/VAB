@model IEnumerable<VAB.ViewModel.UserManagementViewModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">

    <!-- Title -->
    <title>Admin Dashboard</title>

    <!-- Bootstrap Icons CDN (for missing icons) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Nunito&display=swap" rel="stylesheet">

    <!-- Material Icons -->
    <link rel="stylesheet" href="~/iconfont/material-icons.css">

    <!-- DataTables Bootstrap 4 CSS -->
    <link href="~/css/dataTables.bootstrap4.min.css" rel="stylesheet" media="screen">

    <!-- Chart.min CSS -->
    <link href="~/css/Chart.min.css" rel="stylesheet" media="screen">

    <!-- Animate CSS -->
    <link href="~/css/animate.css" rel="stylesheet" media="screen">
    <!-- Normalize CSS -->
    <link href="~/css/normalize.css" rel="stylesheet" media="screen">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css">

    <!-- Style CSS -->
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/sidebar.css">
    <!-- Responsive CSS -->
    <link rel="stylesheet" href="~/css/responsive.css">

    <style>
        .dataTables_paginate .pagination .page-item.active .page-link {
            background-color: #6c757d;
            border-color: #6c757d;
            color: white;
        }

        .dataTables_paginate .pagination .page-item .page-link {
            color: #6c757d;
            background-color: white;
            border-color: #dee2e6;
        }

            .dataTables_paginate .pagination .page-item .page-link:hover {
                background-color: #5a6268;
                border-color: #5a6268;
                color: white;
            }

        .dataTables_paginate .pagination .page-item.disabled .page-link {
            color: #6c757d;
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .user-inactive {
            opacity: 0.6;
            background-color: #f8f9fa;
        }

            .user-inactive td {
                color: #6c757d;
            }

        .badge-inactive {
            background-color: #dc3545;
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75em;
        }

        .badge-active {
            background-color: #28a745;
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75em;
        }

        /* Custom Modal Styles */
        .modal-alert {
            max-width: 400px;
            margin: 0 auto;
        }

            .modal-alert .modal-content {
                border-radius: 15px;
                border: none;
                box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            }

            .modal-alert .modal-body {
                padding: 2rem;
            }

        .icon-container {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .modal-alert .btn {
            border-radius: 25px;
            padding: 0.5rem 2rem;
            font-weight: 600;
        }

        /* Toast Notification Styles */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
        }

        .toast {
            min-width: 300px;
        }
    </style>
</head>
<body>
    <!-- Header (same as before) -->
    <header>
        <div class="header">
            <div class="navigation">
                <nav class="navbar navbar-expand-lg navbar-bg">
                    <div class="brand-logo">
                        <a class="navbar-brand" href="@Url.Action("Dashboard", "Admin")" id="menu-action">
                            <div class="logo-tunisair">
                                <img src="~/images/icons/Tunisair-Logo-Vector.svg-.png" alt="">
                            </div>
                        </a>
                        <div id="nav-toggle">
                            <div class="cta">
                                <div class="toggle-btn type1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="for-mobile d-mobile">
                        <div class="toggle-button" id="toggle-button">
                            <span class="material-icons">menu</span>
                        </div>
                    </div>
                    <div class="collapse navbar-collapse pr-3" id="#">
                        <ul class="navbar-nav user-info ml-auto mt-2 mt-lg-0">
                            <li class="nav-item dropdown show">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <a href="#" class="navbar-nav-link dropdown-toggle text-light" data-toggle="dropdown" aria-expanded="true">
                                        <div class="user-photo">
                                            <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" style="border-radius: 50%;" alt="">
                                        </div>
                                        @User.Identity.Name
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a asp-controller="Admin" asp-action="AccountSettings" class="dropdown-item">
                                            <i class="material-icons">supervisor_account</i> Account Settings
                                        </a>
                                        <div class="menu-dropdown-divider"></div>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                            <i class="material-icons">exit_to_app</i> Logout
                                        </a>
                                    </div>
                                }
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <!-- Left Sidebar (same as before) -->
    <section id="left-sidebar-area">
        <div id="left-sidebar-section">
            <aside>
                <div class="left-sidebar" id="wrapper-sidebar">
                    <ul>
                        <li class="active"><a href="@Url.Action("Dashboard", "Admin")"><i class="material-icons">home</i>Dashboard</a></li>
                        <li><a href="@Url.Action("UsersList", "Admin")"><i class="material-icons">supervisor_account</i>Users</a></li>
                        <li><a asp-controller="Admin" asp-action="Prices"><i class="material-icons">attach_money</i>Prices</a></li>
                        <li>
                            <a href="@Url.Action("Categories", "Admin")">
                                <i>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-basket2-fill" viewBox="0 0 16 16">
                                        <path d="M5.929 1.757a.5.5 0 1 0-.858-.514L2.217 6H.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h.623l1.844 6.456A.75.75 0 0 0 3.69 15h8.622a.75.75 0 0 0 .722-.544L14.877 8h.623a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1.717L10.93 1.243a.5.5 0 1 0-.858.514L12.617 6H3.383zM4 10a1 1 0 0 1 2 0v2a1 1 0 1 1-2 0zm3 0a1 1 0 0 1 2 0v2a1 1 0 1 1-2 0zm4-1a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0v-2a1 1 0 0 1 1-1" />
                                    </svg>
                                </i> Categories / Articles
                            </a>
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </section>

    <!-- Main Wrapper -->
    <section class="d-flex" id="wrapper">
        <div class="page-content-wrapper">
            <!-- Header BreadCrumb -->
            <div class="content-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard"><i class="material-icons">home</i>Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Users</li>
                    </ol>
                </nav>
                <div class="create-item">
                    <button onclick="loadUserForm('/Admin/AddUser')" class="btn btn-secondary"><i class="material-icons">add</i> Ajouter un utilisateur</button>
                   
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }
            @* @if (TempData["Success"] != null) *@
            @* { *@
            @*     <div class="alert alert-success alert-dismissible fade show" role="alert"> *@
            @*         @TempData["Success"] *@
            @*         <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button> *@
            @*     </div> *@
            @* } *@

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <!-- Main Content -->
            <div class="main-content">
                <div class="row mt-3">
                    <div class="col-md-12">
                        <div class="card bg-white">
                            <div class="card-body mt-3">
                                <div class="table-responsive">
                                    <table id="usersTable" class="table table-striped table-borderless" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Nom et prenom</th>
                                                <th>Email</th>
                                                <th>Téléphone</th>
                                                <th>Role</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var user in Model)
                                            {
                                                <tr class="@(!user.IsActive ? "user-inactive" : "")">
                                                    <td>@user.NomPrenom</td>
                                                    <td>@user.Email</td>
                                                    <td>@user.Telephone</td>
                                                    <td>@string.Join(", ", user.Roles)</td>
                                                    <td>
                                                        @if (user.IsActive)
                                                        {
                                                            <span class="badge-active">Active</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge-inactive">Inactive</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <a class="btn btn-sm btn-info custom-btn" href="javascript:void(0);" onclick="loadUserForm('/Admin/ViewUser?id=@user.Id')">
                                                            <i class="material-icons mr-1">visibility</i> Voir
                                                        </a>
                                                        <a href="javascript:void(0);" onclick="loadUserForm('/Admin/EditUser?id=@user.Id')" class="btn btn-sm btn-warning">
                                                            <i class="material-icons mr-1">edit</i> Modifier
                                                        </a>

                                                        @if (user.IsActive)
                                                        {
                                                            <button style="block-size:31px" type="button" class="btn btn-sm btn-danger" onclick="deactivateUser('@user.Id', '@user.NomPrenom')">
                                                                <i class="bi bi-person-x"></i> Désactiver
                                                            </button>
                                                            <!-- New smart delete button -->
                                                            <button style="block-size:31px" type="button" class="btn btn-sm btn-outline-danger" onclick="deleteOrDeactivateUser('@user.Id', '@user.NomPrenom')">
                                                                <i class="bi bi-trash"></i> Supprimer
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button style="block-size:31px" type="button" class="btn btn-sm btn-success" onclick="reactivateUser('@user.Id', '@user.NomPrenom')">
                                                                <i class="bi bi-person-check"></i> Réactiver
                                                            </button>
                                                            <!-- Smart delete for inactive users too -->
                                                            <button style="block-size:31px" type="button" class="btn btn-sm btn-outline-danger" onclick="deleteOrDeactivateUser('@user.Id', '@user.NomPrenom')">
                                                                <i class="bi bi-trash"></i> Supprimer
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bootstrap Modal -->
    <div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="modalContent">
                <!-- Content will be loaded here dynamically -->
            </div>
        </div>
    </div>

    <!-- Custom Modals -->
    <!-- Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-alert">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-success" id="successModalLabel">Success</h5>
                </div>
                <div class="modal-body text-center">
                    <div class="text-success icon-container mb-3">
                        <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="mt-2" id="successMessage">Operation completed successfully!</h5>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-success" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Modal -->
    <div class="modal fade" id="errorModal" tabindex="-1" role="dialog" aria-labelledby="errorModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-alert">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-danger" id="errorModalLabel">Error</h5>
                </div>
                <div class="modal-body text-center">
                    <div class="text-danger icon-container mb-3">
                        <i class="bi bi-x-circle-fill" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="mt-2" id="errorMessage">An error occurred!</h5>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-alert">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-primary" id="confirmModalLabel">Confirm Action</h5>
                </div>
                <div class="modal-body text-center">
                    <div class="text-primary icon-container mb-3">
                        <i class="bi bi-question-circle-fill" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="mt-2" id="confirmMessage">Are you sure you want to proceed?</h5>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-secondary me-2" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmActionBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container">
        <div id="successToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-success text-white">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" data-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="successToastMessage">
                Operation completed successfully!
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.dataTables.min.js"></script>
    <script src="~/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/Chart.min.js"></script>
    <script src="~/js/Chart.bundle.min.js"></script>
    <script src="~/js/chartfunction.js"></script>
    <script src="~/js/wow.min.js"></script>
    <script src="~/js/script.js"></script>

    <script>
        $(document).ready(function () {
            // Check if DataTable is already initialized
            if (!$.fn.DataTable.isDataTable('#usersTable')) {
                $('#usersTable').DataTable({
                    responsive: true,
                    pageLength: 10,
                    lengthMenu: [10, 15, 25],
                    order: [[0, 'asc']],
                    columnDefs: [
                        { orderable: false, targets: [5] } // Disable sorting on Actions column
                    ]
                });
            }
        });

        // Custom Modal Functions - ENHANCED VERSION
        function showCustomModal(type, title, message, callback = null) {
            console.log(`Showing ${type} modal with title: ${title}`);
            const modalId = type + 'Modal';
            const modal = $('#' + modalId);

            if (modal.length) {
                // Set title and message
                modal.find('.modal-title').text(title);
                modal.find('[id$="Message"]').text(message);

                // Show modal
                modal.modal('show');

                // Handle callback for confirmation modals
                if (callback && (type === 'confirm')) {
                    const confirmBtn = modal.find('#confirmActionBtn');
                    confirmBtn.off('click').on('click', function() {
                        modal.modal('hide');
                        callback();
                    });
                }
            } else {
                console.error(`Modal ${modalId} not found`);
                // Fallback to browser confirm/alert
                if (type === 'confirm' && callback) {
                    if (confirm(`${title}\n\n${message}`)) {
                        callback();
                    }
                } else {
                    alert(`${title}\n\n${message}`);
                }
            }
        }

        // Convenience functions
        function showSuccess(message, title = 'Success') {
            showCustomModal('success', title, message);
        }

        function showError(message, title = 'Error') {
            showCustomModal('error', title, message);
        }

        function showConfirm(message, title = 'Confirm', callback = null) {
            showCustomModal('confirm', title, message, callback);
        }

        // Enhanced toast function with HTML support and custom duration
        function showEnhancedToast(message, type = 'success', duration = 3000) {
            const toast = $('#successToast');
            const header = toast.find('.toast-header');
            const body = toast.find('.toast-body');

            // Change toast styling based on type
            header.removeClass('bg-success bg-warning bg-danger text-white text-dark');

            if (type === 'warning') {
                header.addClass('bg-warning text-dark');
                toast.find('i').removeClass().addClass('bi bi-exclamation-triangle-fill me-2');
            } else if (type === 'danger') {
                header.addClass('bg-danger text-white');
                toast.find('i').removeClass().addClass('bi bi-x-circle-fill me-2');
            } else {
                header.addClass('bg-success text-white');
                toast.find('i').removeClass().addClass('bi bi-check-circle-fill me-2');
            }

            // Set message (with HTML support)
            body.html(message);

            // Configure toast options
            toast.toast({
                delay: duration,
                autohide: true
            });

            toast.toast('show');
        }

        // Show Bootstrap Toast - ENHANCED VERSION
        function showToast(message, type = 'success') {
            const toast = $('#successToast');
            const header = toast.find('.toast-header');

            // Change toast styling based on type
            header.removeClass('bg-success bg-warning bg-danger text-white text-dark');

            if (type === 'warning') {
                header.addClass('bg-warning text-dark');
                toast.find('i').removeClass().addClass('bi bi-exclamation-triangle-fill me-2');
            } else if (type === 'danger') {
                header.addClass('bg-danger text-white');
                toast.find('i').removeClass().addClass('bi bi-x-circle-fill me-2');
            } else {
                header.addClass('bg-success text-white');
                toast.find('i').removeClass().addClass('bi bi-check-circle-fill me-2');
            }

            $('#successToastMessage').text(message);
            toast.toast('show');
        }

        // MAIN FUNCTION - Smart delete/deactivate with proper relationship checking
        function deleteOrDeactivateUser(userId, userName) {
            console.log(`🔥 deleteOrDeactivateUser called for user: ${userName} (${userId})`);

            showConfirm(
                `Êtes-vous sûr de vouloir supprimer ${userName}? Si l'utilisateur a des données liées, il sera désactivé au lieu d'être supprimé.`,
                'Supprimer/Désactiver Utilisateur',
                function() {
                    console.log('✅ User confirmed deletion/deactivation');

                    $.post('/Admin/DeleteOrDeactivateUser', { id: userId })
                        .done(function(response) {
                            console.log('📨 Server response:', response);

                            if (response.success) {
                                if (response.action === 'deleted') {
                                    showEnhancedToast(`✅ L'utilisateur ${userName} a été supprimé définitivement.`, 'success');
                                } else if (response.action === 'deactivated') {
                                    // Show detailed information about why the user was deactivated
                                    let detailsHtml = '';
                                    if (response.details && response.details.length > 0) {
                                        detailsHtml = '<br><small><strong>Relations trouvées:</strong> ' + response.details.join(', ') + '</small>';
                                    }

                                    showEnhancedToast(
                                        `⚠️ ${userName} a été désactivé au lieu d'être supprimé.${detailsHtml}`,
                                        'warning',
                                        8000 // Show for 8 seconds
                                    );
                                }
                                setTimeout(() => location.reload(), 4000);
                            } else {
                                console.error('❌ Server returned error:', response.message);
                                showError(response.message);
                            }
                        })
                        .fail(function(xhr, status, error) {
                            console.error('💥 AJAX request failed:', status, error);
                            console.error('Response text:', xhr.responseText);
                            showError('Une erreur inattendue s\'est produite lors du traitement de la demande.');
                        });
                }
            );
        }

        // Debug function to test relationships before deletion
        function testUserRelationshipsDebug(userId, userName, callback) {
            console.log(`🧪 Testing relationships for user: ${userName} (${userId})`);

            $.get('/Admin/TestUserRelationships', { id: userId })
                .done(function(response) {
                    console.log('🧪 Relationship test response:', response);

                    if (response.success) {
                        console.log(`📊 Relationship Summary for ${response.userName}:`);
                        console.log(`   - User ID: ${response.userId}`);
                        console.log(`   - Has Related Data: ${response.hasRelatedData}`);
                        console.log(`   - Total Relationships: ${response.totalRelationships}`);
                        console.log(`   - Details: ${response.details.join(', ')}`);
                        console.log(`   - Individual Tests:`, response.individualTests);

                        // Show a summary alert
                        let message = `🧪 Test des relations pour ${response.userName}:\n\n`;
                        message += `A des données liées: ${response.hasRelatedData ? 'OUI' : 'NON'}\n`;
                        message += `Nombre total de relations: ${response.totalRelationships}\n\n`;

                        if (response.details && response.details.length > 0) {
                            message += `Détails:\n${response.details.join('\n')}\n\n`;
                        }

                        message += `Tests individuels:\n`;
                        for (const [key, value] of Object.entries(response.individualTests)) {
                            message += `- ${key}: ${value.count} enregistrement(s)\n`;
                        }

                        alert(message);

                        if (callback) callback();
                    } else {
                        console.error('❌ Relationship test failed:', response.message);
                        alert(`Erreur lors du test des relations: ${response.message}`);
                    }
                })
                .fail(function() {
                    console.error('💥 Relationship test request failed');
                    alert('Erreur lors du test des relations utilisateur.');
                    if (callback) callback(); // Continue anyway
                });
        }

        // Function to get detailed motif information
        function getUserMotifs(userId, userName) {
            $.get('/Admin/GetUserMotifs', { id: userId })
                .done(function(response) {
                    if (response.success) {
                        let message = `📋 Motifs pour ${userName}:\n\n`;
                        message += `Motifs créés: ${response.createdCount}\n`;
                        message += `Motifs lus: ${response.readCount}\n\n`;

                        if (response.createdMotifs.length > 0) {
                            message += `Motifs créés:\n`;
                            response.createdMotifs.forEach(motif => {
                                message += `- ${motif.NumeroEtatVenteArrivee}: ${motif.Description} (${motif.DateCreation})\n`;
                            });
                        }

                        alert(message);
                    }
                });
        }

        // Enhanced delete function with pre-check option
        function deleteOrDeactivateUserWithPreCheck(userId, userName) {
            console.log(`🔍 Pre-checking relationships for user: ${userName} (${userId})`);

            // First, test the relationships to see what we find
            testUserRelationshipsDebug(userId, userName, () => {
                // Proceed with actual deletion after seeing the test results
                deleteOrDeactivateUser(userId, userName);
            });
        }

        // EXISTING FUNCTIONS - Updated with French messages
        function deactivateUser(userId, userName) {
            showConfirm(
                `Êtes-vous sûr de vouloir désactiver ${userName}? Cela l'empêchera de se connecter.`,
                'Désactiver Utilisateur',
                function() {
                    $.post('/Admin/DeactivateUser', { id: userId })
                        .done(function(response) {
                            if (response.success) {
                                showToast(response.message);
                                setTimeout(() => location.reload(), 2000);
                            } else {
                                showError(response.message);
                            }
                        })
                        .fail(function() {
                            showError('Une erreur inattendue s\'est produite lors de la désactivation de l\'utilisateur.');
                        });
                }
            );
        }

        function reactivateUser(userId, userName) {
            showConfirm(
                `Êtes-vous sûr de vouloir réactiver ${userName}?`,
                'Réactiver Utilisateur',
                function() {
                    $.post('/Admin/ReactivateUser', { id: userId })
                        .done(function(response) {
                            if (response.success) {
                                showToast(response.message);
                                setTimeout(() => location.reload(), 2000);
                            } else {
                                showError(response.message);
                            }
                        })
                        .fail(function() {
                            showError('Une erreur inattendue s\'est produite lors de la réactivation de l\'utilisateur.');
                        });
                }
            );
        }

        function loadUserForm(url) {
            $.get(url)
                .done(function(data) {
                    $('#modalContent').html(data);
                    $('#userModal').modal('show');
                })
                .fail(function() {
                    showError('Échec du chargement des informations utilisateur');
                });
        }

        // Utility function to show all user relationships (for debugging)
        function showAllUserRelationships(userId, userName) {
            $.get('/Admin/TestUserRelationships', { id: userId })
                .done(function(response) {
                    if (response.success) {
                        let details = `Relations détaillées pour ${response.userName}:\n\n`;
                        details += `Email: ${response.userEmail}\n`;
                        details += `ID: ${response.userId}\n\n`;
                        details += `Résumé: ${response.hasRelatedData ? 'A des données liées' : 'Aucune donnée liée'}\n`;
                        details += `Total relations: ${response.totalRelationships}\n\n`;

                        if (response.details && response.details.length > 0) {
                            details += `Détails des relations:\n`;
                            response.details.forEach(detail => {
                                details += `• ${detail}\n`;
                            });
                            details += '\n';
                        }

                        details += `Tests individuels:\n`;
                        for (const [key, value] of Object.entries(response.individualTests)) {
                            details += `• ${key}: ${value.count} enregistrement(s) ${value.hasData ? '✓' : '✗'}\n`;
                        }

                        // Create a modal or alert with the information
                        showCustomModal('success', 'Relations Utilisateur', details);
                    } else {
                        showError(`Erreur: ${response.message}`);
                    }
                })
                .fail(function() {
                    showError('Erreur lors de la récupération des relations utilisateur.');
                });
        }
    </script>
</body>
</html>