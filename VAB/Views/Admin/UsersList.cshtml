@model IEnumerable<VAB.ViewModel.UserManagementViewModel>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">

    <!-- Title -->
    <title>Admin Dashboard</title>

    <!-- Bootstrap Icons CDN (for missing icons) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Nunito&display=swap" rel="stylesheet">

    <!-- Material Icons -->
    <link rel="stylesheet" href="~/iconfont/material-icons.css">

    <!-- DataTables Bootstrap 4 CSS -->
    <link href="~/css/dataTables.bootstrap4.min.css" rel="stylesheet" media="screen">

    <!-- Chart.min CSS -->
    <link href="~/css/Chart.min.css" rel="stylesheet" media="screen">

    <!-- Animate CSS -->
    <link href="~/css/animate.css" rel="stylesheet" media="screen">
    <!-- Normalize CSS -->
    <link href="~/css/normalize.css" rel="stylesheet" media="screen">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css">

    <!-- Style CSS -->
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/sidebar.css">
    <!-- Responsive CSS -->
    <link rel="stylesheet" href="~/css/responsive.css">

    <style>
        .dataTables_paginate .pagination .page-item.active .page-link {
            background-color: #6c757d;
            border-color: #6c757d;
            color: white;
        }

        .dataTables_paginate .pagination .page-item .page-link {
            color: #6c757d;
            background-color: white;
            border-color: #dee2e6;
        }

            .dataTables_paginate .pagination .page-item .page-link:hover {
                background-color: #5a6268;
                border-color: #5a6268;
                color: white;
            }

        .dataTables_paginate .pagination .page-item.disabled .page-link {
            color: #6c757d;
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .user-inactive {
            opacity: 0.6;
            background-color: #f8f9fa;
        }

            .user-inactive td {
                color: #6c757d;
            }

        .badge-inactive {
            background-color: #dc3545;
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75em;
        }

        .badge-active {
            background-color: #28a745;
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75em;
        }

        /* Custom Modal Styles */
        .modal-alert {
            max-width: 400px;
            margin: 0 auto;
        }

            .modal-alert .modal-content {
                border-radius: 15px;
                border: none;
                box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            }

            .modal-alert .modal-body {
                padding: 2rem;
            }

        .icon-container {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .modal-alert .btn {
            border-radius: 25px;
            padding: 0.5rem 2rem;
            font-weight: 600;
        }

        /* Toast Notification Styles */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
        }

        .toast {
            min-width: 300px;
        }
    </style>
</head>
<body>
    <!-- Header (same as before) -->
    <header>
        <div class="header">
            <div class="navigation">
                <nav class="navbar navbar-expand-lg navbar-bg">
                    <div class="brand-logo">
                        <a class="navbar-brand" href="@Url.Action("Dashboard", "Admin")" id="menu-action">
                            <div class="logo-tunisair">
                                <img src="~/images/icons/Tunisair-Logo-Vector.svg-.png" alt="">
                            </div>
                        </a>
                        <div id="nav-toggle">
                            <div class="cta">
                                <div class="toggle-btn type1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="for-mobile d-mobile">
                        <div class="toggle-button" id="toggle-button">
                            <span class="material-icons">menu</span>
                        </div>
                    </div>
                    <div class="collapse navbar-collapse pr-3" id="#">
                        <ul class="navbar-nav user-info ml-auto mt-2 mt-lg-0">
                            <li class="nav-item dropdown show">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <a href="#" class="navbar-nav-link dropdown-toggle text-light" data-toggle="dropdown" aria-expanded="true">
                                        <div class="user-photo">
                                            <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" style="border-radius: 50%;" alt="">
                                        </div>
                                        @User.Identity.Name
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a asp-controller="Admin" asp-action="AccountSettings" class="dropdown-item">
                                            <i class="material-icons">supervisor_account</i> Account Settings
                                        </a>
                                        <div class="menu-dropdown-divider"></div>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                            <i class="material-icons">exit_to_app</i> Logout
                                        </a>
                                    </div>
                                }
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <!-- Left Sidebar (same as before) -->
    <section id="left-sidebar-area">
        <div id="left-sidebar-section">
            <aside>
                <div class="left-sidebar" id="wrapper-sidebar">
                    <ul>
                        <li class="active"><a href="@Url.Action("Dashboard", "Admin")"><i class="material-icons">home</i>Dashboard</a></li>
                        <li><a href="@Url.Action("UsersList", "Admin")"><i class="material-icons">supervisor_account</i>Users</a></li>
                        <li><a asp-controller="Admin" asp-action="Prices"><i class="material-icons">attach_money</i>Prices</a></li>
                        <li>
                            <a href="@Url.Action("Categories", "Admin")">
                                <i>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-basket2-fill" viewBox="0 0 16 16">
                                        <path d="M5.929 1.757a.5.5 0 1 0-.858-.514L2.217 6H.5a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h.623l1.844 6.456A.75.75 0 0 0 3.69 15h8.622a.75.75 0 0 0 .722-.544L14.877 8h.623a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-1.717L10.93 1.243a.5.5 0 1 0-.858.514L12.617 6H3.383zM4 10a1 1 0 0 1 2 0v2a1 1 0 1 1-2 0zm3 0a1 1 0 0 1 2 0v2a1 1 0 1 1-2 0zm4-1a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0v-2a1 1 0 0 1 1-1" />
                                    </svg>
                                </i> Categories / Articles
                            </a>
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </section>

    <!-- Main Wrapper -->
    <section class="d-flex" id="wrapper">
        <div class="page-content-wrapper">
            <!-- Header BreadCrumb -->
            <div class="content-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard"><i class="material-icons">home</i>Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Users</li>
                    </ol>
                </nav>
                <div class="create-item">
                    <button onclick="loadUserForm('/Admin/AddUser')" class="btn btn-secondary"><i class="material-icons">add</i> Add User</button>
                    <a href="#" name="export" class="btn btn-secondary"><i class="material-icons">download</i>Export Excel</a>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }
            @* @if (TempData["Success"] != null) *@
            @* { *@
            @*     <div class="alert alert-success alert-dismissible fade show" role="alert"> *@
            @*         @TempData["Success"] *@
            @*         <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button> *@
            @*     </div> *@
            @* } *@

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <!-- Main Content -->
            <div class="main-content">
                <div class="row mt-3">
                    <div class="col-md-12">
                        <div class="card bg-white">
                            <div class="card-body mt-3">
                                <div class="table-responsive">
                                    <table id="usersTable" class="table table-striped table-borderless" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>Nom et prenom</th>
                                                <th>Email</th>
                                                <th>Téléphone</th>
                                                <th>Role</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var user in Model)
                                            {
                                                <tr class="@(!user.IsActive ? "user-inactive" : "")">
                                                    <td>@user.NomPrenom</td>
                                                    <td>@user.Email</td>
                                                    <td>@user.Telephone</td>
                                                    <td>@string.Join(", ", user.Roles)</td>
                                                    <td>
                                                        @if (user.IsActive)
                                                        {
                                                            <span class="badge-active">Active</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge-inactive">Inactive</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <a class="btn btn-sm btn-info custom-btn" href="javascript:void(0);" onclick="loadUserForm('/Admin/ViewUser?id=@user.Id')">
                                                            <i class="material-icons mr-1">visibility</i> View
                                                        </a>
                                                        <a href="javascript:void(0);" onclick="loadUserForm('/Admin/EditUser?id=@user.Id')" class="btn btn-sm btn-warning">
                                                            <i class="material-icons mr-1">edit</i> Edit
                                                        </a>

                                                        @if (user.IsActive)
                                                        {
                                                            <button style="block-size:31px" type="button" class="btn btn-sm btn-danger" onclick="deactivateUser('@user.Id', '@user.NomPrenom')">
                                                                <i class="bi bi-person-x"></i> Deactivate
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button style="block-size:31px" type="button" class="btn btn-sm btn-success" onclick="reactivateUser('@user.Id', '@user.NomPrenom')">
                                                                <i class="bi bi-person-check"></i> Reactivate
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bootstrap Modal -->
    <div class="modal fade" id="userModal" tabindex="-1" aria-labelledby="userModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="modalContent">
                <!-- Content will be loaded here dynamically -->
            </div>
        </div>
    </div>

    <!-- Custom Modals -->
    <!-- Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-alert">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-success" id="successModalLabel">Success</h5>
                </div>
                <div class="modal-body text-center">
                    <div class="text-success icon-container mb-3">
                        <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="mt-2" id="successMessage">Operation completed successfully!</h5>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-success" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Modal -->
    <div class="modal fade" id="errorModal" tabindex="-1" role="dialog" aria-labelledby="errorModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-alert">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-danger" id="errorModalLabel">Error</h5>
                </div>
                <div class="modal-body text-center">
                    <div class="text-danger icon-container mb-3">
                        <i class="bi bi-x-circle-fill" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="mt-2" id="errorMessage">An error occurred!</h5>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-danger" data-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-alert">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-primary" id="confirmModalLabel">Confirm Action</h5>
                </div>
                <div class="modal-body text-center">
                    <div class="text-primary icon-container mb-3">
                        <i class="bi bi-question-circle-fill" style="font-size: 3rem;"></i>
                    </div>
                    <h5 class="mt-2" id="confirmMessage">Are you sure you want to proceed?</h5>
                </div>
                <div class="modal-footer border-0 justify-content-center">
                    <button type="button" class="btn btn-secondary me-2" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmActionBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container">
        <div id="successToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-success text-white">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close btn-close-white" data-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body" id="successToastMessage">
                Operation completed successfully!
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.dataTables.min.js"></script>
    <script src="~/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/Chart.min.js"></script>
    <script src="~/js/Chart.bundle.min.js"></script>
    <script src="~/js/chartfunction.js"></script>
    <script src="~/js/wow.min.js"></script>
    <script src="~/js/script.js"></script>

    <script>
        $(document).ready(function () {
            // Check if DataTable is already initialized
            if (!$.fn.DataTable.isDataTable('#usersTable')) {
                $('#usersTable').DataTable({
                    responsive: true,
                    pageLength: 10,
                    lengthMenu: [10, 15, 25],
                    order: [[0, 'asc']],
                    columnDefs: [
                        { orderable: false, targets: [5] } // Disable sorting on Actions column
                    ]
                });
            }
        });

        // Custom Modal Functions
        function showCustomModal(type, title, message, callback = null) {
            const modalId = type + 'Modal';
            const modal = $('#' + modalId);

            if (modal.length) {
                // Set title and message
                modal.find('.modal-title').text(title);
                modal.find('[id$="Message"]').text(message);

                // Show modal
                modal.modal('show');

                // Handle callback for confirmation modals
                if (callback && (type === 'confirm')) {
                    const confirmBtn = modal.find('#confirmActionBtn');
                    confirmBtn.off('click').on('click', function() {
                        modal.modal('hide');
                        callback();
                    });
                }
            }
        }

        // Convenience functions
        function showSuccess(message, title = 'Success') {
            showCustomModal('success', title, message);
        }

        function showError(message, title = 'Error') {
            showCustomModal('error', title, message);
        }

        function showConfirm(message, title = 'Confirm', callback = null) {
            showCustomModal('confirm', title, message, callback);
        }

        // Show Bootstrap Toast
         function showToast(message, type = 'success') {
             const toast = $('#successToast');
             $('#successToastMessage').text(message);
             toast.toast('show');
         }

        function deactivateUser(userId, userName) {
            showConfirm(
                `Are you sure you want to deactivate ${userName}? This will prevent them from logging in.`,
                'Deactivate User',
                function() {
                    $.post('/Admin/DeactivateUser', { id: userId })
                        .done(function(response) {
                            if (response.success) {
                                showToast(response.message);
                                setTimeout(() => location.reload(), 2000);
                            } else {
                                showError(response.message);
                            }
                        })
                        .fail(function() {
                            showError('An unexpected error occurred while deactivating the user.');
                        });
                }
            );
        }

        function reactivateUser(userId, userName) {
            showConfirm(
                `Are you sure you want to reactivate ${userName}?`,
                'Reactivate User',
                function() {
                    $.post('/Admin/ReactivateUser', { id: userId })
                        .done(function(response) {
                            if (response.success) {
                                showToast(response.message);
                                setTimeout(() => location.reload(), 2000);
                            } else {
                                showError(response.message);
                            }
                        })
                        .fail(function() {
                            showError('An unexpected error occurred while reactivating the user.');
                        });
                }
            );
        }

        function loadUserForm(url) {
            $.get(url)
                .done(function(data) {
                    $('#modalContent').html(data);
                    $('#userModal').modal('show');
                })
                .fail(function() {
                    showError('Failed to load user information');
                });
        }
    </script>
</body>
</html>