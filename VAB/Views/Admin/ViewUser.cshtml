@{
    Layout = null;
}
@model VAB.ViewModel.UserManagementViewModel

<div class="identity-card-modal container-fluid px-0">
    <style>
        .identity-card-modal .card {
            background: linear-gradient(135deg, #fff0f0, #f8dada);
            border: none;
            border-radius: 0;
            width: 100%;
            box-shadow: none;
            padding: 30px;
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 30px;
            margin: 0;
        }

        .identity-card-modal .profile-photo {
            border-radius: 50%;
            border: 4px solid #8B0000;
            width: 160px;
            height: 160px;
            object-fit: cover;
            box-shadow: 0 0 12px rgba(0, 0, 0, 0.1);
        }

        .identity-card-modal .user-info {
            flex: 1;
        }

            .identity-card-modal .user-info h3 {
                margin: 0;
                color: #8B0000;
                font-size: 2rem;
                font-weight: 700;
            }

        .badge-role {
            background-color: #8B0000;
            color: #fff;
            font-size: 1rem;
            padding: 6px 14px;
            border-radius: 20px;
            display: inline-block;
            margin-top: 10px;
        }

        .info-list {
            list-style: none;
            padding: 0;
            margin-top: 25px;
            font-size: 1rem;
        }

            .info-list li {
                margin-bottom: 12px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

        .info-icon {
            color: #8B0000;
            font-size: 1.2rem;
        }

        .info-label {
            font-weight: 600;
            color: #6c757d;
        }

        .password-section {
            margin-top: 20px;
            padding: 15px;
            background-color: rgba(139, 0, 0, 0.1);
            border-radius: 8px;
        }

        .password-controls {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .modal-body {
            padding: 0;
        }
    </style>

    <div class="card">
        <div>
            <img class="profile-photo" src="https://militaryhealthinstitute.org/wp-content/uploads/sites/37/2021/08/blank-profile-picture-png.png" alt="Profile Photo">
        </div>

        <div class="user-info">
            <h3>@Model.NomPrenom</h3>
            <div class="badge-role">@string.Join(", ", Model.Roles)</div>

            <ul class="info-list">
                <li>
                    <i class="bi bi-envelope-fill info-icon"></i>
                    <span><span class="info-label">Email:</span> @Model.Email</span>
                </li>
                <li>
                    <i class="bi bi-telephone-fill info-icon"></i>
                    <span><span class="info-label">Phone:</span> @Model.Telephone</span>
                </li>
            </ul>

            <!-- Password Management Section -->
            <div class="password-section">
                <h5><i class="bi bi-key-fill info-icon"></i> Password Management</h5>
                <div class="password-controls">
                    <button type="button" class="btn btn-warning btn-sm" onclick="resetUserPassword('@Model.Id')">
                        <i class="bi bi-arrow-clockwise"></i> Reset Password
                    </button>
                    <button type="button" class="btn btn-info btn-sm" onclick="showSetPasswordForm('@Model.Id')">
                        <i class="bi bi-pencil"></i> Set New Password
                    </button>
                </div>

                <!-- Set Password Form (Initially Hidden) -->
                <div id="setPasswordForm" style="display: none; margin-top: 15px;">
                    <div class="input-group">
                        <input type="password" id="newPassword" class="form-control" placeholder="Enter new password" minlength="6">
                        <div class="input-group-append">
                            <button class="btn btn-success" onclick="setUserPassword('@Model.Id')">Set Password</button>
                            <button class="btn btn-secondary" onclick="hideSetPasswordForm()">Cancel</button>
                        </div>
                    </div>
                </div>

                <!-- Password Display Area -->
                <div id="passwordDisplay" style="display: none; margin-top: 15px;">
                    <div class="alert alert-success">
                        <strong>New Password:</strong> <span id="generatedPassword"></span>
                        <button class="btn btn-sm btn-outline-success ml-2" onclick="copyPassword()">Copy</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function resetUserPassword(userId) {
        if (confirm('Are you sure you want to reset this user\'s password?')) {
            $.post('/Admin/ResetUserPassword', { userId: userId }, function(response) {
                if (response.success) {
                    $('#generatedPassword').text(response.newPassword);
                    $('#passwordDisplay').show();
                    alert('Password reset successfully!');
                } else {
                    alert('Error: ' + response.message);
                }
            });
        }
    }

    function showSetPasswordForm(userId) {
        $('#setPasswordForm').show();
        $('#passwordDisplay').hide();
    }

    function hideSetPasswordForm() {
        $('#setPasswordForm').hide();
        $('#newPassword').val('');
    }

    function setUserPassword(userId) {
        var newPassword = $('#newPassword').val();
        if (newPassword.length < 6) {
            alert('Password must be at least 6 characters long');
            return;
        }

        $.post('/Admin/SetUserPassword', { userId: userId, newPassword: newPassword }, function(response) {
            if (response.success) {
                alert('Password updated successfully!');
                hideSetPasswordForm();
            } else {
                alert('Error: ' + response.message);
            }
        });
    }

    function copyPassword() {
        var password = $('#generatedPassword').text();
        navigator.clipboard.writeText(password).then(function() {
            alert('Password copied to clipboard!');
        });
    }
</script>