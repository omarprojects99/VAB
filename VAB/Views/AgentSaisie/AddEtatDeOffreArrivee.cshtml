@model VAB.ViewModel.EtatDesOffresArriveeViewModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager
@{
    Layout = null;
}

<div class="offers-form-modal" style="max-height: 70vh; overflow-y: auto;">
    <form asp-action="AddEtatDesOffresArrivee" asp-controller="AgentSaisie" method="post" id="salesForm">
        @Html.AntiForgeryToken()
        @{

            var currentUser = await UserManager.GetUserAsync(Context.User);
            var agentName = currentUser?.NomPrenom ?? "Unknown";
        }
        <div class="header-section">
            <h3 class="company-title">TUNISAIR</h3>
            <div class="location-info">VAB TUNIS<br>Carthage</div>
            <div class="form-group">
                <label asp-for="DateEdition"></label>
                <input asp-for="DateEdition" type="datetime-local" class="form-control" />
                <span asp-validation-for="DateEdition" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="AgentSaisie">Agent Saisie</label>
                <input type="text" class="form-control" id="AgentSaisie" value="@agentName" readonly />
            </div>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p>@error.ErrorMessage</p>
                    }
                </div>
            }
            @if (ViewBag.Success != null && (bool)ViewBag.Success)
            {
                <input type="hidden" id="formSuccess" value="true" />
            }
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            }
        </div>

        <h3 class="form-title">ETAT DES OFFRES ARRIVEE N° <input asp-for="Numero" class="form-control d-inline-block w-auto" required /></h3>
        <span asp-validation-for="Numero" class="text-danger"></span>
        <div class="action-buttons">
            <button type="button" class="add-row-btn" onclick="addArticleRow()">Ajouter Article</button>
        </div>

        <div class="table-responsive">
            <table id="article-table" class="modern-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Description</th>
                        <th>Quantité Dotation</th>
                        <th>Quantité Compl.</th>
                        <th>Tot Em</th>
                        <th>Quantité Casse</th>
                        <th>Quantité Offerte</th>
                        <th>Retour Consig</th>
                        <th>Déficite</th>
                        <th>Restant</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="article-tbody">
                    @{
                        var groupedArticles = Model.ArticleOffres
                        .GroupBy(ao => ao.CategorieId)
                        .OrderBy(g => g.First().CategorieDescription);
                        int articleIndex = 0;
                    }
                    @foreach (var group in groupedArticles)
                    {
                        var categorie = group.First();
                        <tr class="category-row" data-categorie-id="@categorie.CategorieId">
                            <td colspan="11">
                                <span class="category-name">@categorie.CategorieDescription</span>
                            </td>
                        </tr>
                        foreach (var article in group)
                        {
                            <tr class="article-row">
                                <td>
                                    <input type="hidden" name="ArticleOffres[@articleIndex].ArticleId" value="@article.ArticleId" />
                                    <input type="hidden" name="ArticleOffres[@articleIndex].CategorieId" value="@article.CategorieId" />
                                    <input type="number" name="ArticleOffres[@articleIndex].IdArticle" class="small-input form-control id-article" value="@article.IdArticle" onchange="fetchArticleDetails(this, @articleIndex)" required />
                                    <span class="error-message text-danger"></span>
                                </td>
                                <td><input type="text" name="ArticleOffres[@articleIndex].Description" class="form-control article-description" value="@article.Description" readonly /></td>
                                <td><input type="number" name="ArticleOffres[@articleIndex].QuantiteDotation" class="small-input form-control quantity-input" min="0" value="@article.QuantiteDotation" onchange="updateRow(this)" /></td>
                                <td><input type="number" name="ArticleOffres[@articleIndex].QuantiteComplementaire" class="small-input form-control quantity-input" min="0" value="@article.QuantiteComplementaire" onchange="updateRow(this)" /></td>
                                <td><input type="number" name="ArticleOffres[@articleIndex].TotalEmbarque" class="small-input form-control" value="@article.TotalEmbarque" readonly /></td>
                                <td><input type="number" name="ArticleOffres[@articleIndex].QuantiteCasse" class="small-input form-control quantity-input" min="0" value="@article.QuantiteCasse" onchange="updateRow(this)" /></td>
                                <td><input type="number" name="ArticleOffres[@articleIndex].QuantiteOffert" class="small-input form-control quantity-input" min="0" value="@article.QuantiteOffert" onchange="updateRow(this)" /></td>
                                <td><input type="number" name="ArticleOffres[@articleIndex].RetourConsig" class="small-input form-control quantity-input" min="0" value="@article.RetourConsig" onchange="updateRow(this)" /></td>
                                <td><input type="number" name="ArticleOffres[@articleIndex].Deficite" class="small-input form-control" value="@article.Deficite" readonly /></td>
                                <td><input type="number" name="ArticleOffres[@articleIndex].Restant" class="form-control" value="@article.Restant" readonly /></td>
                                <td><button type="button" class="delete-row-btn" onclick="deleteArticleRow(this)">X</button></td>
                            </tr>
                            articleIndex++;
                        }
                        <tr class="category-summary-row" data-categorie-id="@categorie.CategorieId">
                            <td>Total</td>
                            <td>@categorie.CategorieDescription</td>
                            <td><input type="number" class="category-total-input form-control" readonly /></td>
                            <td><input type="number" class="category-total-input form-control" readonly /></td>
                            <td><input type="number" class="category-total-input form-control" readonly /></td>
                            <td><input type="number" class="category-total-input form-control" readonly /></td>
                            <td><input type="number" class="category-total-input form-control" readonly /></td>
                            <td><input type="number" class="category-total-input form-control" readonly /></td>
                            <td><input type="number" class="category-total-input form-control" readonly /></td>
                            <td><input type="number" class="category-total-input form-control" readonly /></td>
                            <td></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<style>
    .offers-form-modal {
        font-family: 'Segoe UI', Arial, sans-serif;
        font-size: 13px;
        padding: 20px;
        background-color: #f9f9f9;
        color: #333;
    }

    .header-section {
        margin-bottom: 20px;
        position: relative;
    }

    .company-title {
        color: #600000;
        font-weight: bold;
        margin-bottom: 5px;
        font-size: 22px;
    }

    .location-info {
        color: #555;
        margin-bottom: 15px;
        font-style: italic;
    }

    .form-title {
        text-align: center;
        color: #600000;
        font-weight: bold;
        margin: 20px 0;
        padding-bottom: 10px;
        border-bottom: 2px solid #600000;
    }

    .action-buttons {
        margin: 20px 0;
        display: flex;
        gap: 10px;
    }

    .offers-form-modal .form-group {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin: 8px 0;
    }

        .offers-form-modal .form-group label {
            margin: 0;
            font-weight: 500;
        }

    .offers-form-modal .form-control {
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 5px 8px;
        font-size: 13px;
        transition: border-color 0.2s;
    }

        .offers-form-modal .form-control:focus {
            border-color: #600000;
            box-shadow: 0 0 0 0.2rem rgba(96, 0, 0, 0.25);
            outline: none;
        }

    .modern-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
        background-color: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

        .modern-table th {
            background-color: #600000;
            color: white;
            padding: 8px;
            text-align: center;
            font-size: 13px;
            font-weight: 500;
        }

        .modern-table td {
            border: 1px solid #eee;
            padding: 6px;
            text-align: center;
            font-size: 13px;
        }

    .offers-form-modal .small-input {
        width: 95%;
    }

    .offers-form-modal .add-row-btn {
        margin: 0;
        padding: 8px 15px;
        font-size: 13px;
        cursor: pointer;
        background-color: #600000;
        color: white;
        border: none;
        border-radius: 4px;
        transition: background-color 0.2s;
    }

        .offers-form-modal .add-row-btn:hover {
            background-color: #400000;
        }

    .offers-form-modal .delete-row-btn {
        padding: 3px 8px;
        font-size: 11px;
        color: white;
        background-color: #600000;
        border: none;
        border-radius: 3px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .offers-form-modal .delete-row-btn:hover {
            background-color: #400000;
        }

    .offers-form-modal .category-row {
        background-color: #f5f5f5;
        font-weight: bold;
    }

    .offers-form-modal .category-summary-row {
        background-color: #eee;
        font-weight: bold;
    }

        .offers-form-modal .category-row td,
        .offers-form-modal .category-summary-row td {
            text-align: left !important;
        }

    .offers-form-modal .article-row {
        background-color: #ffffff;
    }

        .offers-form-modal .article-row.invalid {
            background-color: #ffe6e6;
        }

    .offers-form-modal .error-message {
        display: block;
        font-size: 12px;
        margin-top: 2px;
    }

    .offers-form-modal .category-name {
        width: 120px;
        border: 1px solid #ddd;
        padding: 5px;
        border-radius: 4px;
    }

    .offers-form-modal .category-total-input {
        width: 60px;
        font-weight: bold;
    }

    .table-responsive {
        margin-top: 20px;
        background-color: white;
        padding: 15px;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        overflow-x: auto;
        border-left: 3px solid #600000;
    }

    .offers-form-modal .alert-danger {
        margin-top: 10px;
        padding: 10px;
        font-size: 13px;
    }

    .offers-form-modal .text-danger {
        display: block;
        margin-top: 5px;
        font-size: 12px;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
    }

    .btn-primary {
        background-color: #600000;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .btn-primary:hover {
            background-color: #400000;
        }
</style>

<script>
    let articleIndex = @(Model.ArticleOffres?.Count ?? 0);

    function addArticleRow() {
        const tbody = document.getElementById('article-tbody');
        const row = document.createElement('tr');
        row.className = 'article-row';
        row.innerHTML = `
            <td>
                <input type="hidden" name="ArticleOffres[${articleIndex}].ArticleId" value="0" />
                <input type="hidden" name="ArticleOffres[${articleIndex}].CategorieId" value="0" />
                <input type="number" name="ArticleOffres[${articleIndex}].IdArticle" class="small-input form-control id-article" onchange="fetchArticleDetails(this, ${articleIndex})" required />
                <span class="error-message text-danger"></span>
            </td>
            <td><input type="text" name="ArticleOffres[${articleIndex}].Description" class="form-control article-description" readonly /></td>
            <td><input type="number" name="ArticleOffres[${articleIndex}].QuantiteDotation" class="small-input form-control quantity-input" min="0" onchange="updateRow(this)" /></td>
            <td><input type="number" name="ArticleOffres[${articleIndex}].QuantiteComplementaire" class="small-input form-control quantity-input" min="0" onchange="updateRow(this)" /></td>
            <td><input type="number" name="ArticleOffres[${articleIndex}].TotalEmbarque" class="small-input form-control" readonly /></td>
            <td><input type="number" name="ArticleOffres[${articleIndex}].QuantiteCasse" class="small-input form-control quantity-input" min="0" onchange="updateRow(this)" /></td>
            <td><input type="number" name="ArticleOffres[${articleIndex}].QuantiteOffert" class="small-input form-control quantity-input" min="0" onchange="updateRow(this)" /></td>
            <td><input type="number" name="ArticleOffres[${articleIndex}].RetourConsig" class="small-input form-control quantity-input" min="0" onchange="updateRow(this)" /></td>
            <td><input type="number" name="ArticleOffres[${articleIndex}].Deficite" class="small-input form-control" readonly /></td>
            <td><input type="number" name="ArticleOffres[${articleIndex}].Restant" class="form-control" readonly /></td>
            <td><button type="button" class="delete-row-btn" onclick="deleteArticleRow(this)">X</button></td>
        `;
        tbody.appendChild(row);
        articleIndex++;
    }

    function fetchArticleDetails(input, index) {
        const idArticle = input.value;
        const row = input.closest('tr');
        const errorSpan = row.querySelector('.error-message') || document.createElement('span');
        errorSpan.className = 'error-message text-danger';
        row.querySelector('td').appendChild(errorSpan);

        if (!idArticle || idArticle <= 0) {
            errorSpan.textContent = 'Veuillez entrer un code article valide.';
            resetArticleRow(row, index);
            return;
        }

        fetch(`/AgentSaisie/GetArticleDetails?idArticle=${idArticle}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    errorSpan.textContent = '';
                    row.querySelector(`input[name="ArticleOffres[${index}].ArticleId"]`).value = data.article.id;
                    row.querySelector(`input[name="ArticleOffres[${index}].CategorieId"]`).value = data.article.categorieId;
                    row.querySelector(`input[name="ArticleOffres[${index}].Description"]`).value = data.article.description;
                    row.classList.remove('invalid');
                    updateCategoryGrouping(row, data.article.categorieId, data.article.categorieDescription);
                    updateRow(row.querySelector('.quantity-input'));
                } else {
                    errorSpan.textContent = data.message;
                    row.classList.add('invalid');
                    resetArticleRow(row, index);
                    Swal.fire(data.message);
                }
            })
            .catch(error => {
                errorSpan.textContent = 'Erreur lors de la récupération de l\'article.';
                row.classList.add('invalid');
                resetArticleRow(row, index);
                console.error('Error fetching article:', error);
                alert('Erreur lors de la récupération de l\'article.');
            });
    }

    function resetArticleRow(row, index) {
        row.querySelector(`input[name="ArticleOffres[${index}].ArticleId"]`).value = 0;
        row.querySelector(`input[name="ArticleOffres[${index}].CategorieId"]`).value = 0;
        row.querySelector(`input[name="ArticleOffres[${index}].Description"]`).value = '';
        row.querySelector(`input[name="ArticleOffres[${index}].QuantiteDotation"]`).value = '';
        row.querySelector(`input[name="ArticleOffres[${index}].QuantiteComplementaire"]`).value = '';
        row.querySelector(`input[name="ArticleOffres[${index}].QuantiteCasse"]`).value = '';
        row.querySelector(`input[name="ArticleOffres[${index}].QuantiteOffert"]`).value = '';
        row.querySelector(`input[name="ArticleOffres[${index}].RetourConsig"]`).value = '';
        row.querySelector(`input[name="ArticleOffres[${index}].Deficite"]`).value = '';
        row.querySelector(`input[name="ArticleOffres[${index}].Restant"]`).value = '';
        row.classList.add('invalid');
    }

    function updateCategoryGrouping(row, categorieId, categorieDescription) {
        const tbody = document.getElementById('article-tbody');
        let categoryRow = tbody.querySelector(`.category-row[data-categorie-id="${categorieId}"]`);
        let summaryRow = tbody.querySelector(`.category-summary-row[data-categorie-id="${categorieId}"]`);

        if (!categoryRow) {
            categoryRow = document.createElement('tr');
            categoryRow.className = 'category-row';
            categoryRow.dataset.categorieId = categorieId;
            categoryRow.innerHTML = `<td colspan="11"><span class="category-name">${categorieDescription || 'Unknown'}</span></td>`;
            tbody.insertBefore(categoryRow, row);

            summaryRow = document.createElement('tr');
            summaryRow.className = 'category-summary-row';
            summaryRow.dataset.categorieId = categorieId;
            summaryRow.innerHTML = `
                <td>Total</td>
                <td>${categorieDescription || 'Unknown'}</td>
                <td><input type="number" class="category-total-input form-control" readonly /></td>
                <td><input type="number" class="category-total-input form-control" readonly /></td>
                <td><input type="number" class="category-total-input form-control" readonly /></td>
                <td><input type="number" class="category-total-input form-control" readonly /></td>
                <td><input type="number" class="category-total-input form-control" readonly /></td>
                <td><input type="number" class="category-total-input form-control" readonly /></td>
                <td><input type="number" class="category-total-input form-control" readonly /></td>
                <td><input type="number" class="category-total-input form-control" readonly /></td>
                <td></td>
            `;
            tbody.insertBefore(summaryRow, row.nextSibling);
        } else {
            const categoryNameSpan = categoryRow.querySelector('.category-name');
            if (categoryNameSpan && (!categoryNameSpan.textContent || categoryNameSpan.textContent === 'Unknown')) {
                categoryNameSpan.textContent = categorieDescription || 'Unknown';
            }
            const summaryCategoryCell = summaryRow.querySelector('td:nth-child(2)');
            if (summaryCategoryCell && (!summaryCategoryCell.textContent || summaryCategoryCell.textContent === 'Unknown')) {
                summaryCategoryCell.textContent = categorieDescription || 'Unknown';
            }
        }

        let nextRow = categoryRow.nextElementSibling;
        while (nextRow && (nextRow.className.includes('article-row') || nextRow.className.includes('category-summary-row'))) {
            if (nextRow.className.includes('category-summary-row')) {
                tbody.insertBefore(row, nextRow);
                break;
            }
            nextRow = nextRow.nextElementSibling;
        }
        updateCategorySummary(categorieId);
    }

    function updateRow(input) {
        const row = input.closest('tr');
        if (row.classList.contains('invalid')) return;

        const dotation = parseInt(row.querySelector('input[name$=".QuantiteDotation"]').value) || 0;
        const complementaire = parseInt(row.querySelector('input[name$=".QuantiteComplementaire"]').value) || 0;
        const casse = parseInt(row.querySelector('input[name$=".QuantiteCasse"]').value) || 0;
        const offert = parseInt(row.querySelector('input[name$=".QuantiteOffert"]').value) || 0;
        const retourConsig = parseInt(row.querySelector('input[name$=".RetourConsig"]').value) || 0;

        const totalEmbarque = dotation + complementaire;
        const deficite = totalEmbarque - (casse + offert + retourConsig);
        const restant = totalEmbarque - casse - offert;

        row.querySelector('input[name$=".TotalEmbarque"]').value = totalEmbarque;
        row.querySelector('input[name$=".Deficite"]').value = deficite;
        row.querySelector('input[name$=".Restant"]').value = restant;

        const categorieId = row.querySelector('input[name$=".CategorieId"]').value;
        updateCategorySummary(categorieId);
    }

    function updateCategorySummary(categorieId) {
        const summaryRow = document.querySelector(`.category-summary-row[data-categorie-id="${categorieId}"]`);
        if (!summaryRow) return;

        const rows = Array.from(document.querySelectorAll('.article-row')).filter(row => {
            return row.querySelector(`input[name$=".CategorieId"]`).value == categorieId && !row.classList.contains('invalid');
        });

        let totalDotation = 0, totalComplementaire = 0, totalEmbarque = 0, totalCasse = 0, totalOffert = 0, totalRetourConsig = 0, totalDeficite = 0, totalRestant = 0;
        rows.forEach(row => {
            totalDotation += parseInt(row.querySelector('input[name$=".QuantiteDotation"]').value) || 0;
            totalComplementaire += parseInt(row.querySelector('input[name$=".QuantiteComplementaire"]').value) || 0;
            totalEmbarque += parseInt(row.querySelector('input[name$=".TotalEmbarque"]').value) || 0;
            totalCasse += parseInt(row.querySelector('input[name$=".QuantiteCasse"]').value) || 0;
            totalOffert += parseInt(row.querySelector('input[name$=".QuantiteOffert"]').value) || 0;
            totalRetourConsig += parseInt(row.querySelector('input[name$=".RetourConsig"]').value) || 0;
            totalDeficite += parseInt(row.querySelector('input[name$=".Deficite"]').value) || 0;
            totalRestant += parseInt(row.querySelector('input[name$=".Restant"]').value) || 0;
        });

        const inputs = summaryRow.querySelectorAll('.category-total-input');
        inputs[0].value = totalDotation;
        inputs[1].value = totalComplementaire;
        inputs[2].value = totalEmbarque;
        inputs[3].value = totalCasse;
        inputs[4].value = totalOffert;
        inputs[5].value = totalRetourConsig;
        inputs[6].value = totalDeficite;
        inputs[7].value = totalRestant;
    }

    function deleteArticleRow(button) {
        const row = button.closest('tr');
        const categorieId = row.querySelector('input[name$=".CategorieId"]').value;
        row.remove();

        const remainingRows = Array.from(document.querySelectorAll('.article-row')).filter(r => {
            return r.querySelector(`input[name$=".CategorieId"]`).value == categorieId;
        });
        if (remainingRows.length === 0) {
            const categoryRow = document.querySelector(`.category-row[data-categorie-id="${categorieId}"]`);
            const summaryRow = document.querySelector(`.category-summary-row[data-categorie-id="${categorieId}"]`);
            categoryRow?.remove();
            summaryRow?.remove();
        }

        updateCategorySummary(categorieId);
        reindexArticles();
    }

    function reindexArticles() {
        const rows = document.querySelectorAll('#article-tbody .article-row');
        articleIndex = rows.length;
        rows.forEach((row, index) => {
            const inputs = row.querySelectorAll('input');
            inputs.forEach(input => {
                const name = input.name.replace(/ArticleOffres\[\d+\]/, `ArticleOffres[${index}]`);
                input.name = name;
            });
            const idArticleInput = row.querySelector('.id-article');
            idArticleInput.setAttribute('onchange', `fetchArticleDetails(this, ${index})`);
        });
    }

    document.getElementById('salesForm').addEventListener('submit', function (event) {
        const invalidRows = document.querySelectorAll('.article-row.invalid');
        if (invalidRows.length > 0) {
            event.preventDefault();
            alert('Veuillez corriger les articles invalides avant de soumettre le formulaire.');
            return;
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}