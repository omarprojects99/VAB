@model VAB.ViewModel.EtatDesOffresDepartViewModel
@using VAB.ViewModel
@{
    Layout = null;
}

<div class="offers-form-modal" style="max-height: 70vh; overflow-y: auto;">
    <form asp-action="AddEtatDesOffresDepart" asp-controller="AgentSaisie" method="post" id="salesForm">
        @Html.AntiForgeryToken()
        <div class="header-section">
            <h3 class="company-title">TUNISAIR</h3>
            <div class="location-info">VAB TUNIS<br>Carthage</div>
            <div class="form-group">
                <label asp-for="DateEdition"></label>
                <input asp-for="DateEdition" type="datetime-local" class="form-control" />
                <span asp-validation-for="DateEdition" class="text-danger"></span>
            </div>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p>@error.ErrorMessage</p>
                    }
                </div>
            }
            @if (ViewBag.Success != null && (bool)ViewBag.Success)
            {
                <input type="hidden" id="formSuccess" value="true" />
            }
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
            }
        </div>

        <h3 class="form-title">ETAT DES OFFRES DEPART N° <input asp-for="Numero" class="form-control d-inline-block w-auto" required /></h3>
        <span asp-validation-for="Numero" class="text-danger"></span>
        <div class="action-buttons">
            <button type="button" class="add-row-btn" onclick="addArticleRow()">Ajouter Article</button>
            
        </div>

        <div class="table-responsive">
            <table id="article-table" class="modern-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Description</th>
                        <th>Quantité Dotation</th>
                        <th>Quantité Compl.</th>
                        <th>Tot Em</th>
                        <th>Quantité Casse</th>
                        <th>Quantité Offerte</th>
                        <th>Retour Consig</th>
                        <th>Déficite</th>
                        <th>Restant</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="article-tbody">
                    @{
                        var groupedArticles = Model.ArticleOffreDepart
                        ?.GroupBy(ao => ao.CategorieId)
                        .OrderBy(g => g.FirstOrDefault()?.CategorieDescription ?? "")
                        ?? Enumerable.Empty<IGrouping<int, ArticleOffreDepartViewModel>>();
                        int articleIndex = 0;
                    }
                    @foreach (var group in groupedArticles)
                    {
                        var categorie = group.FirstOrDefault();
                        if (categorie != null)
                        {
                            <tr class="category-row" data-categorie-id="@categorie.CategorieId">
                                <td colspan="11">
                                    <span class="category-name">@categorie.CategorieDescription</span>
                                </td>
                            </tr>
                            foreach (var article in group)
                            {
                                <tr class="article-row">
                                    <td>
                                        <input type="hidden" name="ArticleOffreDepart[@articleIndex].ArticleId" value="@article.ArticleId" />
                                        <input type="hidden" name="ArticleOffreDepart[@articleIndex].CategorieId" value="@article.CategorieId" />
                                        <input type="number" name="ArticleOffreDepart[@articleIndex].IdArticle" class="small-input form-control id-article" value="@article.IdArticle" onchange="fetchArticleDetails(this, @articleIndex)" required />
                                        <span class="error-message text-danger"></span>
                                    </td>
                                    <td><input type="text" name="ArticleOffreDepart[@articleIndex].Description" class="form-control article-description" value="@article.Description" readonly /></td>
                                    <td><input type="number" name="ArticleOffreDepart[@articleIndex].QuantiteDotation" class="small-input form-control quantity-input" min="0" value="@article.QuantiteDotation" onchange="updateRow(this)" /></td>
                                    <td><input type="number" name="ArticleOffreDepart[@articleIndex].QuantiteComplementaire" class="small-input form-control quantity-input" min="0" value="@article.QuantiteComplementaire" onchange="updateRow(this)" /></td>
                                    <td><input type="number" class="small-input form-control" value="@article.TotalEmbarque" readonly /></td>
                                    <td><input type="number" name="ArticleOffreDepart[@articleIndex].QuantiteCasse" class="small-input form-control quantity-input" min="0" value="@article.QuantiteCasse" onchange="updateRow(this)" /></td>
                                    <td><input type="number" name="ArticleOffreDepart[@articleIndex].QuantiteOffert" class="small-input form-control quantity-input" min="0" value="@article.QuantiteOffert" onchange="updateRow(this)" /></td>
                                    <td><input type="number" name="ArticleOffreDepart[@articleIndex].RetourConsig" class="small-input form-control quantity-input" min="0" value="@article.RetourConsig" onchange="updateRow(this)" /></td>
                                    <td><input type="number" class="small-input form-control" value="@article.Deficite" readonly /></td>
                                    <td><input type="number" class="form-control" value="@article.Restant" readonly /></td>
                                    <td><button type="button" class="delete-row-btn" onclick="deleteArticleRow(this)">X</button></td>
                                </tr>
                                articleIndex++;
                            }
                            <tr class="category-summary-row" data-categorie-id="@categorie.CategorieId">
                                <td>Total</td>
                                <td>@categorie.CategorieDescription</td>
                                <td><input type="number" class="category-total-input form-control" readonly /></td>
                                <td><input type="number" class="category-total-input form-control" readonly /></td>
                                <td><input type="number" class="category-total-input form-control" readonly /></td>
                                <td><input type="number" class="category-total-input form-control" readonly /></td>
                                <td><input type="number" class="category-total-input form-control" readonly /></td>
                                <td><input type="number" class="category-total-input form-control" readonly /></td>
                                <td><input type="number" class="category-total-input form-control" readonly /></td>
                                <td><input type="number" class="category-total-input form-control" readonly /></td>
                                <td></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

<style>
    .offers-form-modal {
        font-family: 'Segoe UI', Arial, sans-serif;
        font-size: 13px;
        padding: 20px;
        background-color: #f9f9f9;
        color: #333;
    }

    .header-section {
        margin-bottom: 20px;
        position: relative;
    }

    .company-title {
        color: #600000;
        font-weight: bold;
        margin-bottom: 5px;
        font-size: 22px;
    }

    .location-info {
        color: #555;
        margin-bottom: 15px;
        font-style: italic;
    }

    .form-title {
        text-align: center;
        color: #600000;
        font-weight: bold;
        margin: 20px 0;
        padding-bottom: 10px;
        border-bottom: 2px solid #600000;
    }

    .action-buttons {
        margin: 20px 0;
        display: flex;
        gap: 10px;
    }

    .offers-form-modal .form-group {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin: 8px 0;
    }

        .offers-form-modal .form-group label {
            margin: 0;
            font-weight: 500;
        }

    .offers-form-modal .form-control {
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 5px 8px;
        font-size: 13px;
        transition: border-color 0.2s;
    }

        .offers-form-modal .form-control:focus {
            border-color: #600000;
            box-shadow: 0 0 0 0.2rem rgba(96, 0, 0, 0.25);
            outline: none;
        }

    .modern-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
        background-color: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

        .modern-table th {
            background-color: #600000;
            color: white;
            padding: 8px;
            text-align: center;
            font-size: 13px;
            font-weight: 500;
        }

        .modern-table td {
            border: 1px solid #eee;
            padding: 6px;
            text-align: center;
            font-size: 13px;
        }

    .offers-form-modal .small-input {
        width: 95%;
    }

    .offers-form-modal .add-row-btn,
    .offers-form-modal .btn-primary {
        margin: 0;
        padding: 8px 15px;
        font-size: 13px;
        cursor: pointer;
        background-color: #600000;
        color: white;
        border: none;
        border-radius: 4px;
        transition: background-color 0.2s;
    }

        .offers-form-modal .add-row-btn:hover,
        .offers-form-modal .btn-primary:hover {
            background-color: #400000;
        }

    .offers-form-modal .delete-row-btn {
        padding: 3px 8px;
        font-size: 11px;
        color: white;
        background-color: #600000;
        border: none;
        border-radius: 3px;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .offers-form-modal .delete-row-btn:hover {
            background-color: #400000;
        }

    .offers-form-modal .category-row {
        background-color: #f5f5f5;
        font-weight: bold;
    }

    .offers-form-modal .category-summary-row {
        background-color: #eee;
        font-weight: bold;
    }

        .offers-form-modal .category-row td,
        .offers-form-modal .category-summary-row td {
            text-align: left !important;
        }

    .offers-form-modal .article-row {
        background-color: #ffffff;
    }

        .offers-form-modal .article-row.invalid {
            background-color: #ffe6e6;
        }

    .offers-form-modal .error-message {
        display: block;
