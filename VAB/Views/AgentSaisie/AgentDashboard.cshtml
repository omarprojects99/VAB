@model dynamic
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject Microsoft.AspNetCore.Identity.UserManager<VAB.Models.User> UserManager
@inject VAB.Data.ApplicationDbContext Context
@{
    ViewData["Title"] = "Tableau de bord - Agent Saisie";
    Layout = null;
    var userId = UserManager.GetUserId(User);
    var notifications = await Context.Notifications
        .Where(n => n.UserId == userId)
        .OrderByDescending(n => n.CreatedAt)
        .Take(10)
        .ToListAsync();
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Tableau de bord pour les agents de saisie">
    <title>@ViewData["Title"]</title>

    <!-- Favicon -->
    <link rel="shortcut icon" href="~/images/icons/favicon.png" type="image/png">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Nunito&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet" href="~/iconfont/material-icons.css">

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/css/Chart.min.css">
    <link rel="stylesheet" href="~/css/animate.css">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/sidebar.css">
    <link rel="stylesheet" href="~/css/responsive.css">

    <style>
        /* Improved Notification dropdown styles */
        .notification-dropdown {
            position: relative;
        }

            .notification-dropdown .dropdown-menu {
                width: 380px;
                max-width: 95vw;
                z-index: 1050;
                border: none;
                box-shadow: 0 4px 20px rgba(0,0,0,0.15);
                border-radius: 8px;
                padding: 0;
                margin-top: 5px;
                /* Ensure proper positioning */
                right: 0 !important;
                left: auto !important;
                transform: none !important;
            }

        .notification-header {
            background: #f8f9fa;
            padding: 12px 16px;
            border-bottom: 1px solid #dee2e6;
            border-radius: 8px 8px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .notification-list-container {
            max-height: 280px;
            overflow-y: auto;
            padding: 0;
        }

        .notification-item {
            white-space: normal;
            padding: 12px 16px;
            border-bottom: 1px solid #eee;
            font-size: 0.875rem;
            line-height: 1.4;
            transition: background-color 0.2s;
            cursor: pointer;
            display: block;
        }

            .notification-item:hover {
                background-color: #f8f9fa;
            }

            .notification-item.unread {
                font-weight: 500;
                background-color: #e3f2fd;
                border-left: 3px solid #2196f3;
            }

            .notification-item:last-child {
                border-bottom: none;
            }

        .notification-badge {
            position: absolute;
            top: -2px;
            right: -2px;
            font-size: 0.65em;
            min-width: 16px;
            height: 16px;
            line-height: 16px;
            text-align: center;
            border-radius: 50%;
        }

        .notification-footer {
            background: #f8f9fa;
            padding: 10px 16px;
            border-top: 1px solid #dee2e6;
            border-radius: 0 0 8px 8px;
            text-align: center;
        }

        /* Improved User dropdown styles */
        .user-dropdown .dropdown-menu {
            min-width: 200px;
            z-index: 1050;
            border: none;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            border-radius: 8px;
            padding: 8px 0;
            margin-top: 5px;
            /* Ensure proper positioning */
            right: 0 !important;
            left: auto !important;
            transform: none !important;
        }

        .user-dropdown .dropdown-item {
            padding: 10px 16px;
            font-size: 0.875rem;
            transition: background-color 0.2s;
            display: flex;
            align-items: center;
        }

            .user-dropdown .dropdown-item i {
                margin-right: 8px;
                font-size: 18px;
                width: 20px;
            }

            .user-dropdown .dropdown-item:hover {
                background-color: #f8f9fa;
            }

        .user-dropdown .dropdown-divider {
            margin: 4px 0;
        }

        /* Toast notification */
        .toast-notification {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 1060;
            min-width: 300px;
            max-width: 90%;
        }

        /* Dashboard cards */
        .dashboard-card {
            transition: transform 0.3s, box-shadow 0.3s;
        }

            .dashboard-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            }

        .card-body-icon i {
            opacity: 0.3;
            font-size: 4rem;
            position: absolute;
            right: 20px;
            top: 20px;
        }

        /* Chart container */
        .chart-container {
            position: relative;
            height: 400px;
        }

        /* Custom scrollbar for notification list */
        .notification-list-container::-webkit-scrollbar {
            width: 6px;
        }

        .notification-list-container::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .notification-list-container::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 3px;
        }

            .notification-list-container::-webkit-scrollbar-thumb:hover {
                background: #a8a8a8;
            }

        /* Mobile adjustments */
        @@media (max-width: 768px) {
            .dashboard-card

        {
            margin-bottom: 15px;
        }

        .notification-dropdown .dropdown-menu {
            width: 320px;
            right: -50px !important;
        }

        .user-dropdown .dropdown-menu {
            right: -20px !important;
        }

        }

        @@media (max-width: 480px) {
            .notification-dropdown .dropdown-menu

        {
            width: 280px;
            right: -80px !important;
        }

        .user-dropdown .dropdown-menu {
            right: -50px !important;
        }

        }

        /* Fix for navbar dropdown positioning */
        .navbar-nav .dropdown-menu {
            position: absolute !important;
        }

        /* Ensure dropdown stays within viewport */
        .dropdown-menu-end {
            --bs-position: end;
        }

        /* Fix for user photo alignment */
        .user-photo img {
            object-fit: cover;
        }

        /* Notification count styling */
        .notification-count {
            color: #6c757d;
            font-size: 0.75rem;
            margin-left: auto;
        }
    </style>
</head>
<body>
    <!-- Loading spinner -->
    <div class="spinner_body">
        <div class="spinner"></div>
    </div>

    <!-- Toast notification -->
    <div id="notificationToast" class="toast toast-notification hide" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-primary text-white">
            <strong class="me-auto">Notification</strong>
            <small class="text-white">à l'instant</small>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body"></div>
    </div>

    <!-- Header -->
    <header>
        <div class="header">
            <div class="navigation">
                <nav class="navbar navbar-expand-lg navbar-bg">
                    <!-- Brand logo -->
                    <div class="brand-logo">
                        <a class="navbar-brand" asp-controller="AgentSaisie" asp-action="AgentDashboard" id="menu-action">
                            <div class="logo-tunisair">
                                <img src="~/images/icons/Tunisair-Logo-Vector.svg-.png" alt="Tunisair Logo">
                            </div>
                        </a>
                        <div id="nav-toggle">
                            <div class="cta">
                                <div class="toggle-btn type1"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Mobile toggle -->
                    <div class="for-mobile d-mobile">
                        <div class="toggle-button" id="toggle-button">
                            <span class="material-icons">menu</span>
                        </div>
                    </div>

                    <!-- Navigation content -->
                    <div class="collapse navbar-collapse pr-3" id="navbarContent">
                        <ul class="navbar-nav user-info ml-auto mt-2 mt-lg-0">
                            <!-- Notifications dropdown -->
                            <li class="nav-item dropdown notification-dropdown">
                                <a href="#" class="navbar-nav-link dropdown-toggle text-light" data-bs-toggle="dropdown" id="notificationDropdown" aria-expanded="false">
                                    <i class="material-icons">notifications</i>
                                    <span id="notificationBadge" class="badge bg-danger notification-badge" style="display: none;">0</span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <div class="notification-header">
                                        <h6 class="mb-0 fw-semibold">Notifications</h6>
                                        <button id="clearNotifications" class="btn btn-sm btn-outline-danger">Effacer</button>
                                    </div>
                                    <div id="notificationList" class="notification-list-container">
                                        @if (notifications.Any())
                                        {
                                            @foreach (var item in notifications)
                                            {
                                                <div class="notification-item @(!item.IsRead ? "unread" : "")" data-id="@item.Id">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div class="flex-grow-1">@item.Name</div>
                                                        <small class="text-muted ms-2">@item.CreatedAt.ToString("HH:mm")</small>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="notification-item text-muted text-center py-3">
                                                <i class="material-icons mb-2" style="font-size: 2rem; opacity: 0.5;">notifications_none</i>
                                                <div>Aucune notification</div>
                                            </div>
                                        }
                                    </div>
                                    <div class="notification-footer">
                                        <a href="#" class="text-primary text-decoration-none">
                                            <small>Voir toutes les notifications</small>
                                        </a>
                                    </div>
                                </div>
                            </li>

                            <!-- User profile dropdown -->
                            <li class="nav-item dropdown user-dropdown">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <a href="#" class="navbar-nav-link dropdown-toggle text-light" data-bs-toggle="dropdown" aria-expanded="false">
                                        <div class="user-photo">
                                            <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" alt="User profile" class="rounded-circle" width="32" height="32">
                                        </div>
                                        <span class="d-none d-md-inline ms-2">@User.Identity.Name</span>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <div class="px-3 py-2 border-bottom">
                                            <div class="d-flex align-items-center">
                                                <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" alt="User profile" class="rounded-circle me-2" width="40" height="40">
                                                <div>
                                                    <div class="fw-semibold">@User.Identity.Name</div>
                                                    <small class="text-muted">Agent de Saisie</small>
                                                </div>
                                            </div>
                                        </div>
                                        <a asp-controller="AgentSaisie" asp-action="AgentAccountSettings" class="dropdown-item">
                                            <i class="material-icons">settings</i>
                                            Paramètres du compte
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="material-icons">logout</i>
                                            Déconnexion
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Connexion</a>
                                }
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>

            <!-- Mobile user menu -->
            <div class="toggle-user-menu" id="toggle-user-menu">
                <ul>
                    <li>
                        <a href="#">
                            <div class="user-photo">
                                <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" alt="User profile">
                            </div>
                            @User.Identity.Name
                        </a>
                    </li>
                    <li>
                        <a asp-controller="AgentSaisie" asp-action="AgentAccountSettings">
                            <i class="material-icons mr-2">settings</i> Paramètres du compte
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Account" asp-action="Logout">
                            <i class="material-icons mr-2">logout</i> Déconnexion
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Sidebar -->
    <section id="left-sidebar-area">
        <div id="left-sidebar-section">
            <aside>
                <div class="left-sidebar" id="wrapper-sidebar">
                    <ul>
                        <li class="active">
                            <a asp-controller="AgentSaisie" asp-action="AgentDashboard">
                                <i class="material-icons">dashboard</i> Tableau de Bord
                            </a>
                        </li>

                        <!-- Sales states dropdown -->
                        <li>
                            <a data-bs-toggle="collapse" class="dropdown-item-list" href="#etatDesVentesDropdown">
                                <i class="material-icons">receipt</i> Gérer États des Ventes
                                <span class="collapsed float-right"><i class="material-icons">add</i></span>
                                <span class="expanded float-right"><i class="material-icons">remove</i></span>
                            </a>
                            <div id="etatDesVentesDropdown" class="panel-collapse collapse">
                                <div class="sub-dropdown">
                                    <ul class="sub-list">
                                        <li>
                                            <a asp-controller="AgentSaisie" asp-action="EtatDesVentesDepart">
                                                <i class="material-icons">flight_takeoff</i> État des Ventes Départ
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-controller="AgentSaisie" asp-action="EtatDesVentesArrivee">
                                                <i class="material-icons">flight_land</i> État des Ventes Arrivée
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </li>

                        <!-- Offers states dropdown -->
                        <li>
                            <a data-bs-toggle="collapse" class="dropdown-item-list" href="#etatDesOffresDropdown">
                                <i class="material-icons">local_offer</i> Gérer États des Offres
                                <span class="collapsed float-right"><i class="material-icons">add</i></span>
                                <span class="expanded float-right"><i class="material-icons">remove</i></span>
                            </a>
                            <div id="etatDesOffresDropdown" class="panel-collapse collapse">
                                <div class="sub-dropdown">
                                    <ul class="sub-list">
                                        <li>
                                            <a asp-controller="AgentSaisie" asp-action="EtatDesOffresDepart">
                                                <i class="material-icons">flight_takeoff</i> État des Offres Départ
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-controller="AgentSaisie" asp-action="EtatDesOffresArrivee">
                                                <i class="material-icons">flight_land</i> État des Offres Arrivée
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </li>

                        <li>
                            <a asp-controller="AgentSaisie" asp-action="Extract">
                                <i class="material-icons">scanner</i> Scanner
                            </a>
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </section>

    <!-- Main content -->
    <section class="d-flex" id="wrapper">
        <div class="page-content-wrapper">
            <!-- Breadcrumb -->
            <div class="content-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item active" aria-current="page">
                            <i class="material-icons">dashboard</i> Tableau de Bord
                        </li>
                    </ol>
                </nav>
            </div>

            <!-- Success message -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Dashboard content -->
            <div class="main-content">
                <!-- Stats cards -->
                <div class="row animated fadeInUp">
                    <div class="col-xl-3 col-sm-6 mb-4">
                        <div class="card text-white bg-info o-hidden h-100 dashboard-card">
                            <div class="card-body">
                                <div class="card-body-icon">
                                    <i class="material-icons">flight_land</i>
                                </div>
                                <div class="mr-5">
                                    <h5>@ViewBag.CountSalesArriveeThisMonth</h5>
                                    <p class="mb-0">État des ventes arrivées ce mois</p>
                                </div>
                            </div>
                            <a class="card-footer text-white clearfix small z-1" asp-controller="AgentSaisie" asp-action="EtatDesVentesArrivee">
                                <span class="float-start">Voir détails</span>
                                <span class="float-end">
                                    <i class="material-icons">chevron_right</i>
                                </span>
                            </a>
                        </div>
                    </div>

                    <div class="col-xl-3 col-sm-6 mb-4">
                        <div class="card text-white bg-primary o-hidden h-100 dashboard-card">
                            <div class="card-body">
                                <div class="card-body-icon">
                                    <i class="material-icons">flight_land</i>
                                </div>
                                <div class="mr-5">
                                    <h5>@ViewBag.CountOffersArriveeThisMonth</h5>
                                    <p class="mb-0">État des offres arrivées ce mois</p>
                                </div>
                            </div>
                            <a class="card-footer text-white clearfix small z-1" asp-controller="AgentSaisie" asp-action="EtatDesOffresArrivee">
                                <span class="float-start">Voir détails</span>
                                <span class="float-end">
                                    <i class="material-icons">chevron_right</i>
                                </span>
                            </a>
                        </div>
                    </div>

                    <div class="col-xl-3 col-sm-6 mb-4">
                        <div class="card text-white bg-danger o-hidden h-100 dashboard-card">
                            <div class="card-body">
                                <div class="card-body-icon">
                                    <i class="material-icons">flight_takeoff</i>
                                </div>
                                <div class="mr-5">
                                    <h5>@ViewBag.CountSalesDepartThisMonth</h5>
                                    <p class="mb-0">État des ventes départ ce mois</p>
                                </div>
                            </div>
                            <a class="card-footer text-white clearfix small z-1" asp-controller="AgentSaisie" asp-action="EtatDesVentesDepart">
                                <span class="float-start">Voir détails</span>
                                <span class="float-end">
                                    <i class="material-icons">chevron_right</i>
                                </span>
                            </a>
                        </div>
                    </div>

                    <div class="col-xl-3 col-sm-6 mb-4">
                        <div class="card text-white bg-success o-hidden h-100 dashboard-card">
                            <div class="card-body">
                                <div class="card-body-icon">
                                    <i class="material-icons">flight_takeoff</i>
                                </div>
                                <div class="mr-5">
                                    <h5>@ViewBag.CountOffersDepartThisMonth</h5>
                                    <p class="mb-0">État des offres départ ce mois</p>
                                </div>
                            </div>
                            <a class="card-footer text-white clearfix small z-1" asp-controller="AgentSaisie" asp-action="EtatDesOffresDepart">
                                <span class="float-start">Voir détails</span>
                                <span class="float-end">
                                    <i class="material-icons">chevron_right</i>
                                </span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Chart section -->
                <div class="row mt-4">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Statistiques des États soumis ce Mois</h5>
                            </div>
                            <div class="card-body">
                                <div class="chart-container">
                                    <canvas id="statsChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Modal -->
    <div class="modal fade" id="salesModal" tabindex="-1" aria-labelledby="salesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="modalContent"></div>
        </div>
    </div>

    <!-- JavaScript -->
    <script src="~/js/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/jquery.dataTables.min.js"></script>
    <script src="~/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/Chart.min.js"></script>
    <script src="~/js/wow.min.js"></script>
    <script src="~/js/script.js"></script>
    <script src="/lib/signalr/signalr.js"></script>

    <script>
        $(document).ready(function () {
            // Initialize variables
            const userId = '@User.FindFirstValue(ClaimTypes.NameIdentifier)';
            let notificationCount = @notifications.Count(n => !n.IsRead);

            // Initialize toast
            const notificationToast = new bootstrap.Toast(document.getElementById('notificationToast'));

            // Show notification badge if there are unread notifications
            updateNotificationBadge();

            // Initialize SignalR connection
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .withAutomaticReconnect()
                .build();

            // SignalR methods
            connection.on("ReceiveNotification", function (message) {
                if (message) {
                    notificationCount++;
                    updateNotificationBadge();

                    // Add new notification to the top of the list
                    const currentTime = new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
                    const notificationItem = $(`
                        <div class="notification-item unread" data-id="new">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">${message}</div>
                                <small class="text-muted ms-2">${currentTime}</small>
                            </div>
                        </div>
                    `);

                    // Remove "no notifications" message if present
                    $('#notificationList .text-center').remove();

                    // Add to top of list
                    $('#notificationList').prepend(notificationItem);

                    // Show toast notification
                    $('#notificationToast .toast-body').text(message);
                    notificationToast.show();

                    // Limit visible notifications to maintain performance
                    const allNotifications = $('#notificationList .notification-item');
                    if (allNotifications.length > 15) {
                        allNotifications.slice(15).remove();
                    }
                }
            });

            connection.onreconnecting(error => {
                console.log("Connection lost, trying to reconnect...", error);
            });

            connection.onreconnected(connectionId => {
                console.log("Connection reestablished. Connected with ID:", connectionId);
            });

            // Start SignalR connection
            connection.start()
                .then(() => console.log("SignalR connection established."))
                .catch(err => console.error("SignalR connection error:", err));

            // Clear notifications button
            $('#clearNotifications').on('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                if (notificationCount > 0) {
                    $.post('/AgentSaisie/MarkNotificationsRead', { userId: userId })
                        .done(function() {
                            notificationCount = 0;
                            updateNotificationBadge();

                            // Update UI
                            $('#notificationList').empty();
                            $('#notificationList').append(`
                                <div class="notification-item text-muted text-center py-3">
                                    <i class="material-icons mb-2" style="font-size: 2rem; opacity: 0.5;">notifications_none</i>
                                    <div>Aucune notification</div>
                                </div>
                            `);
                        })
                        .fail(function() {
                            console.error('Failed to clear notifications');
                        });
                }
            });

            // Handle notification item clicks
            $(document).on('click', '.notification-item:not(.text-center)', function() {
                if ($(this).hasClass('unread')) {
                    $(this).removeClass('unread');
                    notificationCount = Math.max(0, notificationCount - 1);
                    updateNotificationBadge();

                    // Mark as read on server
                    const notificationId = $(this).data('id');
                    if (notificationId && notificationId !== 'new') {
                        $.post('/AgentSaisie/MarkNotificationRead', { notificationId: notificationId });
                    }
                }
            });

            // Initialize chart
            initStatsChart();

            // Initialize dropdown toggles
            $('.dropdown-item-list[data-bs-toggle="collapse"]').on('click', function(e) {
                e.preventDefault();
                const target = $(this).attr('href');
                $(target).collapse('toggle');
                $(this).find('.collapsed, .expanded').toggle();
            });

            // Close dropdowns when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.dropdown').length) {
                    $('.dropdown-menu').removeClass('show');
                }
            });

            // Prevent dropdown from closing when clicking inside
            $('.dropdown-menu').on('click', function(e) {
                e.stopPropagation();
            });

            // Helper functions
            function updateNotificationBadge() {
                if (notificationCount > 0) {
                    $('#notificationBadge').text(notificationCount > 99 ? '99+' : notificationCount).show();
                } else {
                    $('#notificationBadge').hide();
                }
            }

            function initStatsChart() {
                const ctx = document.getElementById('statsChart').getContext('2d');
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Ventes Arrivée', 'Offres Arrivée', 'Ventes Départ', 'Offres Départ'],
                        datasets: [{
                            data: [
        @ViewBag.CountSalesArriveeThisMonth,
        @ViewBag.CountOffersArriveeThisMonth,
        @ViewBag.CountSalesDepartThisMonth,
        @ViewBag.CountOffersDepartThisMonth
                            ],
                            backgroundColor: [
                                '#17a2b8',
                                '#007bff',
                                '#dc3545',
                                '#28a745'
                            ],
                            borderColor: '#fff',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    font: {
                                        family: 'Nunito',
                                        size: 14
                                    },
                                    padding: 20
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.label || '';
                                        const value = context.raw || 0;
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = Math.round((value / total) * 100);
                                        return `${label}: ${value} (${percentage}%)`;
                                    }
                                }
                            }
                        },
                        cutout: '65%'
                    }
                });
            }

            // Load sales report form in modal
            window.loadSalesReportForm = function(url) {
                $.get(url, function(data) {
                    $('#modalContent').html(data);
                    const modal = new bootstrap.Modal(document.getElementById('salesModal'));
                    modal.show();
                });
            };

            // Initialize tooltips if needed
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
</body>
</html>