    <script>
        let lastCategoryId = 0;

        function addCategory() {
            const tbody = document.getElementById('article-tbody');
            lastCategoryId++;
            const categoryId = 'category-' + lastCategoryId;

            const categoryRow = document.createElement('tr');
            categoryRow.className = 'category-row';
            categoryRow.id = categoryId;
            categoryRow.innerHTML = `
                <td colspan="12">
                    <input type="text" class="category-name" name="category_name_${lastCategoryId}" placeholder="Nom de catégorie">
                    <button type="button" class="delete-row-btn" onclick="deleteCategory('${categoryId}')">X</button>
                    <button type="button" class="add-row-btn" style="float: right; margin-right: 10px; padding: 2px 5px;"
                            onclick="addArticle('${categoryId}')">+ Article</button>
                </td>
            `;
            tbody.appendChild(categoryRow);

            addArticle(categoryId);
        }

        function addArticle(categoryId) {
            const tbody = document.getElementById('article-tbody');
            const categoryRow = document.getElementById(categoryId);
            let nextRow = categoryRow.nextElementSibling;

            while (nextRow && !nextRow.className.includes('category-row')) {
                if (nextRow.className.includes('category-summary-row')) break;
                nextRow = nextRow.nextElementSibling;
            }

            const articleCount = countArticlesInCategory(categoryId) + 1;
            const row = document.createElement('tr');
            row.className = 'article-row';
            row.innerHTML = `
                <td><input type="text" name="code_${categoryId}_${articleCount}" class="small-input form-control"></td>
                <td><input type="text" name="desc_${categoryId}_${articleCount}" class="form-control"></td>
                <td><input type="number" name="qte_dotation_${categoryId}_${articleCount}" class="small-input form-control"></td>
                <td><input type="number" name="qte_complementaire_${categoryId}_${articleCount}" class="small-input form-control"></td>
                <td><input type="number" name="tot_em_${categoryId}_${articleCount}" class="small-input form-control"></td>
                <td><input type="number" name="qte_casse_${categoryId}_${articleCount}" class="small-input form-control"></td>
                <td><input type="number" name="qte_offerte_${categoryId}_${articleCount}" class="small-input form-control"></td>
                <td><input type="number" name="qte_vendue_${categoryId}_${articleCount}" class="small-input form-control"></td>
                <td><input type="text" name="prix_unitaire_ht_${categoryId}_${articleCount}" class="small-input form-control"></td>
                <td><input type="text" name="valeur_${categoryId}_${articleCount}" class="small-input form-control"></td>
                <td><input type="number" name="restant_${categoryId}_${articleCount}" class="small-input form-control"></td>
                <td><button type="button" class="delete-row-btn" onclick="deleteRow(this)">X</button></td>
            `;

            if (nextRow) {
                tbody.insertBefore(row, nextRow);
            } else {
                tbody.appendChild(row);
            }

            addOrUpdateCategorySummary(categoryId);
        }

        function addOrUpdateCategorySummary(categoryId) {
            const tbody = document.getElementById('article-tbody');
            const categoryRow = document.getElementById(categoryId);
            let nextRow = categoryRow.nextElementSibling;

            while (nextRow && !nextRow.className.includes('category-row')) {
                if (nextRow.className.includes('category-summary-row')) {
                    updateGrandTotal();
                    return;
                }
                nextRow = nextRow.nextElementSibling;
            }

            const summaryRow = document.createElement('tr');
            summaryRow.id = `summary-${categoryId}`;
            summaryRow.className = 'category-summary-row';
            summaryRow.innerHTML = `
                <td>Total</td>
                <td><input type="text" name="summary_desc_${categoryId}" class="summary-description form-control"></td>
                <td colspan="2"></td>
                <td><input type="number" name="summary_totem_${categoryId}" class="category-total-input form-control"></td>
                <td></td>
                <td></td>
                <td><input type="number" name="summary_qtevendue_${categoryId}" class="category-total-input form-control"></td>
                <td></td>
                <td><input type="number" name="summary_valeur_${categoryId}" class="category-total-input form-control"></td>
                <td><input type="number" name="summary_restant_${categoryId}" class="category-total-input form-control"></td>
                <td></td>
            `;

            if (nextRow) {
                tbody.insertBefore(summaryRow, nextRow);
            } else {
                tbody.appendChild(summaryRow);
            }

            const valeurInput = summaryRow.querySelector(`input[name="summary_valeur_${categoryId}"]`);
            valeurInput.addEventListener('input', updateGrandTotal);

            updateGrandTotal();
        }

        function updateGrandTotal() {
            const summaryRows = document.querySelectorAll('.category-summary-row');
            let grandTotalValeur = 0;

            summaryRows.forEach(row => {
                grandTotalValeur += parseFloat(row.querySelector('input[name$="_valeur"]')?.value) || 0;
            });

            document.getElementById('grand-total-value').textContent = grandTotalValeur.toFixed(2);
        }

        function deleteRow(button) {
            const row = button.closest('tr');
            row.parentNode.removeChild(row);
            updateGrandTotal();
        }

        function deleteCategory(categoryId) {
            const tbody = document.getElementById('article-tbody');
            let row = document.getElementById(categoryId);
            let nextRow = row.nextElementSibling;

            while (nextRow && !nextRow.className.includes('category-row')) {
                const toDelete = nextRow;
                nextRow = nextRow.nextElementSibling;
                tbody.removeChild(toDelete);
            }
            tbody.removeChild(row);
            updateGrandTotal();
        }

        function addPncRow() {
            const tbody = document.getElementById('pnc-tbody');
            const index = tbody.rows.length + 1;
            const row = document.createElement('tr');
            row.innerHTML = `
                <td><input type="text" name="pnc${index}_dynamic" class="form-control"></td>
                <td><input type="text" name="matricule${index}_dynamic" class="form-control"></td>
                <td><button type="button" class="delete-row-btn" onclick="deleteRow(this)">X</button></td>
            `;
            tbody.appendChild(row);
        }

        function countArticlesInCategory(categoryId) {
            const tbody = document.getElementById('article-tbody');
            const rows = tbody.getElementsByTagName('tr');
            let count = 0;
            let counting = false;
            for (let i = 0; i < rows.length; i++) {
                if (rows[i].id === categoryId) {
                    counting = true;
                    continue;
                }
                if (counting) {
                    if (rows[i].className === 'article-row') {
                        count++;
                    } else if (rows[i].className.includes('category-row')) {
                        break;
                    }
                }
            }
            return count;
        }

        function addArticleToLastCategory() {
            if (lastCategoryId > 0) {
                addArticle('category-' + lastCategoryId);
            } else {
                alert('Veuillez d\'abord ajouter une catégorie.');
            }
        }

        window.onload = function() {
            addCategory();
        };
    </script>
