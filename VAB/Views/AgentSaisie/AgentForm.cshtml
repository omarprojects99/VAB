@{
    Layout = null;
    var tableData = ViewBag.TableData as string;
}

<!DOCTYPE html>
<html>
<head>
    <title>Extracted Table</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="p-4">
    <h3>Extracted Table Data (JSON):</h3>
    <pre>@Html.Raw(tableData)</pre>

    <a href="@Url.Action("Index")" class="btn btn-secondary mt-3">Back</a>
</body>
</html>
