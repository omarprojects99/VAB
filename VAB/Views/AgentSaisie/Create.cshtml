<form id="uploadForm" enctype="multipart/form-data" method="post" asp-controller="Pdf" asp-action="ExtractTable">
    <div class="form-group">
        <label for="fileUpload">Upload PDF or Image file:</label>
        <input type="file" class="form-control" id="fileUpload" name="uploadedFile" accept=".pdf,image/*" required />
    </div>
    <button type="submit" class="btn btn-primary">Extract Table</button>
</form>

<div id="result" class="mt-3"></div>
