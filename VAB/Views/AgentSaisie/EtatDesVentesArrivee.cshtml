@model IEnumerable<dynamic>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">

    <!-- Title -->
    <title>Agent de Saisie Dashboard</title>

    <!-- Favicon Icon -->
    <link rel="shortcut icon" href="~/images/icons/favicon.png" type="image/png">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Nunito&display=swap" rel="stylesheet">

    <!-- Material Icons -->
    <link rel="stylesheet" href="~/iconfont/material-icons.css">

    <!-- DataTables Bootstrap 4 CSS -->
    <link href="~/css/dataTables.bootstrap4.min.css" rel="stylesheet" media="screen">

    <!-- Chart.min CSS -->
    <link href="~/css/Chart.min.css" rel="stylesheet" media="screen">

    <!-- Animate CSS -->
    <link href="~/css/animate.css" rel="stylesheet" media="screen">
    <!-- Normalize CSS -->
    <link href="~/css/normalize.css" rel="stylesheet" media="screen">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css">

    <!-- Style CSS -->
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/sidebar.css">
    <!-- Responsive CSS -->
    <link rel="stylesheet" href="~/css/responsive.css">
   <style>
        .dataTables_paginate .pagination .page-item.active .page-link {
            background-color: #6c757d;
            border-color: #6c757d;
            color: white;
        }

        .dataTables_paginate .pagination .page-item .page-link {
            color: #6c757d;
            background-color: white;
            border-color: #dee2e6;
        }

            .dataTables_paginate .pagination .page-item .page-link:hover {
                background-color: #5a6268;
                border-color: #5a6268;
                color: white;
            }

        .dataTables_paginate .pagination .page-item.disabled .page-link {
            color: #6c757d;
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }
   </style>

</head>

<body>
    <!-- Preloader -->
    <div class="spinner_body">
        <div class="spinner"></div>
    </div>
    <!-- Toast notification -->
    <div id="notificationToast" class="toast toast-notification hide" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-primary text-white">
            <strong class="me-auto">Notification</strong>
            <small class="text-white">à l'instant</small>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body"></div>
    </div>

    <!-- Header -->
    <header>
        <div class="header">
            <div class="navigation">
                <nav class="navbar navbar-expand-lg navbar-bg">
                    <div class="brand-logo">
                        <a class="navbar-brand" asp-controller="AgentSaisie" asp-action="AgentDashboard"
                           id="menu-action">
                            <div class="logo-tunisair">
                                <img src="~/images/icons/Tunisair-Logo-Vector.svg-.png" alt="">
                            </div>
                        </a>
                        <div id="nav-toggle">
                            <div class="cta">
                                <div class="toggle-btn type1"></div>
                            </div>
                        </div>
                    </div>
                    <!-- For Toggle Mobile Nav icon -->
                    <div class="for-mobile d-mobile">
                        <div class="toggle-button" id="toggle-button">
                            <span class="material-icons">menu</span>
                        </div>
                    </div>
                    <!-- For Toggle Mobile Nav Icon -->
                    <div class="collapse navbar-collapse pr-3" id="#">
                        <ul class="navbar-nav user-info ml-auto mt-2 mt-lg-0">
                            <li class="nav-item dropdown show">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <a href="#" class="navbar-nav-link dropdown-toggle text-light" data-toggle="dropdown" aria-expanded="true">
                                        <div class="user-photo">
                                            <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" style="border-radius: 50%;" alt="">
                                        </div>
                                        @User.Identity.Name
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a asp-controller="AgentSaisie" asp-action="AgentAccountSettings" class="dropdown-item">
                                            <i class="material-icons">supervisor_account</i> Account Settings
                                        </a>
                                        <div class="menu-dropdown-divider"></div>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                            <i class="material-icons">exit_to_app</i> Logout
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a>
                                }
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
            <!-- For Toggle Mobile Nav -->
            <div class="toggle-user-menu" id="toggle-user-menu">
                <ul>
                    <li><a href="#">
                            <div class="user-photo"><img
                                    src="https://dw3i9sxi97owk.cloudfront.net/uploads/thumbs/db9c4e1327eb8fe5e9395a4b04e1ea4a_70x70.jpg"
                                    alt=""></div>@User.Identity.Name
                        </a></li>
                    <li>
                        <a asp-controller="AgentSaisie" asp-action="AccountSettings">
                            <i class="material-icons mr-2">supervisor_account</i> Account Settings
                        </a>
                    </li>
                    <li><a asp-controller="Account" asp-action="Logout"><i
                                class="material-icons mr-2">exit_to_app</i>Logout</a></li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Left Sidebar -->
    <section id="left-sidebar-area">
        <div id="left-sidebar-section">
            <aside>
                <div class="left-sidebar" id="wrapper-sidebar">
                    <ul>
                        <li>
                            <a asp-controller="AgentSaisie" asp-action="AgentDashboard">
                                <i class="material-icons">dashboard</i>Tableau de Bord
                            </a>
                        </li>
                        <li>
                            <a data-toggle="collapse" class="dropdown-item-list" href="#etatDesVentesDropdown">
                                <i class="material-icons">receipt</i>Gérer États des Ventes
                                <span class="collapsed float-right"><i class="material-icons">add</i></span>
                                <span class="expanded float-right"><i class="material-icons">remove</i></span>
                            </a>
                            <div id="etatDesVentesDropdown" class="panel-collapse collapse">
                                <div class="sub-dropdown">
                                    <ul class="sub-list">
                                        <li>
                                            <a asp-controller="AgentSaisie" asp-action="EtatDesVentesDepart">État des
                                                Ventes Départ</a>
                                        </li>
                                        <li>
                                            <a asp-controller="AgentSaisie" asp-action="EtatDesVentesArrivee">État des
                                                Ventes Arrivée</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                        <li>
                            <a data-toggle="collapse" class="dropdown-item-list" href="#etatDesOffresDropdown">
                                <i class="material-icons">receipt</i>Gérer États des Offres
                                <span class="collapsed float-right"><i class="material-icons">add</i></span>
                                <span class="expanded float-right"><i class="material-icons">remove</i></span>
                            </a>
                            <div id="etatDesOffresDropdown" class="panel-collapse collapse">
                                <div class="sub-dropdown">
                                    <ul class="sub-list">
                                        <li>
                                            <a asp-controller="AgentSaisie" asp-action="EtatDesOffresDepart">État des
                                                Offres Départ</a>
                                        </li>
                                        <li>
                                            <a asp-controller="AgentSaisie" asp-action="EtatDesOffresArrivee">État des
                                                Offres Arrivée</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </section>

    <!-- Main Wrapper -->
    <section class="d-flex" id="wrapper">
        <div class="page-content-wrapper">
            <!-- Header BreadCrumb -->
            <div class="content-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item active" aria-current="page"><i class="material-icons">receipt</i>État
                            des Ventes</li>
                    </ol>
                </nav>
                @* <div class="create-item"> *@
                @*     <button onclick="loadSalesReportForm('/AgentSaisie/AddEtatDesVentesArrivee')" class="btn" *@
                @*         style="background-color: #c5c5c5">➕ Créer un État des Ventes</button> *@
                @* </div> *@
            </div>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            <!-- Main Content -->
            <div class="row mt-3">
                <div class="col-md-12">
                    <div class="card bg-white">
                        <div class="card-body mt-3">
                            <div class="create-item" style="text-align: right;padding-bottom:15px">
                                <button onclick="loadSalesReportForm('/AgentSaisie/AddEtatDesVentesArrivee')" class="btn"
                                        style="background-color: #c5c5c5">
                                    ➕ Créer un État des Ventes
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table id="salesReportsTable" class="table table-striped table-borderless"
                                    style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Numéro</th>
                                            <th>Date</th>
                                            
                                            <th>Total Articles Vendus</th>
                                            <th>Revenu Total</th>
                                            <th>Total Encaissé</th>
                                            <th>Statut Validation</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bootstrap Modal for Adding -->
    <div class="modal fade" id="salesModal" tabindex="-1" role="dialog" aria-labelledby="salesModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content" id="modalContent">
                <div class="modal-header bg-gradient-dark-red text-white">
                    <h5 class="modal-title fw-bold" id="salesModalLabel">Créer un État des Ventes Arrivée</h5>
                    <button type="button" class="btn-close btn-close-white" data-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- AJAX will load the partial here -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
                    <button type="submit" class="btn btn-primary" form="salesForm">Enregistrer</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap Modal for Viewing -->
    <div class="modal fade" id="viewEtatModal" tabindex="-1" role="dialog" aria-labelledby="viewEtatModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content" id="viewEtatModalContent">
                <!-- AJAX will load the partial here -->
            </div>
        </div>
    </div>

    <!-- Invisible antiforgery form -->
    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

    <!-- Scripts -->
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.dataTables.min.js"></script>
    <script src="~/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/Chart.min.js"></script>
    <script src="~/js/Chart.bundle.min.js"></script>
    <script src="~/js/chartfunction.js"></script>
    <script src="~/js/wow.min.js"></script>
    <script src="~/js/script.js"></script>

    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var salesTable = $('#salesReportsTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [10, 15, 25],
                ajax: {
                    url: '/AgentSaisie/GetEtatDesVentesArrivee',
                    dataSrc: ''
                },
                      columns: [
            { data: 'numero' },
            { data: 'dateEdition', render: function(data) { return data ? new Date(data).toLocaleString() : ''; }, defaultContent: '' },
            
            { data: 'totalItemsSold', defaultContent: '0', className: 'dt-right' },
            { data: 'totalRevenue', render: function(data) { return data ? data.toFixed(2) : '0.00'; }, defaultContent: '0.00', className: 'dt-right' },
            { data: 'totalEncaisse', render: function(data) { return data ? data.toFixed(2) : '0.00'; }, defaultContent: '0.00', className: 'dt-right' },
                    {
            data: 'isValidated',
            render: function (data) {
                return `<span class="${data ? 'validated' : 'not-validated'}">${data ? 'Validé' : 'Non validé'}</span>`;
            },
                   defaultContent: '<span class="not-validated">Non validé</span>'
        },
        {
            data: 'id',
            render: function(data, type, row) {
                let buttons = `<button class="btn btn-sm btn-secondary view-sales-btn" style="display: inline-block; padding: 0.25rem 0.5rem; line-height: 1.5;" data-id="${data}">👁 Voir</button>`;

                // Only show edit button if not validated
                if (!row.isValidated) {
                    buttons += ` <button class="btn btn-sm btn-warning edit-sales-btn" style="display: inline-block; padding: 0.25rem 0.5rem; line-height: 1.5;" data-id="${data}">✏️ Modifier</button>`;
                }

                buttons += ` <button class="btn btn-sm btn-danger delete-btn" onclick="deleteSalesReport('${row.numero}')">🗑 Supprimer</button>`;

                return buttons;
            }
        }
        ]
            });

            // Form submission via AJAX
            $(document).on('submit', '#salesForm', function (e) {
                e.preventDefault();
                var $form = $(this);

                $.ajax({
                    url: $form.attr('action'),
                    method: $form.attr('method'),
                    data: $form.serialize(),
                    success: function (html) {
                        // Replace modal body with returned partial
                        $('#salesModal .modal-body').html(html);

                        // If save succeeded, close modal and show success
                        if ($('#formSuccess').length) {
                            $('#salesModal').modal('hide');
                            var $msg = $('<div class="alert alert-success">✅ État des Ventes enregistré avec succès</div>');
                            $('.page-content-wrapper').prepend($msg);
                            // Auto-dismiss alert after 5 seconds
                            setTimeout(function () {
                                $msg.fadeOut(500, function () {
                                    $(this).remove();
                                });
                            }, 5000);
                            if ($.fn.DataTable && $('#salesReportsTable').length) {
                                $('#salesReportsTable').DataTable().ajax.reload(null, false);
                            }
                        }
                    },
                    error: function () {
                        alert('Erreur serveur, réessayez.');
                    }
                });
            });
            // Load form in modal (for add)
            window.loadSalesReportForm = function (url) {
                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (html) {
                        $('#salesModal .modal-body').html(html);
                        $('#salesModal').modal('show');
                    },
                    error: function () {
                        alert('Erreur lors du chargement du formulaire.');
                    }
                });
            };

            // Load view modal
            $(document).on('click', '.view-sales-btn', function () {
                var id = $(this).data('id');
                $.ajax({
                    url: '/AgentSaisie/ViewEtatDesVentesArrivee?id=' + id,
                    type: 'GET',
                    success: function (data) {
                        $('#viewEtatModalContent').html(data);
                        $('#viewEtatModal').modal('show');
                    },
                    error: function (xhr) {
                        alert('Erreur lors du chargement des détails : ' + xhr.status + ' - ' + xhr.statusText);
                    }
                });
            });

            // Delete sales report
            window.deleteSalesReport = function (numero) {
                if (!confirm('Êtes-vous sûr de vouloir supprimer cet État des Ventes ?')) {
                    return;
                }
                var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '/AgentSaisie/DeleteEtatDesVentesArriveeByNumero',
                    type: 'POST',
                    data: { numero: numero, __RequestVerificationToken: token },
                    success: function (response) {  if (response.success) {
                            var $msg = $('<div class="alert alert-success">✅ Supprimé avec succès</div>');
                            $('.page-content-wrapper').prepend($msg);
                            // Auto-dismiss delete alert after 5 seconds
                            setTimeout(function () {
                                $msg.fadeOut(500, function () {
                                    $(this).remove();
                                });
                            }, 5000);
                            salesTable.ajax.reload(null, false);
                        } else {
                            alert('Erreur : ' + response.message);
                        }
                    },
                    error: function (xhr) {
                        alert('Erreur serveur : ' + xhr.status + ' - ' + xhr.statusText);
                    }
                });
            };
        });
    </script>
    <script>
        $(document).ready(function () {
            const sidebar = $('.sidebar');
            const overlay = $('<div class="sidebar-overlay"></div>').appendTo('body');

            $('.navbar-toggler').on('click', function () {
                sidebar.toggleClass('show');
                overlay.toggleClass('show');
            });

            overlay.on('click', function () {
                sidebar.removeClass('show');
                overlay.removeClass('show');
            });
        });
                // Load edit modal
        $(document).on('click', '.edit-sales-btn', function () {
            var id = $(this).data('id');
            $.ajax({
                url: '/AgentSaisie/EditEtatDesVentesArrivee?id=' + id,
                type: 'GET',
                success: function (html) {
                    $('#salesModal .modal-body').html(html);
                    $('#salesModal .modal-title').text('Modifier État des Ventes Arrivée');
                    $('#salesModal').modal('show');
                },
                error: function (xhr) {
                    alert('Erreur lors du chargement du formulaire de modification : ' + xhr.status + ' - ' + xhr.statusText);
                }
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</body>

</html>