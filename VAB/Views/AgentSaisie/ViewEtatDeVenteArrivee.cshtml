@model VAB.ViewModel.EtatDesVentesArriveeViewModel
@{
    Layout = null;
}

<div class="modal-body sales-form-modal" style="max-height: 70vh; overflow-y: auto;">
    <div class="header-section">
        <h3 class="company-title">TUNISAIR</h3>
        <div class="location-info">VAB TUNIS<br>Carthage</div>
        <div class="form-group">
            <label>Date et Heure d'Édition:</label>
            <p class="form-control-static">@Model.DateEdition.ToString("yyyy-MM-dd HH:mm")</p>
        </div>
        <div class="form-group">
            <label>Agent Saisie</label>
            <p class="form-control-static">@(Model.AgentSaisieName ?? "Inconnu")</p>
        </div>
    </div>

    <h3 class="form-title">ETAT DES VENTES ARRIVEE N° <span class="form-control-static d-inline-block w-auto">@Model.Numero</span></h3>

    <table class="info-table">
        <tr>
            <td>FL 01:</td>
            <td><p class="form-control-static">@(Model.FeuilleDeLignesNumeros != null && Model.FeuilleDeLignesNumeros.Count > 0 ? Model.FeuilleDeLignesNumeros[0].ToString() : "Aucun")</p></td>
            <td>CC 1:</td>
            <td><p class="form-control-static">@(Model.Cc1Name ?? "Inconnu")</p></td>
            <td>Matricule:</td>
            <td><p class="form-control-static">@(Model.Cc1Matricule ?? "Inconnu")</p></td>
            <td>PNC 1:</td>
            <td><p class="form-control-static">@(Model.Pnc1Name ?? "Inconnu")</p></td>
            <td>Matricule:</td>
            <td><p class="form-control-static">@(Model.Pnc1Matricule ?? "Inconnu")</p></td>
        </tr>
        <tr>
            <td>FL 02:</td>
            <td><p class="form-control-static">@(Model.FeuilleDeLignesNumeros != null && Model.FeuilleDeLignesNumeros.Count > 1 ? Model.FeuilleDeLignesNumeros[1].ToString() : "Aucun")</p></td>
            <td>CC 2:</td>
            <td><p class="form-control-static">@(string.IsNullOrEmpty(Model.Cc2Name) ? "Aucun" : Model.Cc2Name)</p></td>
            <td>Matricule:</td>
            <td><p class="form-control-static">@(string.IsNullOrEmpty(Model.Cc2Matricule) ? "Aucun" : Model.Cc2Matricule)</p></td>
            <td>PNC 2:</td>
            <td><p class="form-control-static">@(string.IsNullOrEmpty(Model.Pnc2Name) ? "Aucun" : Model.Pnc2Name)</p></td>
            <td>Matricule:</td>
            <td><p class="form-control-static">@(string.IsNullOrEmpty(Model.Pnc2Matricule) ? "Aucun" : Model.Pnc2Matricule)</p></td>
        </tr>
    </table>

    <!-- Combined PNC Dynamiques and Données Générales Section -->
    <div class="tables-container" style="display: flex; gap: 20px; margin-bottom: 15px;">
        <!-- PNC Dynamiques Table -->
        <div class="dynamic-pnc-section" style="flex: 1;">
            <h4 class="form-title">PNCs</h4>
            <table class="dynamic-pnc-table">
                <thead>
                    <tr>
                        <th>PNC</th>
                        <th>Matricule</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DynamicPncs == null || !Model.DynamicPncs.Any())
                    {
                        <tr>
                            <td colspan="2"><p class="form-control-static">Aucun PNC dynamique</p></td>
                        </tr>
                    }
                    else
                    {
                        foreach (var pnc in Model.DynamicPncs)
                        {
                            <tr>
                                <td><p class="form-control-static">@pnc.Name</p></td>
                                <td><p class="form-control-static">@pnc.Matricule</p></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Données Générales Table -->
        <div class="general-data-section" style="flex: 1;">
            <h4 class="form-title">Données Générales</h4>
            <table class="table table-bordered modern-info-table">
                <tr>
                    <td><strong>A/C</strong></td>
                    <td>@(Model.Aircraft ?? "N/A")</td>
                </tr>
                <tr>
                    <td><strong>VOL</strong></td>
                    <td>@(Model.FlightNumber != 0 ? Model.FlightNumber.ToString() : "N/A")</td>
                </tr>
                <tr>
                    <td><strong>DEST</strong></td>
                    <td>@(Model.Destination ?? "N/A")</td>
                </tr>
                <tr>
                    <td><strong>TYPE</strong></td>
                    <td>@(Model.FlightType ?? "N/A")</td>
                </tr>
                <tr>
                    <td><strong>DATE</strong></td>
                    <td>@(Model.FlightDate != DateTime.MinValue ? Model.FlightDate.ToString("dd/MM/yyyy") : "N/A")</td>
                </tr>
                <tr>
                    <td><strong>HEURE</strong></td>
                    <td>@(Model.FlightTime != TimeSpan.Zero ? Model.FlightTime.ToString(@"hh\:mm") : "N/A")</td>
                </tr>
                <tr>
                    <td><strong>Tot Pax</strong></td>
                    <td>@(Model.TotalPassengers != 0 ? Model.TotalPassengers.ToString() : "N/A")</td>
                </tr>
            </table>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
    </div>

    <style>
        .sales-form-modal {
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 13px;
            padding: 20px;
            background-color: #f9f9f9;
            color: #333;
        }

        .header-section {
            margin-bottom: 20px;
            position: relative;
        }

        .company-title {
            color: #600000;
            font-weight: bold;
            margin-bottom: 5px;
            font-size: 22px;
        }

        .location-info {
            color: #555;
            margin-bottom: 15px;
            font-style: italic;
        }

        .form-title {
            text-align: center;
            color: #600000;
            font-weight: bold;
            margin: 20px 0;
            padding-bottom: 10px;
            border-bottom: 2px solid #600000;
        }

        .sales-form-modal .form-group {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            margin: 8px 0;
        }

            .sales-form-modal .form-group label {
                margin: 0;
                font-weight: 500;
            }

        .form-control-static {
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 5px 8px;
            font-size: 13px;
            background-color: #fff;
            display: inline-block;
            width: 100%;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            background-color: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

            .info-table td {
                border: 1px solid #eee;
                padding: 6px;
                text-align: left;
                font-size: 13px;
            }

            .info-table p {
                margin: 0;
            }

        .dynamic-pnc-table, .modern-info-table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

            .dynamic-pnc-table th, .dynamic-pnc-table td,
            .modern-info-table th, .modern-info-table td {
                border: 1px solid #eee;
                padding: 6px;
                text-align: left;
                font-size: 13px;
            }

            .dynamic-pnc-table th {
                background-color: #f5f5f5;
                font-weight: bold;
            }

            .dynamic-pnc-table p {
                margin: 0;
            }

        .modal-footer {
            border-top: 3px solid #600000;
            padding: 15px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
        }

            .btn-secondary:hover {
                background-color: #5a6268;
            }
    </style>
</div>