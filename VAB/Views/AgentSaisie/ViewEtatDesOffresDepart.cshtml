@model VAB.ViewModel.EtatDesOffresArriveeViewModel
@{
    Layout = null;
}

<div class="offers-form-modal">
    <div class="header-section">
        <h3 class="company-title">TUNISAIR</h3>
        <div class="location-info">VAB TUNIS<br>Carthage</div>
        <div class="form-group">
            <label>Date d'édition</label>
            <p>@Model.DateEdition.ToString("g")</p>
        </div>
    </div>

    <h3 class="form-title">ETAT DES OFFRES DEPART N° @Model.Numero</h3>
    <p>Statut: <span class="@(Model.IsValidated ? "validated" : "not-validated")">@(Model.IsValidated ? "Validé" : "Non validé")</span></p>

    <div class="table-responsive">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Description</th>
                    <th>Quantité Dotation</th>
                    <th>Quantité Compl.</th>
                    <th>Tot Em</th>
                    <th>Quantité Casse</th>
                    <th>Quantité Offerte</th>
                    <th>Retour Consig</th>
                    <th>Déficite</th>
                    <th>Restant</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var groupedArticles = Model.ArticleOffres
                    .GroupBy(ao => ao.CategorieId)
                    .OrderBy(g => g.First().CategorieDescription);
                }
                @foreach (var group in groupedArticles)
                {
                    var categorie = group.First();
                    <tr class="category-row" data-categorie-id="@categorie.CategorieId">
                        <td colspan="10">
                            <span class="category-name">@categorie.CategorieDescription</span>
                        </td>
                    </tr>
                    foreach (var article in group)
                    {
                        <tr class="article-row">
                            <td>@article.IdArticle</td>
                            <td>@article.Description</td>
                            <td>@article.QuantiteDotation</td>
                            <td>@article.QuantiteComplementaire</td>
                            <td>@article.TotalEmbarque</td>
                            <td>@article.QuantiteCasse</td>
                            <td>@article.QuantiteOffert</td>
                            <td>@article.RetourConsig</td>
                            <td>@article.Deficite</td>
                            <td>@article.Restant</td>
                        </tr>
                    }
                    <tr class="category-summary-row" data-categorie-id="@categorie.CategorieId">
                        <td>Total</td>
                        <td>@categorie.CategorieDescription</td>
                        <td>@group.Sum(a => a.QuantiteDotation)</td>
                        <td>@group.Sum(a => a.QuantiteComplementaire)</td>
                        <td>@group.Sum(a => a.TotalEmbarque)</td>
                        <td>@group.Sum(a => a.QuantiteCasse)</td>
                        <td>@group.Sum(a => a.QuantiteOffert)</td>
                        <td>@group.Sum(a => a.RetourConsig)</td>
                        <td>@group.Sum(a => a.Deficite)</td>
                        <td>@group.Sum(a => a.Restant)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .offers-form-modal {
        font-family: 'Segoe UI', Arial, sans-serif;
        font-size: 13px;
        padding: 20px;
        background-color: #f9f9f9;
        color: #333;
    }

    .header-section {
        margin-bottom: 20px;
        position: relative;
    }

    .company-title {
        color: #600000;
        font-weight: bold;
        margin-bottom: 5px;
        font-size: 22px;
    }

    .location-info {
        color: #555;
        margin-bottom: 15px;
        font-style: italic;
    }

    .form-title {
        text-align: center;
        color: #600000;
        font-weight: bold;
        margin: 20px 0;
        padding-bottom: 10px;
        border-bottom: 2px solid #600000;
    }

    .form-group {
        margin: 8px 0;
    }

    .modern-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
        background-color: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

        .modern-table th {
            background-color: #600000;
            color: white;
            padding: 8px;
            text-align: center;
            font-size: 13px;
            font-weight: 500;
        }

        .modern-table td {
            border: 1px solid #eee;
            padding: 6px;
            text-align: center;
            font-size: 13px;
        }

    .category-row {
        background-color: #f5f5f5;
        font-weight: bold;
    }

    .category-summary-row {
        background-color: #eee;
        font-weight: bold;
    }

        .category-row td,
        .category-summary-row td {
            text-align: left !important;
        }

    .article-row {
        background-color: #ffffff;
    }

    .category-name {
        width: 120px;
        border: 1px solid #ddd;
        padding: 5px;
        border-radius: 4px;
    }

    .table-responsive {
        margin-top: 20px;
        background-color: white;
        padding: 15px;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        overflow-x: auto;
        border-left: 3px solid #600000;
    }

    .validated {
        color: green;
        font-weight: bold;
    }

    .not-validated {
        color: red;
        font-weight: bold;
    }
</style>