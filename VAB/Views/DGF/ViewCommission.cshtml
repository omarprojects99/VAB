@model VAB.ViewModel.PncCommissionViewModel
@{
    ViewData["Title"] = "Détails Commission PNC";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-eye mr-2"></i>
                Détails Commission PNC - État N° @Model.NumeroEtat
            </h3>
            <div class="card-tools">
                <button onclick="window.print()" class="btn btn-info btn-sm">
                    <i class="fas fa-print"></i> Imprimer
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fas fa-arrow-left"></i> Fermer
                </button>
            </div>
        </div>
        <div class="card-body">
            <!-- État Information -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="info-box">
                        <span class="info-box-icon bg-info">
                            <i class="fas fa-file-alt"></i>
                        </span>
                        <div class="info-box-content">
                            <span class="info-box-text">État des Ventes</span>
                            <span class="info-box-number">@Model.NumeroEtat</span>
                            <span class="info-box-more">@Model.DateEdition.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-box">
                        <span class="info-box-icon bg-success">
                            <i class="fas fa-euro-sign"></i>
                        </span>
                        <div class="info-box-content">
                            <span class="info-box-text">Total Encaissé</span>
                            <span class="info-box-number">@Model.TotalEncaisse.ToString("C")</span>
                            <span class="info-box-more">@Model.EquipageInfo</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Commission Summary -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="small-box bg-warning">
                        <div class="inner">
                            <h3>@Model.CommissionPnc1Individual.ToString("C")</h3>
                            <p>Commission PNC1 (1%)</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-user-tie"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="small-box bg-primary">
                        <div class="inner">
                            <h3>@Model.CommissionCollective.ToString("C")</h3>
                            <p>Commission Collective (15%)</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="small-box bg-success">
                        <div class="inner">
                            <h3>@Model.CommissionParPnc.ToString("C")</h3>
                            <p>Par PNC (@Model.NombrePncsTotal PNCs)</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-divide"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PNC Commission Details -->
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">
                        <i class="fas fa-list"></i> Détail des Commissions par PNC
                    </h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead class="thead-dark">
                                <tr>
                                    <th>PNC</th>
                                    <th>Matricule</th>
                                    <th>Rôle</th>
                                    <th>Commission Individuelle (1%)</th>
                                    <th>Commission Collective</th>
                                    <th>Commission Totale</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pnc in Model.PncCommissions)
                                {
                                    <tr class="@(pnc.IsPnc1 ? "table-warning" : "")">
                                        <td>
                                            <strong>@pnc.NomComplet</strong>
                                            @if (pnc.IsPnc1)
                                            {
                                                <span class="badge badge-warning ml-2">PNC1</span>
                                            }
                                        </td>
                                        <td>@pnc.Matricule</td>
                                        <td>
                                            @if (pnc.IsPnc1)
                                            {
                                                <span class="text-warning">
                                                    <i class="fas fa-star"></i> Chef d'Équipe
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-info">
                                                    <i class="fas fa-user"></i> Membre d'Équipe
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="@(pnc.IsPnc1 ? "text-success font-weight-bold" : "text-muted")">
                                                @pnc.CommissionIndividuelle.ToString("C")
                                            </span>
                                        </td>
                                        <td>@pnc.CommissionCollective.ToString("C")</td>
                                        <td>
                                            <strong class="text-primary">
                                                @pnc.CommissionTotale.ToString("C")
                                            </strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="thead-light">
                                <tr>
                                    <th colspan="3">TOTAL</th>
                                    <th>@Model.CommissionPnc1Individual.ToString("C")</th>
                                    <th>@Model.CommissionCollective.ToString("C")</th>
                                    <th>
                                        <strong class="text-success">
                                            @((Model.CommissionPnc1Individual + Model.CommissionCollective).ToString("C"))
                                        </strong>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Commission Rules -->
            <div class="alert alert-info mt-4">
                <h5><i class="fas fa-info-circle"></i> Règles de Calcul des Commissions</h5>
                <ul class="mb-0">
                    <li><strong>PNC1 (Chef d'Équipe):</strong> Reçoit 1% du total encaissé en commission individuelle + sa part égale de la commission collective (15%)</li>
                    <li><strong>Commission Collective:</strong> 15% du total encaissé, répartie équitablement entre tous les PNCs de l'équipage</li>
                    <li><strong>Autres PNCs:</strong> Reçoivent uniquement leur part de la commission collective (15%)</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Print styles
        window.addEventListener('beforeprint', function() {
            document.querySelector('.card-tools').style.display = 'none';
        });

        window.addEventListener('afterprint', function() {
            document.querySelector('.card-tools').style.display = 'block';
        });
    </script>
}

<style>
    @@media print {
        .card-tools

    {
        display: none !important;
    }

    .btn {
        display: none !important;
    }

    }
</style>