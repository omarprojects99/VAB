@model IEnumerable<VAB.ViewModel.MotifViewModel>
@{
    ViewData["Title"] = "Motifs Reçus";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="content-header">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="material-icons">inbox</i>
                Motifs Reçus
            </li>
        </ol>
    </nav>
</div>

<div class="main-content">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="material-icons mr-2">inbox</i>
                        Motifs du Responsable Catering
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="agentMotifsTable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>N° État Vente</th>
                                    <th>Description</th>
                                    <th>Date Création</th>
                                    <th>Créé par</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Data will be loaded via AJAX -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Motif Details -->
<div class="modal fade" id="motifDetailsModal" tabindex="-1" aria-labelledby="motifDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="motifDetailsModalContent">
            <!-- Content will be loaded here -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable
            $('#agentMotifsTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetMotifs", "Motif")',
                    type: 'GET',
                    dataSrc: ''
                },
                columns: [
                    { data: 'numeroEtatVenteArrivee' },
                    { data: 'description' },
                    { data: 'dateCreation' },
                    { data: 'createdBy' },
                    {
                        data: 'status',
                        render: function(data, type, row) {
                            var badgeClass = data === 0 ? 'badge-warning' :
                                           data === 1 ? 'badge-info' : 'badge-success';
                            return '<span class="badge ' + badgeClass + '">' + row.statusText + '</span>';
                        }
                    },
                    {
                        data: null,
                        render: function(data, type, row) {
                            var buttons = '<button class="btn btn-sm btn-info mr-1" onclick="viewMotifDetails(' + row.id + ')">' +
                                         '<i class="material-icons">visibility</i></button>';

                            if (row.status === 0) { // Non Lu
                                buttons += '<button class="btn btn-sm btn-success" onclick="markAsRead(' + row.id + ')">' +
                                          '<i class="material-icons">done</i></button>';
                            }

                            return buttons;
                        }
                    }
                ],
                responsive: true,
                pageLength: 10,
                order: [[2, 'desc']], // Order by date creation desc
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.10.24/i18n/French.json'
                }
            });
        });

        function viewMotifDetails(id) {
            $.get('@Url.Action("Details", "Motif")/' + id, function(data) {
                $('#motifDetailsModalContent').html(data);
                $('#motifDetailsModal').modal('show');
            });
        }

        function markAsRead(id) {
            $.ajax({
                url: '@Url.Action("MarkAsRead", "Motif")',
                type: 'POST',
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        $('#agentMotifsTable').DataTable().ajax.reload();
                        toastr.success(response.message);
                    } else {
                        toastr.error(response.message);
                    }
                },
                error: function() {
                    toastr.error('Erreur lors de la mise à jour.');
                }
            });
        }
    </script>
}
