@model IEnumerable<VAB.ViewModel.MotifViewModel>
@{
    ViewData["Title"] = "Gestion des Motifs";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="content-header">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <i class="material-icons">message</i>
                Gestion des Motifs
            </li>
        </ol>
    </nav>
</div>

<div class="main-content">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="material-icons mr-2">list</i>
                        Liste des Motifs
                    </h5>
                    <button style="background-color:darkgray;border-color:darkgray;" type="button" class="btn btn-primary" onclick="openCreateMotifModal()">
                        <i class="material-icons mr-1">add</i>
                        Créer un Motif
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="motifsTable" class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>N° État Vente</th>
                                    <th>Description</th>
                                    <th>Date Création</th>
                                    <th>Créé par</th>
                                    <th>Statut</th>
                                    <th>Date Lecture</th>
                                    <th>Lu par</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Data will be loaded via AJAX -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Create Motif -->
<div class="modal fade" id="createMotifModal" tabindex="-1" aria-labelledby="createMotifModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="createMotifModalContent">
            <!-- Content will be loaded here -->
        </div>
    </div>
</div>

<!-- Modal for Motif Details -->
<div class="modal fade" id="motifDetailsModal" tabindex="-1" aria-labelledby="motifDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" id="motifDetailsModalContent">
            <!-- Content will be loaded here -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable
            $('#motifsTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetMotifs", "Motif")',
                    type: 'GET',
                    dataSrc: ''
                },
                columns: [
                    { data: 'numeroEtatVenteArrivee' },
                    { data: 'description' },
                    { data: 'dateCreation' },
                    { data: 'createdBy' },
                    {
                        data: 'status',
                        render: function(data, type, row) {
                            var badgeClass = data === 0 ? 'badge-warning' :
                                           data === 1 ? 'badge-info' : 'badge-success';
                            return '<span class="badge ' + badgeClass + '">' + row.statusText + '</span>';
                        }
                    },
                    { data: 'dateLecture' },
                    { data: 'readBy' },
                    {
                        data: null,
                        render: function(data, type, row) {
                            var buttons = '<button class="btn btn-sm btn-info mr-1" onclick="viewMotifDetails(' + row.id + ')" title="Voir détails">' +
                                         '<i class="material-icons">visibility</i></button>';

                            buttons += '<button class="btn btn-sm btn-danger" onclick="deleteMotif(' + row.id + ')" title="Supprimer">' +
                                      '<i class="material-icons">delete</i></button>';

                            return buttons;
                        }
                    }
                ],
                responsive: true,
                pageLength: 10,
                order: [[2, 'desc']], // Order by date creation desc
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.10.24/i18n/French.json'
                }
            });
        });

        function openCreateMotifModal() {
            $.get('@Url.Action("Create", "Motif")', function(data) {
                $('#createMotifModalContent').html(data);
                $('#createMotifModal').modal('show');
            });
        }

        function viewMotifDetails(id) {
            $.get('@Url.Action("Details", "Motif")/' + id, function(data) {
                $('#motifDetailsModalContent').html(data);
                $('#motifDetailsModal').modal('show');
            });
        }

        function deleteMotif(id) {
            if (confirm('Êtes-vous sûr de vouloir supprimer ce motif ?')) {
                $.ajax({
                    url: '@Url.Action("Delete", "Motif")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            $('#motifsTable').DataTable().ajax.reload();
                            if (typeof toastr !== 'undefined') {
                                toastr.success(response.message);
                            } else {
                                alert(response.message);
                            }
                        } else {
                            if (typeof toastr !== 'undefined') {
                                toastr.error(response.message);
                            } else {
                                alert(response.message);
                            }
                        }
                    },
                    error: function() {
                        if (typeof toastr !== 'undefined') {
                            toastr.error('Erreur lors de la suppression.');
                        } else {
                            alert('Erreur lors de la suppression.');
                        }
                    }
                });
            }
        }

        // Handle form submission
        $(document).on('submit', '#createMotifForm', function(e) {
            e.preventDefault();

            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: $(this).serialize(),
                success: function(response) {
                    if (response.success) {
                        $('#createMotifModal').modal('hide');
                        $('#motifsTable').DataTable().ajax.reload();
                        if (typeof toastr !== 'undefined') {
                            toastr.success(response.message);
                        } else {
                            alert(response.message);
                        }
                    } else {
                        $('#createMotifModalContent').html(response);
                    }
                },
                error: function() {
                    if (typeof toastr !== 'undefined') {
                        toastr.error('Erreur lors de la création du motif.');
                    } else {
                        alert('Erreur lors de la création du motif.');
                    }
                }
            });
        });
    </script>
}
