@model VAB.ViewModel.CreateMotifViewModel

<div class="modal-header">
    <h5 class="modal-title">
        <i class="material-icons mr-2">add</i>
        Créer un Nouveau Motif
    </h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>

<form id="createMotifForm" asp-action="Create" asp-controller="Motif" method="post">
    <div class="modal-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div class="form-group">
            <label asp-for="NumeroEtatVenteArrivee" class="form-label">
                <i class="material-icons mr-1">receipt</i>
                @Html.DisplayNameFor(m => m.NumeroEtatVenteArrivee)
            </label>
            <input asp-for="NumeroEtatVenteArrivee" class="form-control" placeholder="Ex: 12345" />
            <span asp-validation-for="NumeroEtatVenteArrivee" class="text-danger"></span>
            <small class="form-text text-muted">
                Saisissez le numéro de l'état de vente arrivée concerné
            </small>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label">
                <i class="material-icons mr-1">description</i>
                @Html.DisplayNameFor(m => m.Description)
            </label>
            <textarea asp-for="Description" class="form-control" rows="4"
                      placeholder="Décrivez le motif ou la remarque concernant cet état de vente..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
            <small class="form-text text-muted">
                Maximum 500 caractères
            </small>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">
            <i class="material-icons mr-1">cancel</i>
            Annuler
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="material-icons mr-1">save</i>
            Créer le Motif
        </button>
    </div>
</form>

<script>
    $(document).ready(function() {
        // Character counter for description
        $('#Description').on('input', function() {
            var maxLength = 500;
            var currentLength = $(this).val().length;
            var remaining = maxLength - currentLength;

            if (!$('#charCounter').length) {
                $(this).after('<small id="charCounter" class="form-text text-muted"></small>');
            }

            $('#charCounter').text(remaining + ' caractères restants');

            if (remaining < 0) {
                $('#charCounter').removeClass('text-muted').addClass('text-danger');
            } else {
                $('#charCounter').removeClass('text-danger').addClass('text-muted');
            }
        });
    });
</script>
