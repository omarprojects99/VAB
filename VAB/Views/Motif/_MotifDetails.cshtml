@model VAB.ViewModel.MotifViewModel

<div class="modal-header">
    <h5 class="modal-title">
        <i class="material-icons mr-2">visibility</i>
        Détails du Motif
    </h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>

<div class="modal-body">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="font-weight-bold">
                    <i class="material-icons mr-1">receipt</i>
                    Numéro État de Vente:
                </label>
                <p class="form-control-plaintext">@Model.NumeroEtatVenteArrivee</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="font-weight-bold">
                    <i class="material-icons mr-1">info</i>
                    Statut:
                </label>
                <p class="form-control-plaintext">
                    <span class="badge @Model.StatusClass">@Model.StatusText</span>
                </p>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label class="font-weight-bold">
            <i class="material-icons mr-1">description</i>
            Description du Motif:
        </label>
        <div class="card">
            <div class="card-body">
                @Model.Description
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="font-weight-bold">
                    <i class="material-icons mr-1">person</i>
                    Créé par:
                </label>
                <p class="form-control-plaintext">@Model.CreatedBy</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="font-weight-bold">
                    <i class="material-icons mr-1">schedule</i>
                    Date de Création:
                </label>
                <p class="form-control-plaintext">@Model.DateCreation.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>
    </div>

    @if (Model.Status != VAB.Models.MotifStatus.NonLu)
    {
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label class="font-weight-bold">
                        <i class="material-icons mr-1">person_outline</i>
                        Lu par:
                    </label>
                    <p class="form-control-plaintext">@(Model.ReadBy ?? "N/A")</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label class="font-weight-bold">
                        <i class="material-icons mr-1">schedule</i>
                        Date de Lecture:
                    </label>
                    <p class="form-control-plaintext">
                        @(Model.DateLecture?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                    </p>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-dismiss="modal">
        <i class="material-icons mr-1">close</i>
        Fermer
    </button>
</div>
