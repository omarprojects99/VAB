@* @model List<TextExtraction.TextSection> *@

@* @{ *@
@*     ViewData["Title"] = "Extracted Text"; *@
@* } *@

@* <h2>Extracted Text Sections</h2> *@

@* @if (Model == null || !Model.Any()) *@
@* { *@
@*     <p>No text was extracted from the PDF.</p> *@
@* } *@
@* else *@
@* { *@
@*     foreach (var textSection in Model) *@
@*     { *@
@*         <div class="card mb-3"> *@
@*             <div class="card-header"> *@
@*                 <strong>@textSection.Title</strong> (Page @textSection.Number, Type: @textSection.Type) *@
@*             </div> *@
@*             <div class="card-body"> *@
@*                 <pre>@textSection.Content</pre> *@
@*             </div> *@
@*         </div> *@
@*     } *@
@* } *@
