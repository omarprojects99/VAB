@{
    ViewData["Title"] = "Upload PDF or Image";
}

<h2>Upload PDF or Image File</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-controller="Pdf" asp-action="ExtractTable" method="post" enctype="multipart/form-data">
    <div class="form-group mb-3">
        <input type="file" name="uploadedFile" accept=".pdf,image/*" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Extract Table</button>
</form>
