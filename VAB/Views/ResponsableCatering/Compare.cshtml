            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }
            <div class="carousel">
                <div class="carousel-track">
                    <!-- Card 1: Sales Comparison -->
                    <article class="deconstructed-card">
                        <div class="card-layer card-image">
