@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Tableau de bord - Responsable Catering";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catering Dashboard</title>
    <link rel="shortcut icon" href="~/images/icons/favicon.png" type="image/png">
    <link href="https://fonts.googleapis.com/css?family=Nunito&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/iconfont/material-icons.css">
    <link href="~/css/dataTables.bootstrap4.min.css" rel="stylesheet" media="screen">
    <link href="~/css/Chart.min.css" rel="stylesheet" media="screen">
    <link href="~/css/animate.css" rel="stylesheet" media="screen">
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/sidebar.css">
    <link rel="stylesheet" href="~/css/responsive.css">
    <style>
        input:focus {
            border-color: grey !important;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
            transition: all 0.3s ease-in-out;
        }

        button:hover {
            background-color: rgb(86, 85, 85) !important;
            transform: scale(1.03);
            transition: all 0.2s ease-in-out;
        }

        button {
            background-color: rgb(180, 178, 178) !important;
            transform: scale(1);
            transition: all 0.2s ease-in-out;
        }

        .table th, .table td {
            vertical-align: middle;
        }

        .alert {
            border-radius: 10px;
        }

        #compareResult table {
            font-size: 14px;
        }

        #compareResult .text-success {
            color: #28a745 !important;
        }

        #compareResult .text-danger {
            color: #dc3545 !important;
        }

        #exportBtn, #saveComparisonBtn {
            display: none;
        }

        .dropdown-menu {
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .dropdown-item:hover {
            background-color: #66171f;
            color: white;
        }

        @@media print {
            header, #left-sidebar-area, #salesCompareForm, #exportBtn, #saveComparisonBtn, .content-header, .alert-success

        {
            display: none !important;
        }

        #wrapper {
            margin: 0;
            padding: 0;
        }

        #compareResult {
            width: 100%;
            position: absolute;
            top: 0;
            left: 0;
        }

        body {
            margin: 0;
            padding: 20px;
        }

        }
    </style>
</head>
<body>
   

    <!-- Header -->
    <header>
        <div class="header">
            <div class="navigation">
                <nav class="navbar navbar-expand-lg navbar-bg">
                    <div class="brand-logo">
                        <a class="navbar-brand" asp-controller="AgentSaisie" asp-action="AgentDashboard" id="menu-action">
                            <div class="logo-tunisair">
                                <img src="~/images/icons/Tunisair-Logo-Vector.svg-.png" alt="">
                            </div>
                        </a>
                        <div id="nav-toggle">
                            <div class="cta">
                                <div class="toggle-btn type1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="for-mobile d-mobile">
                        <div class="toggle-button" id="toggle-button">
                            <span class="material-icons">menu</span>
                        </div>
                    </div>
                    <div class="collapse navbar-collapse pr-3">
                        <ul class="navbar-nav user-info ml-auto mt-2 mt-lg-0">
                            <li class="nav-item dropdown show">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <a href="#" class="navbar-nav-link dropdown-toggle text-light" data-toggle="dropdown" aria-expanded="true">
                                        <div class="user-photo">
                                            <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" style="border-radius: 50%;" alt="">
                                        </div>
                                        @User.Identity.Name
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a asp-controller="AgentSaisie" asp-action="AgentAccountSettings" class="dropdown-item">
                                            <i class="material-icons">supervisor_account</i> Account Settings
                                        </a>
                                        <div class="menu-dropdown-divider"></div>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                            <i class="material-icons">exit_to_app</i> Logout
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a>
                                }
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
            <div class="toggle-user-menu" id="toggle-user-menu">
                <ul>
                    <li><a href="#"><div class="user-photo"><img src="https://dw3i9sxi97owk.cloudfront.net/uploads/thumbs/db9c4e1327eb8fe5e9395a4b04e1ea4a_70x70.jpg" alt=""></div>@User.Identity.Name</a></li>
                    <li>
                        <a asp-controller="AgentSaisie" asp-action="AccountSettings">
                            <i class="material-icons mr-2">supervisor_account</i> Account Settings
                        </a>
                    </li>
                    <li><a asp-controller="Account" asp-action="Logout"><i class="material-icons mr-2">exit_to_app</i>Logout</a></li>
                </ul>
            </div>
        </div>
    </header>
    <!-- Left Sidebar -->
    <section id="left-sidebar-area">
        <div id="left-sidebar-section">
            <aside>
                <div class="left-sidebar">
                    <ul class="nav flex-column">
                        <li>
                            <a class="nav-link active" asp-controller="ResponsableCatering" asp-action="CateringDashboard">
                                <i class="material-icons">dashboard</i>Tableau de Bord
                            </a>
                        </li>
                        <li>
                            <a data-toggle="collapse" class="dropdown-item-list" href="#etatDesVentesDropdown">
                                <i class="material-icons">receipt</i>Gérer États des Ventes
                                <span class="collapsed float-right"><i class="material-icons">add</i></span>
                                <span class="expanded float-right"><i class="material-icons">remove</i></span>
                            </a>
                            <div id="etatDesVentesDropdown" class="panel-collapse collapse">
                                <div class="sub-dropdown">
                                    <ul class="sub-list">
                                        <li>
                                            <a asp-controller="ResponsableCatering" asp-action="EtatDesVentesDepart">État des Ventes Départ</a>
                                        </li>
                                        <li>
                                            <a asp-controller="ResponsableCatering" asp-action="EtatDesVentesArrivee">État des Ventes Arrivée</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                        <li>
                            <a data-toggle="collapse" class="dropdown-item-list" href="#etatDesOffresDropdown">
                                <i class="material-icons">receipt</i>Gérer États des Offres
                                <span class="collapsed float-right"><i class="material-icons">add</i></span>
                                <span class="expanded float-right"><i class="material-icons">remove</i></span>
                            </a>
                            <div id="etatDesOffresDropdown" class="panel-collapse collapse">
                                <div class="sub-dropdown">
                                    <ul class="sub-list">
                                        <li>
                                            <a asp-controller="ResponsableCatering" asp-action="EtatDesOffresDepart">État des Offres Départ</a>
                                        </li>
                                        <li>
                                            <a asp-controller="ResponsableCatering" asp-action="EtatDesOffresArrivee">État des Offres Arrivée</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                        <li>
                            <a asp-controller="ResponsableCatering" asp-action="Compare">
                                <i class="bi bi-clipboard-check-fill"></i>Confrontation
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ResponsableCatering" asp-action="ListComparisons">
                                <i class="material-icons">list</i> Saved Sales Comparisons
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ResponsableCatering" asp-action="ListOffersComparisons">
                                <i class="material-icons">list</i> Saved Offers Comparisons
                            </a>
                        </li>
                    </ul>
                </div>
            </aside>

        </div>
    </section>
    <section class="d-flex" id="wrapper">
        <div class="page-content-wrapper">
            <div class="content-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item active" aria-current="page"><i class="material-icons">receipt</i>Confrontation des États des Ventes</li>
                    </ol>
                </nav>
            </div>
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }
            <div class="container py-5">
                <div class="card p-0" style="box-shadow: 0 4px 20px rgba(0,0,0,0.08); border: 1px solid #e0e0e0;">
                    <div style="background-color:rgb(115, 0, 0)" class="card-header text-white p-3">
                        <h4 class="mb-0">📊 Sales Report Comparison</h4>
                    </div>
                    <div class="card-body p-4">
                        <form id="salesCompareForm">
                            <div class="row justify-content-center">
                                <div class="col-md-8">
                                    <div class="form-group mb-4">
                                        <label for="reportNumber" class="form-label fw-medium text-secondary mb-2">Enter Report Number</label>
                                        <input type="text"
                                               class="form-control form-control-lg border border-2 border-dark"
                                               id="reportNumber"
                                               placeholder="e.g. SR-2023-001"
                                               style="padding: 12px 16px; border-color: #333 !important;">
                                    </div>
                                    <div class="text-center mt-3">
                                        <button type="submit"
                                                class="btn btn-dark btn-lg px-5 py-3 text-uppercase fw-medium"
                                                style="letter-spacing: 1px;">
                                            <i class="material-icons mr-2">compare</i> Comparer
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>

                        <div class="export-button mt-4 text-center">
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-outline-dark btn-lg px-4 py-2 dropdown-toggle"
                                        type="button"
                                        id="exportBtn"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        style="display: none;">
                                    Export Options
                                </button>
                                <ul class="dropdown-menu border-dark" aria-labelledby="exportBtn">
                                    <li><a class="dropdown-item" href="#" id="exportPdf">PDF Export</a></li>
                                    <li><a class="dropdown-item" href="#" id="printResult">Print Report</a></li>
                                </ul>
                            </div>
                            <button class="btn btn-outline-dark btn-lg px-4 py-2 ml-2"
                                    type="button"
                                    id="saveComparisonBtn"
                                    style="display: none;">
                                Save Comparison
                            </button>
                        </div>

                        <div id="compareResult" class="mt-5">
                            <div id="comparisonTable" class="table-responsive"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="modal fade" id="salesModal" tabindex="-1" aria-labelledby="salesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" id="modalContent"></div>
        </div>
    </div>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.dataTables.min.js"></script>
    <script src="~/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/js/Chart.min.js"></script>
    <script src="~/js/Chart.bundle.min.js"></script>
    <script src="~/js/chartfunction.js"></script>
    <script src="~/js/wow.min.js"></script>
    <script src="~/js/script.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        $(function () {
            let currentNumero = '';
            let currentData = null;

            $('#salesCompareForm').on('submit', function (e) {
                e.preventDefault();
                const numero = $('#reportNumber').val().trim();
                const resultBox = $('#comparisonTable');
                const exportBtn = $('#exportBtn');
                const saveComparisonBtn = $('#saveComparisonBtn');

                console.log('Submitting report number:', numero);

                if (!numero) {
                    resultBox.html('<div class="alert alert-danger fw-semibold">Please enter a report number.</div>');
                    exportBtn.hide();
                    saveComparisonBtn.hide();
                    console.log('No report number entered');
                    return;
                }

                $.ajax({
                    url: '/ResponsableCatering/CompareSalesReports',
                    type: 'POST',
                    data: { numero: numero, saveComparison: false },
                    success: function (data) {
                        console.log('AJAX response:', data);
                        if (!data.success) {
                            resultBox.html(`<div class="alert alert-danger fw-semibold">${data.message}</div>`);
                            exportBtn.hide();
                            saveComparisonBtn.hide();
                            console.log('Server error:', data.message);
                            return;
                        }

                        currentNumero = numero;
                        currentData = data;

                        let html = '<h5 class="fw-bold mb-3">Comparison Results (Numero: ' + numero + ')</h5>';

                        // Articles Comparison
                        html += '<h6 class="fw-semibold text-secondary">Articles Sold</h6>';
                        if (data.articles.length === 0) {
                            html += '<div class="alert alert-info">No articles found for comparison.</div>';
                        } else {
                            html += '<div class="table-responsive"><table class="table table-striped table-bordered">';
                            html += '<thead><tr><th>Article (ID)</th><th>Qty Sold (Arrivée)</th><th>Qty Sold (Départ)</th><th>Price (Arrivée)</th><th>Price (Départ)</th><th>Value (Arrivée)</th><th>Value (Départ)</th></tr></thead><tbody>';
                            data.articles.forEach(a => {
                                const qtyMatch = a.quantiteVenduMatch ? 'text-success' : 'text-danger';
                                const priceMatch = a.prixUnitaireMatch ? 'text-success' : 'text-danger';
                                const valueMatch = a.valeurMatch ? 'text-success' : 'text-danger';
                                html += `<tr>
                                    <td>${a.description} (${a.idArticle})</td>
                                    <td class="${qtyMatch}">${a.quantiteVenduArrivee}</td>
                                    <td class="${qtyMatch}">${a.quantiteVenduDepart}</td>
                                    <td class="${priceMatch}">${a.prixUnitaireArrivee.toFixed(2)}</td>
                                    <td class="${priceMatch}">${a.prixUnitaireDepart.toFixed(2)}</td>
                                    <td class="${valueMatch}">${a.valeurArrivee.toFixed(2)}</td>
                                    <td class="${valueMatch}">${a.valeurDepart.toFixed(2)}</td>
                                </tr>`;
                            });
                            html += '</tbody></table></div>';
                        }

                        // Totals Comparison
                        html += '<h6 class="fw-semibold text-secondary mt-4">Totals</h6>';
                        html += '<div class="table-responsive"><table class="table table-bordered">';
                        html += '<thead><tr><th>Metric</th><th>Arrivée</th><th>Départ</th><th>Match</th></tr></thead><tbody>';
                        html += `<tr><td>Total Encaissé</td><td>${data.totals.totalEncaisseArrivee?.toFixed(2) || 'N/A'}</td><td>${data.totals.totalEncaisseDepart?.toFixed(2) || 'N/A'}</td><td class="${data.totals.totalEncaisseMatch ? 'text-success' : 'text-danger'}">${data.totals.totalEncaisseMatch ? '✓' : '✗'}</td></tr>`;
                        html += `<tr><td>Écart Plus</td><td>${data.totals.ecartPlusArrivee?.toFixed(2) || 'N/A'}</td><td>${data.totals.ecartPlusDepart?.toFixed(2) || 'N/A'}</td><td class="${data.totals.ecartPlusMatch ? 'text-success' : 'text-danger'}">${data.totals.ecartPlusMatch ? '✓' : '✗'}</td></tr>`;
                        html += `<tr><td>Écart Moins</td><td>${data.totals.ecartMoinsArrivee?.toFixed(2) || 'N/A'}</td><td>${data.totals.ecartMoinsDepart?.toFixed(2) || 'N/A'}</td><td class="${data.totals.ecartMoinsMatch ? 'text-success' : 'text-danger'}">${data.totals.ecartMoinsMatch ? '✓' : '✗'}</td></tr>`;
                        html += '</tbody></table></div>';

                        resultBox.html(html);
                        exportBtn.css('display', 'inline-block');
                        saveComparisonBtn.css('display', 'inline-block');
                        console.log('Buttons visibility:', { export: exportBtn.css('display'), save: saveComparisonBtn.css('display') });

                        // PDF Export
                        $('#exportPdf').off('click').on('click', function (e) {
                            e.preventDefault();
                            console.log('Exporting PDF');
                            const { jsPDF } = window.jspdf;
                            const doc = new jsPDF('p', 'mm', 'a4');
                            const pageWidth = doc.internal.pageSize.getWidth();
                            const margin = 10;
                            let yPos = 20;

                            doc.setFontSize(16);
                            doc.setTextColor(102, 23, 31);
                            doc.text(`Sales Comparison Report (Numero: ${numero})`, pageWidth / 2, yPos, { align: 'center' });
                            yPos += 10;

                            html2canvas(document.querySelector('#comparisonTable'), {
                                scale: 2,
                                useCORS: true
                            }).then(canvas => {
                                const imgData = canvas.toDataURL('image/png');
                                const imgWidth = pageWidth - 2 * margin;
                                const imgHeight = (canvas.height * imgWidth) / canvas.width;

                                if (yPos + imgHeight > doc.internal.pageSize.getHeight() - margin) {
                                    doc.addPage();
                                    yPos = margin;
                                }

                                doc.addImage(imgData, 'PNG', margin, yPos, imgWidth, imgHeight);
                                doc.save(`SalesComparison_${numero}.pdf`);
                                console.log('PDF downloaded');
                            }).catch(err => {
                                console.error('PDF error:', err);
                                resultBox.append('<div class="alert alert-danger mt-2">Error generating PDF.</div>');
                            });
                        });

                        // Print
                        $('#printResult').off('click').on('click', function (e) {
                            e.preventDefault();
                            console.log('Printing');
                            window.print();
                        });
                    },
                    error: function (xhr, status, error) {
                        console.log('AJAX error:', status, error);
                        resultBox.html('<div class="alert alert-danger fw-semibold">Error fetching comparison data.</div>');
                        exportBtn.hide();
                        saveComparisonBtn.hide();
                    }
                });
            });

            $('#saveComparisonBtn').on('click', function (e) {
                e.preventDefault();
                if (!currentNumero || !currentData) {
                    $('#comparisonTable').html('<div class="alert alert-danger fw-semibold">No comparison data to save.</div>');
                    $('#saveComparisonBtn').hide();
                    return;
                }

                $.ajax({
                    url: '/ResponsableCatering/CompareSalesReports',
                    type: 'POST',
                    data: { numero: currentNumero, saveComparison: true },
                    success: function (data) {
                        if (data.success) {
                            $('#comparisonTable').prepend('<div class="alert alert-success fw-semibold">Comparison saved successfully!</div>');
                            $('#saveComparisonBtn').hide();
                            console.log('Comparison saved');
                        } else {
                            $('#comparisonTable').prepend(`<div class="alert alert-danger fw-semibold">${data.message}</div>`);
                            console.log('Save error:', data.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log('Save AJAX error:', status, error);
                        $('#comparisonTable').prepend('<div class="alert alert-danger fw-semibold">Error saving comparison.</div>');
                    }
                });
            });
        });
    </script>
</body>
</html>