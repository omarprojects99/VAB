@model VAB.Models.OffersComparison
@{
    ViewData["Title"] = "View Offers Comparison";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Offers Comparison</title>
    <link rel="shortcut icon" href="~/images/icons/favicon.png" type="image/png">
    <link href="https://fonts.googleapis.com/css?family=Nunito&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/iconfont/material-icons.css">
    <link href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet" media="screen">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/sidebar.css">
    <link rel="stylesheet" href="~/css/responsive.css">
    <style>
        .table th, .table td {
            vertical-align: middle;
        }

        .alert {
            border-radius: 10px;
        }

        .text-success {
            color: #28a745 !important;
        }

        .text-danger {
            color: #dc3545 !important;
        }

        @@media print {
            header, #left-sidebar-area, .content-header, .print-button

        {
            display: none !important;
        }

        #wrapper {
            margin: 0;
            padding: 0;
        }

        body {
            margin: 20px;
        }

        }
    </style>
</head>
<body>
    <!-- Loading spinner -->
    

    <!-- Header -->
    <header>
        <nav class="navbar navbar-expand-lg bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Data" asp-action="Index">
                    <img src="~/images/icons/Tunisair-Logo-Vector.svg-.png" alt="Tunisair Logo" style="height: 40px;">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="material-icons text-white">menu</span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a href="#" class="nav-link dropdown-toggle text-white" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" style="width: 30px; border-radius: 50%;" alt="User">
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="AgentSaisie" asp-action="AgentAccountSettings"><i class="material-icons">supervisor_account</i> Account Settings</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="material-icons">exit_to_app</i> Logout</a></li>
                                </ul>
                            }
                            else
                            {
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">Login</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Sidebar -->
    <section id="left-sidebar-area">
        <div id="left-sidebar-content">
            <aside>
                <div class="left-sidebar">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ResponsableCatering" asp-action="Data">
                                <i class="material-icons">dashboard</i> Tableau de données
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="collapse" href="#etatDesVentesDropdown" aria-expanded="false">
                                <i class="material-icons">receipt</i> Gérer États des Ventes
                                <span class="float-end"><i class="material-icons">add</i></span>
                            </a>
                            <div class="collapse" id="etatDesVentesDropdown">
                                <ul class="nav flex-column ms-3">
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="ResponsableCatering" asp-action="ÉtatDesVentesDépart">État des Ventes Départ</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="ResponsableCatering" asp-action="ÉtatDesVentesArrivée">État des Ventes Arrivée</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="collapse" href="#etatDesOffresDropdown" aria-expanded="false">
                                <i class="material-icons">receipt</i> Gérer États des Offres
                                <span class="float-end"><i class="material-icons">add</i></span>
                            </a>
                            <div class="collapse" id="etatDesOffresDropdown">
                                <ul class="nav flex-column ms-3">
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="ResponsableCatering" asp-action="ÉtatDesOffresDépart">État des Offres Départ</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="ResponsableCatering" asp-action="ÉtatDesOffresArrivée">État des Offres Arrivée</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ResponsableCatering" asp-action="CompareOffersReports">
                                <i class="material-icons">compare</i> Confrontation Offres
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ResponsableCatering" asp-action="CompareSalesReports">
                                <i class="material-icons">compare</i> Confrontation Ventes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ResponsableCatering" asp-action="ListComparisons">
                                <i class="material-icons">list</i> Saved Sales Comparisons
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="ResponsableCatering" asp-action="ListOffersComparisons">
                                <i class="material-icons">list</i> Saved Offers Comparisons
                            </a>
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </section>

    <section class="d-flex" id="wrapper">
        <div class="page-content-wrapper">
            <div class="content-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="ListOffersComparisons" asp-controller="ResponsableCatering">Saved Offers Comparisons</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><i class="material-icons">receipt</i> View Offers Comparison</li>
                    </ol>
                </nav>
            </div>
            <div class="container py-5">
                <div class="card p-0 shadow-sm border">
                    <div class="card-header text-white p-3" style="background-color: rgb(115, 0, 0);">
                        <h4 class="mb-0">📊 Offers Comparison (Numero: @Model.Numero)</h4>
                    </div>
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Comparison Results (Date: @Model.ComparisonDate.ToString("g"))</h5>
                        <button class="btn btn-outline-dark mb-3 print-button" onclick="window.print()">Print Report</button>

                        <!-- Articles Comparison -->
                        <h6 class="fw-semibold text-secondary">Articles Offered</h6>
                        @if (Model.Articles?.Any() ?? false)
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Article (ID)</th>
                                            <th>Dotation (Arrivée)</th>
                                            <th>Dotation (Départ)</th>
                                            <th>Complémentaire (Arrivée)</th>
                                            <th>Complémentaire (Départ)</th>
                                            <th>Cassé (Arrivée)</th>
                                            <th>Cassé (Départ)</th>
                                            <th>Offert (Arrivée)</th>
                                            <th>Offert (Départ)</th>
                                            <th>Retour Consigne (Arrivée)</th>
                                            <th>Retour Consigne (Départ)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in Model.Articles)
                                        {
                                            <tr>
                                                <td>@(a.Description ?? "Unknown") (@a.IdArticle)</td>
                                                <td class="@(a.QuantiteDotationMatch ? "text-success" : "text-danger")">@a.QuantiteDotationArrivee</td>
                                                <td class="@(a.QuantiteDotationMatch ? "text-success" : "text-danger")">@a.QuantiteDotationDepart</td>
                                                <td class="@(a.QuantiteComplementaireMatch ? "text-success" : "text-danger")">@a.QuantiteComplementaireArrivee</td>
                                                <td class="@(a.QuantiteComplementaireMatch ? "text-success" : "text-danger")">@a.QuantiteComplementaireDepart</td>
                                                <td class="@(a.QuantiteCasseMatch ? "text-success" : "text-danger")">@a.QuantiteCasseArrivee</td>
                                                <td class="@(a.QuantiteCasseMatch ? "text-success" : "text-danger")">@a.QuantiteCasseDepart</td>
                                                <td class="@(a.QuantiteOffertMatch ? "text-success" : "text-danger")">@a.QuantiteOffertArrivee</td>
                                                <td class="@(a.QuantiteOffertMatch ? "text-success" : "text-danger")">@a.QuantiteOffertDepart</td>
                                                <td class="@(a.RetourConsigMatch ? "text-success" : "text-danger")">@a.RetourConsigArrivee</td>
                                                <td class="@(a.RetourConsigMatch ? "text-success" : "text-danger")">@a.RetourConsigDepart</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">No articles found for comparison.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>