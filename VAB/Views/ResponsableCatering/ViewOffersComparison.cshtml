@model VAB.Models.OffersComparison
@{
    ViewData["Title"] = "View Offers Comparison";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Title -->
    <title>Saved Offers Comparisons</title>

    <!-- Favicon Icon -->
    <link rel="shortcut icon" href="~/images/icons/favicon.png" type="image/png">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Nunito&display=swap" rel="stylesheet">

    <!-- Material Icons -->
    <link rel="stylesheet" href="~/iconfont/material-icons.css">

    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" rel="stylesheet" media="screen">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css">

    <!-- Style CSS -->
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/sidebar.css">

    <!-- Responsive CSS -->
    <link rel="stylesheet" href="~/css/responsive.css">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        .table th, .table td {
            vertical-align: middle;
        }

        .alert {
            border-radius: 10px;
        }

        .text-success {
            color: #28a745 !important;
        }

        .text-danger {
            color: #dc3545 !important;
        }

        @@media print {
            header, #left-sidebar-area, .content-header, .print-button

        {
            display: none !important;
        }

        #wrapper {
            margin: 0;
            padding: 0;
        }

        body {
            margin: 20px;
        }

        }
    </style>
</head>
<body>
    <!-- Loading spinner -->
    

    <!-- Header -->
    <!-- Header -->
    <header>
        <div class="header">
            <div class="navigation">
                <nav class="navbar navbar-expand-lg navbar-bg">
                    <div class="brand-logo">
                        <a class="navbar-brand" asp-controller="AgentSaisie" asp-action="EtatDesVentes" id="menu-action">
                            <div class="logo-tunisair">
                                <img src="~/images/icons/Tunisair-Logo-Vector.svg-.png" alt="">
                            </div>
                        </a>
                        <div id="nav-toggle">
                            <div class="cta">
                                <div class="toggle-btn type1"></div>
                            </div>
                        </div>
                    </div>
                    <!-- For Toggle Mobile Nav icon -->
                    <div class="for-mobile d-mobile">
                        <div class="toggle-button" id="toggle-button">
                            <span class="material-icons">menu</span>
                        </div>
                    </div>
                    <!-- For Toggle Mobile Nav Icon -->
                    <div class="collapse navbar-collapse pr-3" id="#">
                        <ul class="navbar-nav user-info ml-auto mt-2 mt-lg-0">
                            <li class="nav-item dropdown show">
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <a href="#" class="navbar-nav-link dropdown-toggle text-light" data-toggle="dropdown" aria-expanded="true">
                                        <div class="user-photo">
                                            <img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" style="border-radius: 50%;" alt="">
                                        </div>
                                        @User.Identity.Name
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right">
                                        <a asp-controller="AgentSaisie" asp-action="AgentAccountSettings" class="dropdown-item">
                                            <i class="material-icons">supervisor_account</i> Account Settings
                                        </a>
                                        <div class="menu-dropdown-divider"></div>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
                                            <i class="material-icons">exit_to_app</i> Logout
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <a class="nav-link text-light" asp-controller="Account" asp-action="Login">Login</a>
                                }
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
            <!-- For Toggle Mobile Nav -->
            <div class="toggle-user-menu" id="toggle-user-menu">
                <ul>
                    <li><a href="#"><div class="user-photo"><img src="https://png.pngtree.com/png-clipart/20230919/original/pngtree-user-profile-button-for-web-and-mobile-design-vector-png-image_12420282.png" alt=""></div>@User.Identity.Name</a></li>
                    <li>
                        <a asp-controller="AgentSaisie" asp-action="AgentAccountSettings">
                            <i class="material-icons mr-2">supervisor_account</i> Account Settings
                        </a>
                    </li>
                    <li><a asp-controller="Account" asp-action="Logout"><i class="material-icons mr-2">exit_to_app</i>Logout</a></li>
                </ul>
            </div>
        </div>
    </header>

    <!-- Left Sidebar -->
    <section id="left-sidebar-area">
        <div id="left-sidebar-section">
            <aside>
                <div class="left-sidebar">
                    <ul class="nav flex-column">
                        <li>
                            <a class="nav-link active" asp-controller="ResponsableCatering" asp-action="CateringDashboard">
                                <i class="material-icons">dashboard</i>Tableau de Bord
                            </a>
                        </li>
                        <li>
                            <a data-toggle="collapse" class="dropdown-item-list" href="#etatDesVentesDropdown">
                                <i class="material-icons">receipt</i>Gérer États des Ventes
                                <span class="collapsed float-right"><i class="material-icons">add</i></span>
                                <span class="expanded float-right"><i class="material-icons">remove</i></span>
                            </a>
                            <div id="etatDesVentesDropdown" class="panel-collapse collapse">
                                <div class="sub-dropdown">
                                    <ul class="sub-list">
                                        <li>
                                            <a asp-controller="ResponsableCatering" asp-action="EtatDesVentesDepart">État des Ventes Départ</a>
                                        </li>
                                        <li>
                                            <a asp-controller="ResponsableCatering" asp-action="EtatDesVentesArrivee">État des Ventes Arrivée</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                        <li>
                            <a data-toggle="collapse" class="dropdown-item-list" href="#etatDesOffresDropdown">
                                <i class="material-icons">receipt</i>Gérer États des Offres
                                <span class="collapsed float-right"><i class="material-icons">add</i></span>
                                <span class="expanded float-right"><i class="material-icons">remove</i></span>
                            </a>
                            <div id="etatDesOffresDropdown" class="panel-collapse collapse">
                                <div class="sub-dropdown">
                                    <ul class="sub-list">
                                        <li>
                                            <a asp-controller="ResponsableCatering" asp-action="EtatDesOffresDepart">État des Offres Départ</a>
                                        </li>
                                        <li>
                                            <a asp-controller="ResponsableCatering" asp-action="EtatDesOffresArrivee">État des Offres Arrivée</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                        <li>
                            <a asp-controller="ResponsableCatering" asp-action="Compare">
                                <i class="bi bi-clipboard-check-fill"></i>Confrontation
                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ResponsableCatering" asp-action="ListComparisons">
                                <i class="material-icons">list</i> Saved Sales Comparisons
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ResponsableCatering" asp-action="ListOffersComparisons">
                                <i class="material-icons">list</i> Saved Offers Comparisons
                            </a>
                        </li>
                    </ul>
                </div>
            </aside>

        </div>
    </section>

    <section class="d-flex" id="wrapper">
        <div class="page-content-wrapper">
            <div class="content-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="ListOffersComparisons" asp-controller="ResponsableCatering">Saved Offers Comparisons</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><i class="material-icons">receipt</i> View Offers Comparison</li>
                    </ol>
                </nav>
            </div>
            <div class="container py-5">
                <div class="card p-0 shadow-sm border">
                    <div class="card-header text-white p-3" style="background-color: rgb(115, 0, 0);">
                        <h4 class="mb-0">📊 Offers Comparison (Numero: @Model.Numero)</h4>
                    </div>
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Comparison Results (Date: @Model.ComparisonDate.ToString("g"))</h5>
                        <button class="btn btn-outline-dark mb-3 print-button" onclick="window.print()">Print Report</button>

                        <!-- Articles Comparison -->
                        <h6 class="fw-semibold text-secondary">Articles Offered</h6>
                        @if (Model.Articles?.Any() ?? false)
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Article (ID)</th>
                                            <th>Dotation (Arrivée)</th>
                                            <th>Dotation (Départ)</th>
                                            <th>Complémentaire (Arrivée)</th>
                                            <th>Complémentaire (Départ)</th>
                                            <th>Cassé (Arrivée)</th>
                                            <th>Cassé (Départ)</th>
                                            <th>Offert (Arrivée)</th>
                                            <th>Offert (Départ)</th>
                                            <th>Retour Consigne (Arrivée)</th>
                                            <th>Retour Consigne (Départ)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in Model.Articles)
                                        {
                                            <tr>
                                                <td>@(a.Description ?? "Unknown") (@a.IdArticle)</td>
                                                <td class="@(a.QuantiteDotationMatch ? "text-success" : "text-danger")">@a.QuantiteDotationArrivee</td>
                                                <td class="@(a.QuantiteDotationMatch ? "text-success" : "text-danger")">@a.QuantiteDotationDepart</td>
                                                <td class="@(a.QuantiteComplementaireMatch ? "text-success" : "text-danger")">@a.QuantiteComplementaireArrivee</td>
                                                <td class="@(a.QuantiteComplementaireMatch ? "text-success" : "text-danger")">@a.QuantiteComplementaireDepart</td>
                                                <td class="@(a.QuantiteCasseMatch ? "text-success" : "text-danger")">@a.QuantiteCasseArrivee</td>
                                                <td class="@(a.QuantiteCasseMatch ? "text-success" : "text-danger")">@a.QuantiteCasseDepart</td>
                                                <td class="@(a.QuantiteOffertMatch ? "text-success" : "text-danger")">@a.QuantiteOffertArrivee</td>
                                                <td class="@(a.QuantiteOffertMatch ? "text-success" : "text-danger")">@a.QuantiteOffertDepart</td>
                                                <td class="@(a.RetourConsigMatch ? "text-success" : "text-danger")">@a.RetourConsigArrivee</td>
                                                <td class="@(a.RetourConsigMatch ? "text-success" : "text-danger")">@a.RetourConsigDepart</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">No articles found for comparison.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>